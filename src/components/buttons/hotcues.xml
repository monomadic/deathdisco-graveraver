<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Button-family definitions grouped by purpose. -->
  <define class="HCUE_BUTTON" placeholders="*source">
    <button class="button_main" x="+4" width="115" height="22" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" query="on/off" align="left" textdx="10" textaction="cue_display [SOURCE] &amp; param_uppercase" coloroff="button_background3" coloron="button_background3" brcoloroff="button_background3" brcoloron="button_background3" textcolor="textoff2" textcoloron="needle"/>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE]">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="3" height="22"/>
    </visual>
  </define>
  <define class="HCUE_BUTTON_COMPACT" placeholders="*source">
    <button class="button_main" width="24" height="24" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" coloron="button_background" brcoloron="button_background"/>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE] ? constant 0.28">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="24" height="24"/>
    </visual>
    <button class="button_main" width="24" height="24" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" text="[SOURCE]" textcoloron="needle" textsize="13" coloroff="transparent" coloron="transparent" brcoloroff="transparent" brcoloron="transparent"/>
    <button class="button_main" x="+24" width="130" height="24" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" query="on/off" textaction="cue_display [SOURCE] &amp; param_uppercase" coloroff="button_background3" coloron="button_background3" brcoloroff="button_background3" brcoloron="button_background3" textcolor="textoff2" textcoloron="needle"/>
    <button class="button_main" x="+24+130" width="24" height="24" action="delete_cue [SOURCE]" query="on/off" text="X" textsize="12"/>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE]">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="3" height="24"/>
    </visual>
  </define>
  <define class="HCUE_BUTTON_EX" placeholders="*source">
    <!-- default background -->
    <button class="button_main" width="26" height="26" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" coloron="button_background" brcoloron="button_background"/>
    <!-- hotcue colored background -->
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE] ? constant 0.7">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="26" height="26"/>
    </visual>
    <button class="button_main" x="+31" width="191" height="26" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" query="on/off" coloroff="button_background3" coloron="button_background3" brcoloroff="button_background3" brcoloron="button_background3">
      <text align="left" dx="8" width="183" action="cue_display [SOURCE] &amp; param_uppercase" color="textoff2" colorselected="needle"/>
    </button>
  </define>
  <define class="HOTCUE_BUTTON_EX" placeholders="*source,width=59,height=22">
    <button class="button_main" width="[WIDTH]" height="[HEIGHT]" action="hot_cue [SOURCE]" rightclick="delete_cue [SOURCE]" coloroff="button_background" coloron="button_background" bordersize="0" textaction="cue_display [SOURCE]" textheight="18" textcoloron="needle"/>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE] ? constant 0.12">
      <tooltip/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </visual>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE]">
      <tooltip/>
      <pos x="+0" y="+[HEIGHT]-4"/>
      <size width="[WIDTH]" height="4"/>
    </visual>
  </define>
  <define class="HOTCUE_BUTTON_STACK" placeholders="*source,width=25,height=25">
    <button class="button_main" width="[WIDTH]" height="[HEIGHT]" action="hot_cue [SOURCE]" rightclick="delete_cue [SOURCE]" coloroff="button_background" coloron="button_background" bordersize="0" textaction="get_text '[SOURCE]'" textheight="22" textcoloron="needle"/>
    <!-- bg -->
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE] ? constant 0.12">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </visual>
    <!-- bottom color bar -->
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE]">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </visual>
  </define>
</defs>
