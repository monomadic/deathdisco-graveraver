<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Button-family definitions grouped by purpose. -->
  <define class="MENU_MAINDECKS" tooltip="Deck Options" placeholders="width,height">
    <size width="[WIDTH]" height="[HEIGHT]"/>
    <icon sysicon="settings" coloroff="white" colorover="white" colordown="white" colorselected="#66FFFFFF" width="18" height="18"/>
    <item text="Auto Match BPM" action="auto_match_bpm" check="auto_match_bpm" visibility="var_equal '@$skin_mode' 2 ? false : var_equal '@$skin_mode' 0 ? false : true"/>
    <item text="Auto Match KEY" action="auto_match_key" check="auto_match_key" visibility="var_equal '@$skin_mode' 2 ? false : var_equal '@$skin_mode' 0 ? false : true"/>
    <item text="Auto Sync on Play" action="auto_sync" check="auto_sync" visibility="var_equal '@$skin_mode' 2 ? false : var_equal '@$skin_mode' 0 ? false : true"/>
    <item text="Auto Pitch Lock" action="auto_pitch_lock" check="auto_pitch_lock" visibility="var_equal '@$skin_mode' 2 ? false : var_equal '@$skin_mode' 0 ? false : true"/>
    <item text="Hot Cues" action="set '@infospannelmode' 2" check="var_equal '@infospannelmode' 2" visibility="var_equal '@$skin_mode' 2 : false"/>
    <item text="Loops" action="set '@infospannelmode' 1" check="var_equal '@infospannelmode' 1" visibility="var_equal '@$skin_mode' 2 : false"/>
    <item text="Edit Grid" action="set '@infospannelmode' 0" check="var_equal '@infospannelmode' 0" visibility="var_equal '@$skin_mode' 2 : false"/>
    <item text="Timecode &amp; Line-In" action="set '@infospannelmode' 3" check="var_equal '@infospannelmode' 3" visibility="var_equal '@$skin_mode' 2 : false"/>
    <item text="Custom Buttons" action="set '@infospannelmode' 4" check="var_equal '@infospannelmode' 4" visibility="var_equal '@$skin_mode' 2 : false"/>
    <item text="Jog" action="set '@deck_mode' 0" check="var_equal '@deck_mode' 0" visibility="var_equal '@$skin_mode' 2"/>
    <item text="Pads" action="set '@deck_mode' 1" check="var_equal '@deck_mode' 1" visibility="var_equal '@$skin_mode' 2"/>
    <item text="Saved Loops" action="set '@deck_mode' 2" check="var_equal '@deck_mode' 2" visibility="var_equal '@$skin_mode' 2"/>
    <submenu text="Songpos Waveform Type" localize="true">
      <item text="Auto" localize="true" action="setting 'skinOverviewType' 'auto'" check="setting 'skinOverviewType' 'auto'"/>
      <item text="Scratch" localize="true" action="setting 'skinOverviewType' 'colors'" check="setting 'skinOverviewType' 'colors'"/>
      <item text="Shapes" localize="true" action="setting 'skinOverviewType' 'shapes'" check="setting 'skinOverviewType' 'shapes'"/>
      <separator text="Beat Marker"/>
      <item text="Off" action="set '@$Beat_Marker' 0" check="var_equal '@$Beat_Marker' 0"/>
      <item text="32 Beats" action="set '@$Beat_Marker' 1" check="var_equal '@$Beat_Marker' 1"/>
      <item text="64 Beats" action="set '@$Beat_Marker' 2" check="var_equal '@$Beat_Marker' 2"/>
      <item text="128 Beats or 32 Bars" action="set '@$Beat_Marker' 3" check="var_equal '@$Beat_Marker' 3"/>
    </submenu>
    <separator visibility="setting 'skinOverviewType' 'colors' ? true : setting 'skinOverviewType' 'auto' ? setting 'skinWaveformType' 'colors' ? true : false"/>
    <submenu text="Songpos Colors" localize="true" visibility="setting 'skinOverviewType' 'colors' ? true : setting 'skinOverviewType' 'auto' ? setting 'skinWaveformType' 'colors' ? true : false">
      <item text="Monochrome" localize="true" action="setting 'coloredWaveforms' 'monochrome'" check="setting 'coloredWaveforms' 'monochrome'"/>
      <item text="Per Deck" localize="true" action="setting 'coloredWaveforms' 'per-deck'" check="setting 'coloredWaveforms' 'per-deck'"/>
      <item text="Neutral" localize="true" action="setting 'coloredWaveforms' 'neutral'" check="setting 'coloredWaveforms' 'neutral'"/>
      <item text="Infra Red" localize="true" action="setting 'coloredWaveforms' 'infra-red'" check="setting 'coloredWaveforms' 'infra-red'"/>
      <item text="Ultra Blue" localize="true" action="setting 'coloredWaveforms' 'ultra-blue'" check="setting 'coloredWaveforms' 'ultra-blue'"/>
      <separator/>
      <item text="Wave Use Frequency" action="setting 'waveUseFrequency'" check="setting 'waveUseFrequency'"/>
    </submenu>
    <submenu text="Colors" localize="true" visibility="setting 'skinOverviewType' 'shapes' ? true : setting 'skinOverviewType' 'auto' ? setting 'skinWaveformType' 'shapes' ? true : false">
      <item text="Virtual DJ (ish)" localize="true" action="set '@$shapes_color' 0 &amp; load_skin" check="var_equal '@$shapes_color' 0"/>
      <item text="Denon DJ (ish)" localize="true" action="set '@$shapes_color' 2 &amp; load_skin" check="var_equal '@$shapes_color' 2"/>
      <item text="Pioneer DJ (ish)" localize="true" action="set '@$shapes_color' 1 &amp; load_skin" check="var_equal '@$shapes_color' 1"/>
    </submenu>
    <submenu text="Pitch Range" localize="true">
      <item text="6%" action="pitch_range 6%" check="pitch_range 6%"/>
      <item text="8%" action="pitch_range 8%" check="pitch_range 8%"/>
      <item text="10%" action="pitch_range 10%" check="pitch_range 10%"/>
      <item text="12%" action="pitch_range 12%" check="pitch_range 12%"/>
      <item text="16%" action="pitch_range 16%" check="pitch_range 16%"/>
      <item text="25%" action="pitch_range 25%" check="pitch_range 25%"/>
      <item text="33%" action="pitch_range 33%" check="pitch_range 33%"/>
      <item text="50%" action="pitch_range 50%" check="pitch_range 50%"/>
      <item text="100%" action="pitch_range 100%" check="pitch_range 100%"/>
    </submenu>
    <submenu text="Buttons Behavior" localize="true">
      <item text="Play-Pause" action="play_mode 'pioneer'" check="play_mode 'pioneer'"/>
      <item text="Play-Stutter" action="play_mode 'numark'" check="play_mode 'numark'"/>
      <separator/>
      <item text="Cue Standard" action="setting 'cueMode' 'cue'" check="setting 'cueMode' 'cue'"/>
      <item text="Cue hold-to-play" action="setting 'cueMode' 'cue-hold'" check="setting 'cueMode' 'cue-hold'"/>
      <item text="Cue Inverted (CUP)" action="setting 'cueMode' 'cup'" check="setting 'cueMode' 'cup'"/>
    </submenu>
    <submenu text="Jog Behavior" localize="true">
      <item text="Jog" action="wheel_mode 'jog'" check="wheel_mode 'jog'"/>
      <item text="Search" action="wheel_mode 'search'" check="wheel_mode 'search'"/>
      <item text="Loop Move" action="wheel_mode 'loop_move'" check="wheel_mode 'loop_move'"/>
      <item text="Loop In" action="wheel_mode 'loop_in'" check="wheel_mode 'loop_in'"/>
      <item text="Loop Out" action="wheel_mode 'loop_out'" check="wheel_mode 'loop_out'"/>
      <item text="Browser" action="wheel_mode 'browser'" check="wheel_mode 'browser'"/>
    </submenu>
    <submenu text="Hot Cues Behavior" localize="true">
      <item text="Play" action="setting 'hotCueMode' 'play'" check="setting 'hotCueMode' 'play'"/>
      <item text="Stutter" action="setting 'hotCueMode' 'stutter'" check="setting 'hotCueMode' 'stutter'"/>
      <separator/>
      <item text="Edit CUES and POIS..." action="edit_poi" check="edit_poi"/>
      <item text="Sort Cues" action="setting 'autoSortCues'" check="setting 'autoSortCues'"/>
      <item text="Read-only (Lock)" action="lock_cues" check="lock_cues"/>
      <item text="Smart cue" action="smart_cue" check="smart_cue"/>
      <item text="Quantize on Set" action="quantize_setcue" check="quantize_setcue"/>
      <separator/>
      <submenu text="Display mode">
        <item text="Cue number" action="setting 'cueDisplay' 'number'" check="setting 'cueDisplay' 'number'"/>
        <item text="Name" action="setting 'cueDisplay' 'name'" check="setting 'cueDisplay' 'name'"/>
        <item text="Time pos" action="setting 'cueDisplay' 'position'" check="setting 'cueDisplay' 'position'"/>
        <item text="Time left" action="setting 'cueDisplay' 'distance'" check="setting 'cueDisplay' 'distance'"/>
        <item text="Beats left" action="setting 'cueDisplay' 'beat'" check="setting 'cueDisplay' 'beat'"/>
      </submenu>
    </submenu>
    <item text="Show CoverArt" action="toggle '@$show_cover_title'" check="var_equal '@$show_cover_title' 1" visibility="not var_equal '@$skin_mode' 3"/>
  </define>
  <define class="DROPDOWN_MENU">
    <size width="14" height="13"/>
    <off shape="square" color="panel_background"/>
    <icon sysicon="chevrondown" height="14" width="14" color="textdarker" colorover="needle" colordown="needle"/>
  </define>
  <define class="MENU_BUTTON">
    <size width="18" height="18"/>
    <up color="tab_menu" border="tab_buttons" border_size="5" shape="circle"/>
    <over color="tab_menu_over" border="tab_buttons" border_size="5" shape="circle"/>
    <down color="deckcolor" border="tab_buttons" border_size="5" shape="circle"/>
    <selected color="deckcolor" border="tab_buttons" border_size="5" shape="circle"/>
  </define>
  <define class="MENU_BUTTON_FX">
    <size width="18" height="18"/>
    <up color="tab_menu" border="tab_buttons" border_size="5" shape="circle"/>
    <over color="tab_menu_over" border="tab_buttons" border_size="5" shape="circle"/>
    <down color="deckcolor" border="tab_buttons" border_size="5" shape="circle"/>
    <selected color="deckcolor" border="tab_buttons" border_size="5" shape="circle"/>
    <separator text="Fx Bank A" localize="true"/>
    <item text="Load" action="effect_bank_load 1" check="effect_bank_load 1"/>
    <item text="Save" action="effect_bank_save 1" check="effect_bank_save 1"/>
    <separator text="Fx Bank B" localize="true"/>
    <item text="Load" action="effect_bank_load 2" check="effect_bank_load 2"/>
    <item text="Save" action="effect_bank_save 2" check="effect_bank_save 2"/>
    <separator text="Fx Bank C" localize="true"/>
    <item text="Load" action="effect_bank_load 3" check="effect_bank_load 3"/>
    <item text="Save" action="effect_bank_save 3" check="effect_bank_save 3"/>
    <separator text="Fx Bank D" localize="true"/>
    <item text="Load" action="effect_bank_load 4" check="effect_bank_load 4"/>
    <item text="Save" action="effect_bank_save 4" check="effect_bank_save 4"/>
    <separator/>
    <item text="Pre-Fader (Fx Processing)" action="setting 'fxProcessing' Pre-fader" check="setting 'fxProcessing' Pre-fader"/>
    <item text="Post-Fader (Fx Processing)" action="setting 'fxProcessing' Post-fader" check="setting 'fxProcessing' Post-fader"/>
    <separator/>
    <item text="Reset Fx On Load" action="setting 'resetFxOnLoad'" check="setting 'resetFxOnLoad'"/>
  </define>
  <define class="FAKE_MENU">
    <size width="18" height="20"/>
    <icon sysicon="arrowdown" height="20" width="20" color="textdarker" colorover="needle" colordown="needle"/>
    <item text="Auto PFL On Select" action="setting 'pflOnSelect'" check="setting 'pflOnSelect'"/>
    <separator/>
    <item text="Fake Filter" action="fake_filter" check="fake_filter"/>
    <item text="Fake EQ" action="fake_eq" check="fake_eq"/>
    <item text="Fake Gain" action="fake_gain" check="fake_gain"/>
    <item text="Fake PFL" action="fake_pfl" check="fake_pfl"/>
    <item text="Fake Mixer" action="fake_mixer" check="fake_mixer"/>
  </define>
  <define class="TAB_BUTTON" placeholders="width,*height,action,action3,posrec=+0,heightrec=120,rgclick,textsize=13,textheight=height,textcolor=texton2,textcoloron=deckcolor,orientation,textaction,text,important=true">
    <button action="[ACTION]" rightclick="[RGCLICK]" query="on/off">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <up color="tab_buttons" border="tab_buttons" border_size="1" shape="square"/>
      <down color="tab_buttons" border="deckcolor" border_size="1" shape="square"/>
      <selected color="tab_buttons" border="deckcolor" border_size="1" shape="square"/>
      <text fontsize="[TEXTSIZE]" height="[TEXTHEIGHT]" weight="" color="[TEXTCOLOR]" colorselected="[TEXTCOLORON]" colordown="[TEXTCOLORON]" align="center" orientation="[ORIENTATION]" action="[TEXTACTION]" text="[TEXT]" localize="true" important="[IMPORTANT]"/>
      <mouserect x="+0" y="[POSREC]" height="[HEIGHTREC]"/>
    </button>
    <button action="[ACTION3]" rightclick="[ACTION3]" query="on/off" tooltip="PANEL AVAILABLE\nSelect which views are available for this panel">
      <pos x="+6" y="+[HEIGHT]-18-6" width="18" height="18"/>
      <icon sysicon="chevrondown" color="tab_menu" colorover="tab_menu_over" colordown="deckcolor" colorselected="deckcolor" width="22" height="22"/>
    </button>
  </define>
</defs>
