<defs>
  <!-- Button-family definitions grouped by purpose. -->
  <define class="PADBUTTON" placeholders="width=109,height=39,*source" condition="var_not_equal '@$color_scheme' 4">
    <visual>
      <tooltip/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <up color="button_background2" shape="square"/>
    </visual>
    <visual type="color" source="pad_button_color [SOURCE]" visibility="pad [SOURCE] ? constant 1 : constant 0.0">
      <tooltip/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </visual>
    <button action="pad [SOURCE]" rightclick="padshift [SOURCE]">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <up color="button_background2" border="button_background2" border_size="1" shape="square"/>
      <selected color="button_background2" border="transparent" border_size="1" shape="square"/>
    </button>
    <button action="pad [SOURCE]" rightclick="padshift [SOURCE]" visibility="pad_pushed [SOURCE]">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <up color="button_background2" border="button_background2" border_size="1" shape="square"/>
      <selected color="button_background2" border="needle" border_size="1" shape="square"/>
    </button>
    <button action="pad [SOURCE]" rightclick="padshift [SOURCE]">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <text dx="+10+5+4" width="[WIDTH]-20-10" size="16" weight="" color="textoff" colorselected="needle" action="pad [SOURCE]" align="center"/>
    </button>
    <visual type="color" source="pad_button_color [SOURCE]">
      <tooltip/>
      <pos x="+10" y="+10"/>
      <size width="4" height="[HEIGHT]-10-10"/>
    </visual>
    <visual novisibility="pad_button_color [SOURCE]">
      <tooltip/>
      <pos x="+10" y="+10"/>
      <size width="4" height="[HEIGHT]-10-10"/>
      <off color="panel_background" shape="square"/>
    </visual>
    <visual visibility="pad_pushed [SOURCE]">
      <tooltip/>
      <pos x="+10" y="+10"/>
      <size width="4" height="[HEIGHT]-10-10"/>
      <off color="needle" shape="square"/>
    </visual>
  </define>
