      <pos x="+3" y="+3"/>
      <size width="180-6" height="39-6"/>
    </visual>
    <!-- button base -->
    <button action="pad [SOURCE]" rightclick="padshift [SOURCE]">
      <size width="180" height="39"/>
      <off color="dark_0" border="#44FFFFFF" border_size="3" shape="square" radius="3"/>
      <over color="#CC000000" border="#99FFFFFF" border_size="3" shape="square" radius="3"/>
      <down color="dark_5" border="#99FFFFFF" border_size="3" shape="square" radius="3"/>
      <selected color="#CC000000" border="#99FFFFFF" border_size="3" shape="square" radius="3"/>
      <text dx="+24" width="180-10-10" size="15" weight="" color="white" colorover="white" colordown="white" colorselected="white" action="pad [SOURCE]" align="left" multiline="true"/>
    </button>
    <!-- color tinting -->
