<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Button-family definitions grouped by purpose. -->
  <define class="PAD_GRID_BUTTON" placeholders="*source,*width=180">
    <visual shape="square">
      <size width="[WIDTH]" height="39"/>
      <off color="dark_0" border="dark_3" border_size="3" radius="5"/>
    </visual>
    <group visibility="pad_has_action [SOURCE]">
      <visual type="color" source="pad_button_color [SOURCE]" visibility="pad_has_color [SOURCE]">
        <pos x="+3" y="+3"/>
        <size width="[WIDTH]-3-3" height="39-6"/>
      </visual>
      <button action="pad [SOURCE]" rightclick="padshift [SOURCE]" visibility="pad_has_action [SOURCE]">
        <size width="[WIDTH]" height="39"/>
        <off color="#99000000" border="#77FFFFFF" border_size="3" shape="square" radius="3"/>
        <over color="#88000000" border="#99FFFFFF" border_size="3" shape="square" radius="3"/>
        <down color="#55000000" border="#CCFFFFFF" border_size="3" shape="square" radius="5"/>
        <selected color="#99000000" border="#AAFFFFFF" border_size="3" shape="square" radius="5"/>
        <text dx="+21" width="[WIDTH]-20" size="15" weight="" color="white" colorover="white" colordown="white" colorselected="white" action="pad [SOURCE]" align="left" multiline="true"/>
      </button>
      <visual type="color" source="pad_button_color [SOURCE]" visibility="0.3">
        <tooltip/>
        <size width="[WIDTH]" height="39"/>
      </visual>
      <visual type="color" source="pad_button_color [SOURCE]" visibility="pad_pushed [SOURCE]">
        <tooltip/>
        <pos x="+11" y="+12"/>
        <size width="6" height="38-12-12"/>
        <off color="pad_button_color [SOURCE]" shape="square"/>
        <over color="red" shape="square"/>
      </visual>
      <visual type="color" source="pad_button_color [SOURCE]">
        <tooltip/>
        <pos x="+12" y="+11"/>
        <size width="4" height="39-12-12"/>
      </visual>
    </group>
  </define>
  <define class="PAD_STACK_BUTTON" placeholders="*source,*width=76,*height=30,*coloroff=button_background2,*coloron=#CC000000,*bordercolor=dark_4,*bordersize=0,*radius=0,*multiline=false,*textdx=+15,*textpad=+2,*textsize=12,*textdy=-1">
    <button action="pad [SOURCE]" rightclick="padshift [SOURCE]" visibility="not pad_pushed [SOURCE]">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <up color="[COLOROFF]" border="[BORDERCOLOR]" border_size="[BORDERSIZE]" shape="square" radius="[RADIUS]"/>
      <over color="#111111" border="#333333" border_size="0" shape="square"/>
      <selected color="[COLORON]" border="[BORDERCOLOR]" border_size="[BORDERSIZE]" shape="square" radius="[RADIUS]"/>
    </button>
    <button action="pad [SOURCE]" rightclick="padshift [SOURCE]" visibility="pad_pushed [SOURCE]">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <selected color="#CC000000" border="pad_button_color [SOURCE]" border_size="1" shape="square" radius="[RADIUS]"/>
    </button>
    <button action="pad [SOURCE]" rightclick="padshift [SOURCE]">
      <pos x="+0" y="+0"/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <over color="dark_2" border="dark_7" border_size="1" radius="5"/>
      <text dx="[TEXTDX]" dy="[TEXTDY]" width="[WIDTH][TEXTPAD]" size="[TEXTSIZE]" weight="" multiline="[MULTILINE]" color="textoff" colorselected="needle" colorover="#999999" action="pad [SOURCE]" align="left"/>
    </button>
    <visual type="color" source="pad_button_color [SOURCE]">
      <pos x="+5" y="+6"/>
      <size width="3" height="[HEIGHT]-12"/>
    </visual>
  </define>
</defs>
