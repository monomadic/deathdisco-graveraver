<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Button-family definitions grouped by purpose. -->
  <define class="STEM_BUTTON" placeholders="*stem,*label,*color,width=65,height=23,fontsize=12,granularity=23">
    <!-- TOGGLE -->
    <button x="+0" action="stem_pad '[STEM]'" border_size="1">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <off color="#000000" border="#555555" radius="3"/>
      <down color="#222222" border="[COLOR]" radius="3"/>
      <over color="transparent" border="#555555" radius="3"/>
      <selected color="transparent" border="[COLOR]" radius="3"/>
      <text fontsize="[FONTSIZE]" color="#888888" colorover="white" colorselected="[COLOR]" colordown="[COLOR]" align="center" text="[LABEL]"/>
    </button>
  </define>
  <define class="STEM_VOLUME_SLIDER" placeholders="*stem,*label,*color,width=65">
    <!-- VU METER -->
    <visual source="get_level '[STEM]'" type="linear" orientation="horizontal" direction="up" granularity="[GRANULARITY]">
      <pos y="+4"/>
      <size width="[WIDTH]" height="8"/>
      <off shape="square" border="dark_6" color="black" radius="2"/>
      <down shape="square" border="[COLOR]" color="[COLOR]" radius="2"/>
    </visual>
    <!-- GAIN SLIDER -->
    <slider action="param_multiply 50% &amp; stem '[STEM]'" dblclick="stem '[STEM]' 50%" orientation="horizontal" direction="up" frommiddle="false">
      <pos x="-1"/>
      <size width="[WIDTH]+2" height="16"/>
      <fader color="dark_7" width="8" height="14" radius="2"/>
    </slider>
    <!-- GAIN SLIDER NOTCH -->
    <slider action="param_multiply 50% &amp; stem '[STEM]'" dblclick="stem '[STEM]' 50%" orientation="horizontal" direction="up" frommiddle="false">
      <size width="[WIDTH]" height="16"/>
      <fader color="dark_9" width="6" border="dark_3" border_size="2" height="12" radius="2"/>
    </slider>
  </define>
  <define class="STEM_FX_BUTTON" placeholders="*stem" action="effect_stems '[STEM]'">
    <size width="32" height="15"/>
    <off color="transparent" border="dark_7" border_size="0" radius="3"/>
    <selected color="transparent" border="color_padfx" radius="3"/>
    <text fontsize="11" color="dark_7" colorover="white" colorselected="color_padfx" colordown="color_padfx" align="center" text="FX"/>
  </define>
  <define class="STEM_ISO_BUTTON" placeholders="*stem" action="deck all param_equal `get_deck` `get_defaultdeck` ? mute_stem [STEM] off : mute_stem [STEM] on" query="mute_stem [STEM] ? off : action_deck 1 ? deck 2 mute_stem [STEM] &amp;&amp; deck 3 mute_stem [STEM] &amp;&amp; deck 4 mute_stem [STEM] : action_deck 2 ? deck 1 mute_stem [STEM] &amp;&amp; deck 3 mute_stem [STEM] &amp;&amp; deck 4 mute_stem [STEM] : action_deck 3 ? deck 1 mute_stem [STEM] &amp;&amp; deck 2 mute_stem [STEM] &amp;&amp; deck 4 mute_stem [STEM] : deck 1 mute_stem [STEM] &amp;&amp; deck 2 mute_stem [STEM] &amp;&amp; deck 3 mute_stem [STEM]">
    <size width="32" height="15"/>
    <off color="transparent" border="black" border_size="1" radius="3"/>
    <selected color="transparent" border="black" radius="3"/>
    <text fontsize="11" color="dark_7" colorover="white" colorselected="#33FFF8" colordown="color_padfx" align="center" text="ISO"/>
  </define>
  <define class="STEM_CHANNEL" placeholders="*stem,*label,*color,width=65,height=23,fontsize=13,granularity=23">
    <!-- TOGGLE -->
    <button x="+0" action="stem_pad '[STEM]'" border_size="1">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <off color="#222222" border="#444444" radius="3"/>
      <down color="#222222" border="[COLOR]" radius="3"/>
      <selected color="transparent" border="[COLOR]" radius="3"/>
      <text fontsize="[FONTSIZE]" color="#555555" colorselected="[COLOR]" colordown="[COLOR]" align="center" text="[LABEL]"/>
    </button>
    <!-- VU METER -->
    <visual source="get_level '[STEM]'" type="linear" orientation="horizontal" direction="up" granularity="[GRANULARITY]">
      <pos x="+0" y="+[HEIGHT]+2"/>
      <size width="[WIDTH]" height="7"/>
      <off shape="square" border="#2A2A2A" color="black" radius="2"/>
      <down shape="square" border="[COLOR]" color="[COLOR]" radius="2"/>
    </visual>
    <!-- GAIN SLIDER -->
    <slider action="param_multiply 50% &amp; stem '[STEM]'" dblclick="stem '[STEM]' 50%" orientation="horizontal" direction="up" frommiddle="false">
      <pos x="+0" y="+[HEIGHT]+2"/>
      <size width="[WIDTH]" height="7"/>
      <fader color="#AAAAAA" width="2" height="5"/>
    </slider>
  </define>
</defs>
