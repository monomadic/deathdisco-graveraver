  <define class="MIXER">
    <!-- MIDDLE PANEL BORDER -->
    <visual x="+4" width="308" height="375">
      <off shape="square" color="#000000" radius="6" bordersize="1" border="#222222"/>
    </visual>
    <!-- MIDDLE PANEL: MIXER -->
    <panel name="audiomixer" group="mixer" visible="yes" class="eq_mixer_pane"/>
    <!-- MIXER PANEL: SAMPLER -->
    <panel name="samplermixer" group="mixer" visible="no" class="sampler_mixer_pane"/>
    <!-- PRO: MIXER PANEL: WAVE -->
    <panel name="scratchmixer" group="mixer" visible="no" class="wave_mixer_pane"/>
    <panel name="mastermixer" group="mixer" visible="no" class="master_mixer_pane"/>
  </define>
  <define class="LEVELS_MINI">
    <group name="2/4 (decks_swap)" visibility="var_not_equal '@$layout_4deck' 1">
      <panel class="channel_levels_mini" deck="3" x="+77+1" visibility="deck 3 leftdeck"/>
      <panel class="channel_levels_mini" deck="1" x="+77+1" visibility="not deck 3 leftdeck"/>
      <panel class="channel_levels_mini" deck="2" x="+77+1+77+2" visibility="not deck 4 rightdeck"/>
      <panel class="channel_levels_mini" deck="4" x="+77+1+77+2" visibility="deck 4 rightdeck"/>
    </group>
    <group name="4 (fulldecks)" visibility="var_equal '@$layout_4deck' 1">
      <panel class="channel_levels_mini4_left" deck="left" x="+77+1"/>
      <panel class="channel_levels_mini4_right" deck="right" x="+77+1+77+2"/>
    </group>
  </define>
  <define class="MIXER_4DECKS">
    <!-- Placeholder preserves the current 4-deck Sampler tab without loading the 2-deck sampler tree. -->
    <panel name="samplermixer" group="mixer" visible="yes">
    </panel>
    <panel name="audiomixer" group="mixer" visible="yes">
      <!-- Keep only the active mixer-order tree instantiated. -->
      <group name="3124" condition="setting 'mixerOrder' '3124'">
        <panel class="channel_extended" deck="3"/>
        <panel class="channel_extended" deck="1" x="+77+1"/>
        <panel class="channel_extended" deck="2" x="+77+1+77+2"/>
        <panel class="channel_extended" deck="4" x="+77+1+77+2+77+1"/>
      </group>
      <group name="1234" condition="setting 'mixerOrder' '1234'">
        <panel class="channel_extended" deck="1"/>
        <panel class="channel_extended" deck="2" x="+77+1"/>
        <panel class="channel_extended" deck="3" x="+77+1+77+2"/>
        <panel class="channel_extended" deck="4" x="+77+1+77+2+77+1"/>
      </group>
      <group name="1342" condition="setting 'mixerOrder' '1342'">
        <panel class="channel_extended" deck="1"/>
        <panel class="channel_extended" deck="3" x="+77+1"/>
        <panel class="channel_extended" deck="4" x="+77+1+77+2"/>
        <panel class="channel_extended" deck="2" x="+77+1+77+2+77+1"/>
      </group>
      <menu tooltip="MIXER OPTIONS">
        <pos x="960-10" y="+0"/>
        <size width="20" height="18"/>
        <off shape="square" color="xf_background" border="xf_background"/>
        <icon sysicon="chevrondown" height="20" width="20" color="textdarker" colorover="needle" colordown="needle"/>
        <item text="Frequency" localize="true" action="setting 'eqMode' 'Frequency'" check="setting 'eqMode' 'Frequency'"/>
        <item text="ModernEQ" localize="true" action="setting 'eqMode' 'modernEQ'" check="setting 'eqMode' 'modernEQ'"/>
        <item text="EZRemix" localize="true" action="setting 'eqMode' 'EZRemix'" check="setting 'eqMode' 'EZRemix'"/>
        <item text="Full Stems (5 knobs)" localize="true" action="setting 'eqMode' 'STEMS'" check="setting 'eqMode' 'STEMS'"/>
        <separator/>
        <submenu text="EQ Frequency Spread" localize="true">
          <item text="Default" action="setting 'equalizerFrequencySpread' 'default'" check="setting 'equalizerFrequencySpread' 'default'"/>
          <item text="Full Kill" action="setting 'equalizerFrequencySpread' 'full kill'" check="setting 'equalizerFrequencySpread' 'full kill'"/>
        </submenu>
        <submenu text="Vu Meter" localize="true">
          <item text="Peak Mode" action="setting 'vuMeter' 'peak'" check="setting 'vuMeter' 'peak'"/>
          <item text="Power Mode" action="setting 'vuMeter' 'power'" check="setting 'vuMeter' 'power'"/>
          <separator text="Color"/>
          <item text="Per Deck" action="set '@$hntnhvumetercolors' 0" check="var_equal '@$hntnhvumetercolors' 0"/>
          <item text="Natural" action="set '@$hntnhvumetercolors' 1" check="var_equal '@$hntnhvumetercolors' 1"/>
          <separator/>
          <item text="Show Extra Peak Meter" localize="true" action="toggle '@$show_peak_meter'" check="var_equal '@$show_peak_meter' 1"/>
        </submenu>
        <submenu text="Mixer Order" localize="true">
          <item text="1-2-3-4" action="setting 'mixerOrder' '1234'" check="setting 'mixerOrder' '1234'"/>
          <item text="3-1-2-4" action="setting 'mixerOrder' '3124'" check="setting 'mixerOrder' '3124'"/>
          <item text="1-3-4-2" action="setting 'mixerOrder' '1342'" check="setting 'mixerOrder' '1342'"/>
        </submenu>
        <submenu text="Filter Resonance" localize="true">
          <item text="Default" action="setting 'filterDefaultResonance' 'default'" check="setting 'filterDefaultResonance' 'default'"/>
          <item text="Strong" action="setting 'filterDefaultResonance' 'strong'" check="setting 'filterDefaultResonance' 'strong'"/>
          <item text="Subtle" action="setting 'filterDefaultResonance' 'subtle'" check="setting 'filterDefaultResonance' 'subtle'"/>
        </submenu>
        <submenu text="Fader Start" localize="true">
          <item text="ON" action="deck all setting 'faderStart' on" check="setting 'faderStart' on"/>
          <item text="OFF" action="deck all setting 'faderStart' off" check="setting 'faderStart' off"/>
        </submenu>
        <submenu text="Fader StartStop" localize="true">
          <item text="ON" action="deck all setting 'faderStartStop' on" check="setting 'faderStartStop' on"/>
          <item text="OFF" action="deck all setting 'faderStartStop' off" check="setting 'faderStartStop' off"/>
        </submenu>
        <separator/>
        <item text="Reset EQ On Load" localize="true" action="setting 'resetEqOnLoad'" check="setting 'resetEqOnLoad'"/>
        <item text="Use Auto Gain" localize="true" action="setting 'autoGain' 'auto' ? setting 'autoGain' 'no' : setting 'autoGain' 'auto'" check="setting 'autoGain' 'auto'"/>
        <item text="Show Drop Down Menus" localize="true" action="toggle '@$show_drop_menus'" check="var_equal '@$show_drop_menus' 0"/>
        <separator/>
        <submenu text="Crossfader" localize="true">
          <item text="Disabled" action="setting 'crossfaderDisable'" check="setting 'crossfaderDisable'"/>
          <item text="Hamster" action="setting 'crossfaderHamster'" check="setting 'crossfaderHamster'"/>
          <separator/>
          <item text="Full" action="setting 'crossfaderCurve' 'full'" check="setting 'crossfaderCurve' 'full'"/>
          <item text="Smooth" action="setting 'crossfaderCurve' 'smooth'" check="setting 'crossfaderCurve' 'smooth'"/>
          <item text="Scratch" action="setting 'crossfaderCurve' 'scratch'" check="setting 'crossfaderCurve' 'scratch'"/>
          <item text="Custom" action="setting 'crossfaderCurve' 'custom'" check="setting 'crossfaderCurve' 'custom'"/>
          <item text="Cut" action="setting 'crossfaderCurve' 'cut'" check="setting 'crossfaderCurve' 'cut'"/>
        </submenu>
      </menu>
    </panel>
    <!-- 4 deck scratch mixer -->
    <panel name="scratchmixer" group="mixer" visible="no">
      <visual class="gfx_shape" width="312" height="626" coloroff="wave_background" bordercoloroff="panel_background" bordersize="2" visibility="var_equal '@$hide_crossfader' 0"/>
      <visual class="gfx_shape" width="312" height="626" coloroff="wave_background" bordercoloroff="panel_background" bordersize="2" visibility="var_equal '@$hide_crossfader' 1"/>
      <panel class="vertical_scratchwave" deck="3" visibility="deck 3 leftdeck" x="+40" y="+0"/>
      <panel class="vertical_scratchwave" deck="1" visibility="deck 1 leftdeck" x="+40" y="+0"/>
      <panel class="vertical_scratchwave" deck="2" visibility="deck 2 rightdeck" x="+320-98-10-19-19" y="+0"/>
      <panel class="vertical_scratchwave" deck="4" visibility="deck 4 rightdeck" x="+320-98-10-19-19" y="+0"/>
      <panel class="scratch_controls" x="960-20" y="+0"/>
    </panel>
    <panel name="mastermixer" group="mixer" visible="no">
      <panel class="mic/headphones_controls"/>
      <panel class="mastercentral_controls" x="+77+1"/>
      <panel class="master_controls" x="+77+1+77+2+77+1"/>
    </panel>
    <!-- XFADER ZONE -->
    <group visibility="var_equal '@$hide_crossfader' 1 ? not skin_panel 'scratchmixer' : on">
      <visual class="gfx_shape" y="+432-56+216+2" width="312" height="56" coloroff="xf_background"/>
      <panel class="xfader_panel" x="+20" y="+432-56+6+4+216+2"/>
    </group>
  </define>
  <define class="XFADER_PANEL">
    <group y="+53">
      <panel class="xfader_deck_select" deck="3" side="leftdeck" x="+0" y="+1"/>
      <panel class="xfader_deck_select" deck="1" side="leftdeck" x="+61" y="+1"/>
