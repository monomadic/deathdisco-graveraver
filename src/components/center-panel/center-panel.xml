<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Center panel: the middle column shown on Pro layouts in mixer mode
       (MIXER / MIXER_4DECKS) plus its channel-strip building blocks. -->
  <define class="XFADER_DECK_SELECT" placeholders="deck,side,width=60,textsize=14,textcolor=#888888,offcolor=#111111,overcolor=#111111">
    <deck deck="[DECK]">
      <visual class="gfx_shape" x="+0" y="+0" width="[WIDTH]" height="29" coloroff="infos_background" bordercoloroff="#333333" bordersize="1"/>
      <button x="+0" y="+1" width="[WIDTH]" height="26" action="[SIDE]" border_size="0">
        <up color="black"/>
        <over color="black"/>
        <selected color="black"/>
        <text fontsize="[TEXTSIZE]" color="#222222" colorover="#444444" colorselected="white" align="center" weight="bold" text="[DECK]"/>
      </button>
      <visual source="get_level" type="linear" orientation="horizontal" direction="right" granularity="23">
        <pos x="+0" y="-1"/>
        <size width="[WIDTH]" height="2"/>
        <off shape="square" color="transparent"/>
        <on shape="square" color="green"/>
      </visual>
      <button x="+0" y="+27" width="[WIDTH]" height="3" action="[SIDE]" border_size="0">
        <up color="deckcolor"/>
        <over color="deckcolor"/>
        <selected color="deckcolor"/>
        <text fontsize="[TEXTSIZE]" color="#222222" colorover="#444444" colorselected="black" align="center" text=""/>
      </button>
    </deck>
  </define>
  <define class="CHANNEL_EXTENDED" placeholders="deck">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="77" height="432-56-1+216+2" coloroff="xf_background"/>
      <visual class="gfx_shape" y="+30" width="77" height="432-76-1" coloroff="panel_background" visibility="0.9"/>
      <textzone>
        <pos x="+0" y="+0"/>
        <size width="77" height="30"/>
        <text fontsize="15" weight="" color="deckcolor" align="center" action="get_level 'db'" important="true"/>
      </textzone>
      <!-- 3knobs -->
      <group novisibility="setting 'eqMode' 'STEMS'" y="+30">
        <button class="dropdown_menu" action="eq_mode" x="+58" y="+6" visibility="var_equal '@$show_drop_menus' 0"/>
        <panel class="knob" x="+18" y="+14" knobsize="41" knobradius="10" faderradius="9" action="gain" rgclick="match_gain" dblclick="gain 50%" frommiddle="true" fillcolor="knobfillon" textaction="gain_label" actiontxt="var_equal '@$show_drop_menus' 1 ? eq_mode : eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+72" knobsize="41" knobradius="10" faderradius="9" action="eq_high" rgclick="eq_high 0% ? eq_high 50% : eq_high 0%" dblclick="eq_high 50%" frommiddle="true" fillcolor="knobfillon" textaction="high_label" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+72+65" knobsize="41" knobradius="10" faderradius="9" action="eq_mid" rgclick="eq_mid 0% ? eq_mid 50% : eq_mid 0%" dblclick="eq_mid 50%" frommiddle="true" fillcolor="knobfillon" textaction="mid_label 'short'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+72+65+65" knobsize="41" knobradius="10" faderradius="9" action="eq_low" rgclick="eq_low 0% ? eq_low 50% : eq_low 0%" dblclick="eq_low 50%" frommiddle="true" fillcolor="knobfillon" textaction="low_label" actiontxt="eq_mode +1"/>
        <button class="dropdown_menu" action="effect_select colorfx" x="+58" y="+14+81+68+68+56" visibility="var_equal '@$show_drop_menus' 0"/>
      </group>
      <!-- 5knobs -->
      <group visibility="setting 'eqMode' 'STEMS'" y="+30">
        <button class="dropdown_menu" action="eq_mode" x="+58" y="+6" visibility="var_equal '@$show_drop_menus' 0"/>
        <panel class="knob" x="+18" y="+14" knobsize="41" knobradius="10" faderradius="9" action="stem 'instru'" rgclick="stem 'instru' 0% ? stem 'instru' 50% : stem 'instru' 0%" dblclick="stem 'instru' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'INSTRU'" actiontxt="var_equal '@$show_drop_menus' 1 ? eq_mode : eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+72" knobsize="41" knobradius="10" faderradius="9" action="stem 'hihat'" rgclick="stem 'hihat' 0% ? stem 'hihat' 50% : stem 'hihat' 0%" dblclick="stem 'hihat' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'HIHAT'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+72+65" knobsize="41" knobradius="10" faderradius="9" action="stem 'vocal'" rgclick="stem 'vocal' 0% ? stem 'vocal' 50% : stem 'vocal' 0%" dblclick="stem 'vocal' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'VOCAL'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+72+65+65" knobsize="41" knobradius="10" faderradius="9" action="stem 'kick'" rgclick="stem 'kick' 0% ? stem 'kick' 50% : stem 'kick' 0%" dblclick="stem 'kick' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'KICK'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+81+68+68+64" knobsize="41" knobradius="10" faderradius="9" action="stem 'bass'" rgclick="stem 'bass' 0% ? stem 'bass' 50% : stem 'bass' 0%" dblclick="stem 'bass' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'BASS'" actiontxt="eq_mode +1"/>
      </group>
      <group name="levels,vu,cue" y="+366">
        <panel class="vu_meter_leds" x="+23" y="+30" source="get_level_left" showpeaks="var_equal '@$show_peak_meter' 1"/>
        <panel class="vu_meter_leds" x="+23+11+10" y="+30" source="get_level_right" showpeaks="var_equal '@$show_peak_meter' 1"/>
        <group name="level" x="+20" y="+36">
          <slider action="level" dblclick="level 80%" orientation="vertical" direction="up" frommiddle="false">
            <pos y="-7"/>
            <size width="38" height="158"/>
            <fader color="faderbackground2" width="38" height="14" visibility="0.5"/>
          </slider>
          <slider action="level" dblclick="level 80%" orientation="vertical" direction="up" frommiddle="false">
            <pos y="-7+6"/>
            <size width="38" height="158-12"/>
            <fader color="faderbackgroundline" width="38" height="2"/>
          </slider>
        </group>
        <!-- PRO: 4 DECK AUDIO PANEL CUE BUTTON -->
        <button class="button_main" x="+2+4+4" y="+195" width="57" height="24" action="pfl" coloroff="button_background4" brcoloroff="button_background4" text="CUE" textcoloron="black"/>
      </group>
    </deck>
  </define>
