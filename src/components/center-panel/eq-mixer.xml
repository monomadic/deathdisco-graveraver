<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- EQ (audio) mixer pane and its per-channel EQ / level strips. -->
  <define class="EQ_MIXER_PANE">
    <visual x="+4" width="307" height="440">
      <off shape="square" color="dark_3" radius="6" bordersize="1" border="dark_5"/>
    </visual>
    <group x="+2" y="+8">
      <panel class="channel_eqs" deck="1" visibility="not deck 3 leftdeck"/>
      <panel class="channel_eqs" deck="3" visibility="deck 3 leftdeck"/>
    </group>
    <panel class="channel_levels" deck="1" y="+10" x="+77+1" visibility="not deck 3 leftdeck"/>
    <panel class="channel_levels" deck="3" y="+10" x="+77+1" visibility="deck 3 leftdeck"/>
    <panel class="channel_levels" deck="2" y="+10" x="+77+1+77+2" visibility="not deck 4 rightdeck"/>
    <panel class="channel_levels" deck="4" y="+10" x="+77+1+77+2" visibility="deck 4 rightdeck"/>
    <group x="-2" y="+8">
      <panel class="channel_eqs" deck="2" x="+77+1+77+2+77+1" visibility="not deck 4 rightdeck"/>
      <panel class="channel_eqs" deck="4" x="+77+1+77+2+77+1" visibility="deck 4 rightdeck"/>
    </group>
    <menu tooltip="MIXER OPTIONS">
      <pos x="960-10" y="+10"/>
      <size width="20" height="18"/>
      <off shape="square" color="xf_background" border="xf_background"/>
      <icon sysicon="settings" height="20" width="20" color="textdarker" colorover="needle" colordown="needle"/>
      <item text="Frequency" localize="true" action="setting 'eqMode' 'Frequency'" check="setting 'eqMode' 'Frequency'"/>
      <item text="ModernEQ" localize="true" action="setting 'eqMode' 'modernEQ'" check="setting 'eqMode' 'modernEQ'"/>
      <item text="EZRemix" localize="true" action="setting 'eqMode' 'EZRemix'" check="setting 'eqMode' 'EZRemix'"/>
      <item text="Full Stems (5 knobs)" localize="true" action="setting 'eqMode' 'STEMS'" check="setting 'eqMode' 'STEMS'"/>
      <separator/>
      <submenu text="EQ Frequency Spread" localize="true">
        <item text="Default" action="setting 'equalizerFrequencySpread' 'default'" check="setting 'equalizerFrequencySpread' 'default'"/>
        <item text="Full Kill" action="setting 'equalizerFrequencySpread' 'full kill'" check="setting 'equalizerFrequencySpread' 'full kill'"/>
      </submenu>
      <submenu text="Vu Meter" localize="true">
        <item text="Peak Mode" action="setting 'vuMeter' 'peak'" check="setting 'vuMeter' 'peak'"/>
        <item text="Power Mode" action="setting 'vuMeter' 'power'" check="setting 'vuMeter' 'power'"/>
        <separator text="Color"/>
        <item text="Per Deck" action="set '@$hntnhvumetercolors' 0" check="var_equal '@$hntnhvumetercolors' 0"/>
        <item text="Natural" action="set '@$hntnhvumetercolors' 1" check="var_equal '@$hntnhvumetercolors' 1"/>
        <separator/>
        <item text="Show Extra Peak Meter" localize="true" action="toggle '@$show_peak_meter'" check="var_equal '@$show_peak_meter' 1"/>
      </submenu>
      <submenu text="Filter Resonance" localize="true">
        <item text="Default" action="setting 'filterDefaultResonance' 'default'" check="setting 'filterDefaultResonance' 'default'"/>
        <item text="Strong" action="setting 'filterDefaultResonance' 'strong'" check="setting 'filterDefaultResonance' 'strong'"/>
        <item text="Subtle" action="setting 'filterDefaultResonance' 'subtle'" check="setting 'filterDefaultResonance' 'subtle'"/>
      </submenu>
      <submenu text="Fader Start" localize="true">
        <item text="ON" action="deck all setting 'faderStart' on" check="setting 'faderStart' on"/>
        <item text="OFF" action="deck all setting 'faderStart' off" check="setting 'faderStart' off"/>
      </submenu>
      <submenu text="Fader StartStop" localize="true">
        <item text="ON" action="deck all setting 'faderStartStop' on" check="setting 'faderStartStop' on"/>
        <item text="OFF" action="deck all setting 'faderStartStop' off" check="setting 'faderStartStop' off"/>
      </submenu>
      <separator/>
      <item text="Reset EQ On Load" localize="true" action="setting 'resetEqOnLoad'" check="setting 'resetEqOnLoad'"/>
      <item text="Use Auto Gain" localize="true" action="setting 'autoGain' 'auto' ? setting 'autoGain' 'no' : setting 'autoGain' 'auto'" check="setting 'autoGain' 'auto'"/>
      <item text="Show Drop Down Menus" localize="true" action="toggle '@$show_drop_menus'" check="var_equal '@$show_drop_menus' 0"/>
      <separator/>
      <submenu text="Crossfader" localize="true">
        <item text="Disabled" action="setting 'crossfaderDisable'" check="setting 'crossfaderDisable'"/>
        <item text="Hamster" action="setting 'crossfaderHamster'" check="setting 'crossfaderHamster'"/>
        <separator/>
        <item text="Full" action="setting 'crossfaderCurve' 'full'" check="setting 'crossfaderCurve' 'full'"/>
        <item text="Smooth" action="setting 'crossfaderCurve' 'smooth'" check="setting 'crossfaderCurve' 'smooth'"/>
        <item text="Scratch" action="setting 'crossfaderCurve' 'scratch'" check="setting 'crossfaderCurve' 'scratch'"/>
        <item text="Custom" action="setting 'crossfaderCurve' 'custom'" check="setting 'crossfaderCurve' 'custom'"/>
        <item text="Cut" action="setting 'crossfaderCurve' 'cut'" check="setting 'crossfaderCurve' 'cut'"/>
      </submenu>
    </menu>
  </define>
  <define class="CHANNEL_EQS" placeholders="deck">
    <deck deck="[DECK]">
      <group novisibility="setting 'eqMode' 'STEMS'">
        <button class="dropdown_menu" action="eq_mode" x="+58" y="+8" visibility="var_equal '@$show_drop_menus' 0"/>
        <panel class="knob" x="+18" y="+14" knobsize="41" knobradius="10" faderradius="9" action="gain" rgclick="match_gain" dblclick="gain 50%" frommiddle="true" fillcolor="knobfillon" textaction="gain_label" actiontxt="var_equal '@$show_drop_menus' 1 ? eq_mode : eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+76" knobsize="41" knobradius="10" faderradius="9" action="eq_high" rgclick="eq_high 0% ? eq_high 50% : eq_high 0%" dblclick="eq_high 50%" frommiddle="true" fillcolor="knobfillon" textaction="high_label" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+76+67" knobsize="41" knobradius="10" faderradius="9" action="eq_mid" rgclick="eq_mid 0% ? eq_mid 50% : eq_mid 0%" dblclick="eq_mid 50%" frommiddle="true" fillcolor="knobfillon" textaction="mid_label 'short'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+76+67+67" knobsize="41" knobradius="10" faderradius="9" action="eq_low" rgclick="eq_low 0% ? eq_low 50% : eq_low 0%" dblclick="eq_low 50%" frommiddle="true" fillcolor="knobfillon" textaction="low_label" actiontxt="eq_mode +1"/>
        <!-- PRO: AUDIO PANEL: COLORFX -->
        <button class="dropdown_menu" action="effect_select colorfx" x="+58" y="+14+81+68+68+50+6" visibility="var_equal '@$show_drop_menus' 0"/>
        <!-- filter on light -->
        <group x="+55" y="+14+81+68+68+50+6">
          <visual>
            <size width="16" height="16"/>
            <off shape="circle" color="#333333" border="#222222" border_size="1"/>
          </visual>
          <button action="effect_active 'colorfx'" query="effect_active 'colorfx'" shape="circle">
            <size width="8" height="8"/>
            <pos x="+4" y="+4"/>
            <off shape="circle" color="#AAAAAA" border="#000000" border_size="1"/>
            <selected shape="circle" color="#00FF00" border="#222222" border_size="1"/>
            <over shape="circle" color="#DDDDDD" border="#000000" border_size="0"/>
            <down shape="circle" color="#00FF00" border="#88FFFF00" border_size="0"/>
          </button>
        </group>
        <!-- colorfx on mixer panel on pro -->
        <panel class="knob" x="+18" y="+14+81+68+68+50+13" knobsize="41" knobradius="10" faderradius="9" action="filter" dblclick="filter 50%" frommiddle="true" fillcolor="knobfillon" textaction="filter_label &amp; param_cast 'text' 9" actiontxt="filter_selectcolorfx"/>
      </group>
      <!-- 5knobs -->
      <group visibility="setting 'eqMode' 'STEMS'">
        <button class="dropdown_menu" action="eq_mode" x="+68" y="+6" visibility="var_equal '@$show_drop_menus' 0"/>
        <panel class="knob" x="+18" y="+14" knobsize="41" knobradius="10" faderradius="9" action="stem 'instru'" rgclick="stem 'instru' 0% ? stem 'instru' 50% : stem 'instru' 0%" dblclick="stem 'instru' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'INSTRU'" actiontxt="var_equal '@$show_drop_menus' 1 ? eq_mode : eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+76" knobsize="41" knobradius="10" faderradius="9" action="stem 'hihat'" rgclick="stem 'hihat' 0% ? stem 'hihat' 50% : stem 'hihat' 0%" dblclick="stem 'hihat' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'HIHAT'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+76+67" knobsize="41" knobradius="10" faderradius="9" action="stem 'vocal'" rgclick="stem 'vocal' 0% ? stem 'vocal' 50% : stem 'vocal' 0%" dblclick="stem 'vocal' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'VOCAL'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+76+67+67" knobsize="41" knobradius="10" faderradius="9" action="stem 'kick'" rgclick="stem 'kick' 0% ? stem 'kick' 50% : stem 'kick' 0%" dblclick="stem 'kick' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'KICK'" actiontxt="eq_mode +1"/>
        <panel class="knob" x="+18" y="+14+81+68+68+68+13" knobsize="41" knobradius="10" faderradius="9" action="stem 'bass'" rgclick="stem 'bass' 0% ? stem 'bass' 50% : stem 'bass' 0%" dblclick="stem 'bass' 50%" frommiddle="true" fillcolor="knobfillon" textaction="get_text 'BASS'" actiontxt="eq_mode +1"/>
      </group>
    </deck>
  </define>
  <define class="CHANNEL_LEVELS" placeholders="deck">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="77" height="432-56-1" coloroff="#000000"/>
      <panel class="vu_meter_leds" x="+23" y="+5" source="get_level_left" showpeaks="var_equal '@$show_peak_meter' 1"/>
      <panel class="vu_meter_leds" x="+23+11+10" y="+5" source="get_level_right" showpeaks="var_equal '@$show_peak_meter' 1"/>
      <button class="button_main" action="pfl" query="pfl">
        <pos x="+10" y="+175"/>
        <size width="60" height="25"/>
        <!-- OFF / default -->
        <off color="transparent" border="button_background4" border_size="1" radius="3"/>
        <over color="transparent" border="button_background4" border_size="1" radius="3"/>
        <!-- ON when deck is PFL -->
        <down color="transparent" border="deckcolor" border_size="1" radius="3"/>
        <selected color="transparent" border="deckcolor" border_size="1" radius="3"/>
        <text text="CUE" fontsize="10" align="center" valign="center" color="textdarker" colordown="deckcolor" colorselected="deckcolor"/>
      </button>
      <panel class="deck_level" x="+11+9" y="+6+10+200"/>
    </deck>
  </define>
</defs>
