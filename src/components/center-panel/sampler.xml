<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Sampler pane: bank select, sample list, output/pad-page controls and VU. -->
  <define class="SAMPLER_MIXER_PANE">
    <deck deck="master">
      <group name="sampler_panel" x="+0" y="+0" visibility="true">
        <visual x="+4" width="307" height="440">
          <off shape="square" color="dark_3" radius="6" bordersize="1" border="dark_6"/>
        </visual>
        <!-- SAMPLER BANK SELECT -->
        <group x="+0" y="+0">
          <group x="+10">
            <!-- bank left -->
            <button action="sampler_bank -1">
              <pos x="+0"/>
              <size width="24" height="24"/>
              <off color="dark_0" border="dark_6" border_size="1"/>
              <on color="transparent" border="#222222" border_size="1"/>
              <down color="dark_0" border="dark_6" border_size="1"/>
              <icon sysicon="arrowleft" color="#555555" colorover="#999999" dx="-3" width="24" height="24"/>
            </button>
            <!-- bank right -->
            <button action="sampler_bank +1">
              <pos x="+23"/>
              <size width="24" height="24"/>
              <off color="dark_0" border="dark_6" border_size="1"/>
              <on color="transparent" border="#222222" border_size="1"/>
              <down color="dark_0" border="dark_6" border_size="1"/>
              <icon sysicon="arrowright" color="#555555" colorover="#999999" dx="+2" width="24" height="24"/>
            </button>
            <!-- bank name -->
            <button class="button_main" x="+0+26+20" width="248" height="24" action="sampler_bank" rightclick="sampler_options" coloron="transparent">
              <off color="dark_0" border="dark_6" border_size="1"/>
              <text action="get_sampler_bank" dx="+10" fontsize="12" color="white" weight="bold" align="left"/>
            </button>
          </group>
        </group>
        <!-- open samples in library -->
        <button x="+250" y="+0" width="24" height="24" visibility="true" query="browser_gotofolder 'Sampler'" action="browser_gotofolder 'Sampler'">
          <off color="transparent" border="#000000" border_size="0" shape="square"/>
          <on color="#444444" border="#111111" border_size="0" shape="square"/>
          <over color="transparent" border="#000000" border_size="0" shape="square"/>
          <selected color="#333333" border="#555555" border_size="0" shape="square"/>
          <icon dx="+0" dy="+0" sysicon="add_favoritefolder" width="20" height="18" color="#888888" colorselected="white" colordown="white" colorover="#FFFFFF"/>
        </button>
        <!-- sidebar toggle -->
        <button x="+275" y="+0" width="24" height="24" visibility="true" action="show_splitpanel 'sideview' toggle &amp; sideview sampler">
          <off color="transparent" border="#000000" border_size="0" shape="square"/>
          <on color="#444444" border="#111111" border_size="0" shape="square"/>
          <over color="transparent" border="#000000" border_size="0" shape="square"/>
          <selected color="#333333" border="#555555" border_size="0" shape="square"/>
          <icon dx="+0" dy="+0" sysicon="sideview 'sampler'" width="20" height="18" color="#888888" colorselected="white" colordown="white" colorover="#FFFFFF"/>
        </button>
      </group>
      <!-- SAMPLE LIST BOX -->
      <group x="+10" y="+30">
        <visual x="+0" y="+0" width="310-10-6" height="34*8+4">
          <off shape="square" color="black" border_size="1" border="dark_7" radius="6"/>
        </visual>
        <group x="+2" y="+2">
          <panel class="sampler_row" deck="master" index="1" y="+34*0" visibility="sampler_loaded 1"/>
          <panel class="sampler_row" deck="master" index="2" y="+34*1" visibility="sampler_loaded 2"/>
          <panel class="sampler_row" deck="master" index="3" y="+34*2" visibility="sampler_loaded 3"/>
          <panel class="sampler_row" deck="master" index="4" y="+34*3" visibility="sampler_loaded 4"/>
          <panel class="sampler_row" deck="master" index="5" y="+34*4" visibility="sampler_loaded 5"/>
          <panel class="sampler_row" deck="master" index="6" y="+34*5" visibility="sampler_loaded 6"/>
          <panel class="sampler_row" deck="master" index="7" y="+34*6" visibility="sampler_loaded 7"/>
          <panel class="sampler_row" deck="master" index="8" y="+34*7" visibility="sampler_loaded 8"/>
        </group>
        <!-- BOTTOM SECTION -->
        <group y="+275">
          <group name="sampler_output" x="+0">
            <textzone class="text" x="+0" y="+0" width="50" height="18" fontsize="8" color="textoff" align="left" weight="" text="OUTPUT"/>
            <button x="+0" y="+14" query="false" textsize="11" class="button_main" action="param_equal `setting 'samplerOutputDeck'` 0 ? setting 'samplerOutputDeck' -1 : setting 'samplerOutputDeck' 0" rightclick="sampler_output 'popup'" textaction="param_equal `setting 'samplerOutputDeck'` 0 ? get_text 'MASTER' : param_equal `setting 'samplerOutputDeck'` -1 ? get_text 'HEADPHONES' : param_equal `setting 'samplerOutputDeck'` -2 ? get_text 'TRIGGER' : get_text 'DECK `setting &quot;samplerOutputDeck&quot;`'">
              <size width="90" height="16"/>
              <off color="#111111" border="#555555" radius="4"/>
              <down color="#111111" border="#555555" radius="4"/>
              <text align="center" color="white" radius="4"/>
            </button>
          </group>
          <group name="sampler_pad_page_select" x="+188" y="+5">
            <deck deck="master">
              <button x="+0" class="button_main" bordersize="1" action="deck 1 masterdeck ? deck 1 sampler_pad_page -1 : deck 2 masterdeck ? deck 2 sampler_pad_page -1 : deck 3 masterdeck ? deck 3 sampler_pad_page -1 : deck 4 masterdeck ? deck 4 sampler_pad_page -1 : sampler_pad_page -1" textsize="10" textcolor="white">
                <size width="24" height="24"/>
                <off color="#111111"/>
                <down color="#111111"/>
                <selected color="#111111"/>
                <icon sysicon="arrowleft" color="#555555" colorover="#999999" dx="-2" width="18" height="18"/>
              </button>
              <button x="+23" class="button_main" bordersize="1" textsize="11" width="60" height="26" action="deck 1 masterdeck ? deck 1 sampler_pad_page +1 : deck 2 masterdeck ? deck 2 sampler_pad_page +1 : deck 3 masterdeck ? deck 3 sampler_pad_page +1 : deck 4 masterdeck ? deck 4 sampler_pad_page +1 : sampler_pad_page +1" textcolor="white">
                <size width="60" height="24"/>
                <off color="#111111"/>
                <down color="#111111"/>
                <selected color="#111111"/>
                <text align="center" weight="" action="deck 1 masterdeck ? deck 1 sampler_pad_page : deck 2 masterdeck ? deck 2 sampler_pad_page : deck 3 masterdeck ? deck 3 sampler_pad_page : deck 4 masterdeck ? deck 4 sampler_pad_page : sampler_pad_page"/>
              </button>
              <button x="+82" class="button_main" bordersize="1" action="deck 1 masterdeck ? deck 1 sampler_pad_page +1 : deck 2 masterdeck ? deck 2 sampler_pad_page +1 : deck 3 masterdeck ? deck 3 sampler_pad_page +1 : deck 4 masterdeck ? deck 4 sampler_pad_page +1 : sampler_pad_page +1" textsize="10" textcolor="white">
                <size width="24" height="24"/>
                <off color="#111111"/>
                <down color="#111111"/>
                <selected color="#111111"/>
                <icon sysicon="arrowright" color="dark_5" colorover="white" dx="+2" width="18" height="18"/>
              </button>
              <visual x="+0" y="+0" width="106" height="24" visibility="1.0">
                <off shape="square" color="transparent" border_size="1" border="dark_7" radius="6"/>
              </visual>
            </deck>
          </group>
        </group>
        <!-- SAMPLER VUMETER -->
        <group x="+0" y="+310">
          <visual x="+0" y="+0" width="295" height="43-8-8">
            <off shape="square" color="black" border_size="1" border="dark_7" radius="4"/>
          </visual>
          <!-- LABEL -->
          <textzone class="text" x="+0" y="+0" width="56" height="27" fontsize="10" color="textdarker" align="right" weight="" text="SAMPLER"/>
          <!-- L -->
          <visual type="vumeter" source="get_level_left 'sampler'" x="+58+8" y="+6" width="70" height="6" smooth="no">
            <led x="+0" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*2" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*3" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*4" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*5" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*6" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*7" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*8" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*9" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*10" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*11" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="orange_vu" radius="0" border="contrast" border_size="0"/>
            </led>
          </visual>
          <!-- R -->
          <visual type="vumeter" source="get_level_right 'sampler'" x="+58+8" y="+6+7+2" width="70" height="6" smooth="no">
            <led x="+0" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*2" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*3" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*4" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*5" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*6" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*7" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*8" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*9" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*10" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="green_vu" radius="0" border="contrast" border_size="0"/>
            </led>
            <led x="+6*11" y="+0" width="4" height="6">
              <off color="vu_background" radius="0" border="contrast" border_size="0"/>
              <on color="orange_vu" radius="0" border="contrast" border_size="0"/>
            </led>
          </visual>
          <!-- Sampler Master Volume (horizontal slider) -->
          <slider action="sampler_volume_master" dblclick="sampler_volume_master 80%" orientation="horizontal" direction="up" frommiddle="false">
            <pos x="+58+8" y="+4"/>
            <size width="70" height="20"/>
            <fader color="#999999" width="3" height="20"/>
          </slider>
          <!-- SAMPLER CUE BUTTON -->
          <button x="+295-44-42" y="+3" width="40" height="21" shape="square" action="setting 'SamplerHeadphones'" border_size="1" radius="4">
            <off color="#000000" border="#444444" radius="4"/>
            <over color="#333333" border="#888888" radius="4"/>
            <selected color="black" border="color_sampler" radius="4"/>
            <text align="center" color="#888888" colorselected="color_sampler" text="CUE">CUE</text>
          </button>
          <!-- SAMPLER PLAY/STOP BUTTON -->
          <button x="+295-40-4" y="+3" width="40" height="21" shape="square" action="sampler_play_stop" query="sampler_play" radius="4" color="black">
            <off color="#000000" border="#444444" radius="4"/>
            <on color="#222222" border="#888888" radius="4"/>
            <over color="#222222" border="#888888" radius="4"/>
            <down color="#222222" border="#888888" radius="4"/>
            <selected color="color_sampler" border="color_sampler" radius="4"/>
            <icon dx="-1" sysicon="play" width="28" height="28" colorover="needle" color="#888888" coloron="white" colordown="white" colorselected="black"/>
          </button>
        </group>
      </group>
      <!-- bottom section, top row buttons -->
    </deck>
  </define>
  <define class="SAMPLER_ROW" placeholders="*deck,*index">
    <deck deck="[DECK]">
      <visual source="sampler_position [INDEX]" type="linear" orientation="horizontal" direction="up" granularity="23">
        <pos x="+0" y="+0"/>
        <size width="290" height="35"/>
        <off shape="square" color="#000000" radius="0" border_size="1" border="#222222"/>
        <over shape="square" color="#111111" radius="0" border_size="1" border="#222222"/>
      </visual>
      <visual source="sampler_position [INDEX]" type="linear" orientation="horizontal" direction="up" granularity="23">
        <pos x="+0" y="+0"/>
        <size width="290" height="35"/>
        <on shape="square" color="#0000DD" radius="6"/>
      </visual>
      <group x="+7" y="+6" visibility="sampler_play [INDEX] 'auto' ? blink 1bt : true">
        <visual type="color" source="sampler_color [INDEX]">
          <size width="10" height="23"/>
        </visual>
        <textzone>
          <size width="10" height="16"/>
          <text fontsize="10" color="#000000" align="center" weight="" text="[INDEX]"/>
        </textzone>
      </group>
      <group x="+22">
        <textzone>
          <size width="230" height="22"/>
          <text fontsize="12" color="#AAAAAA" align="left" format="`deck 1 masterdeck ? deck 1 sampler_pad [INDEX] : deck 2 masterdeck ? deck 2 sampler_pad [INDEX] : deck 3 masterdeck ? deck 3 sampler_pad [INDEX] : deck 4 masterdeck ? deck 4 sampler_pad [INDEX] : sampler_pad [INDEX]`"/>
        </textzone>
        <group y="+13">
          <textzone>
            <pos x="+0" y="+0"/>
            <size width="200" height="22"/>
            <text fontsize="11" color="#FFFFFF" align="left" action="get_sample_info [INDEX] bpm"/>
          </textzone>
          <textzone>
            <pos x="+67" y="+0"/>
            <size width="50" height="22"/>
            <text fontsize="11" weight="normal" color="#FFFFFF" align="center" action="param_equal `sampler_pad_page` &quot;1 to 8&quot; ? get_text '`get_sample_info [INDEX] key`' : param_equal `sampler_pad_page` &quot;9 to 16&quot; ? get_text '`get_constant 8 &amp; param_add [INDEX] &amp; get_sample_info key`' : param_equal `sampler_pad_page` &quot;17 to 24&quot; ? get_text '`get_constant 16 &amp; param_add [INDEX] &amp; get_sample_info key`' : param_equal `sampler_pad_page` &quot;25 to 32&quot; ? get_text '`get_constant 24 &amp; param_add [INDEX] &amp; get_sample_info key`' : param_equal `sampler_pad_page` &quot;33 to 40&quot; ? get_text '`get_constant 32 &amp; param_add [INDEX] &amp; get_sample_info key`' : param_equal `sampler_pad_page` &quot;41 to 48&quot; ? get_text '`get_constant 40 &amp; param_add [INDEX] &amp; get_sample_info key`' : param_equal `sampler_pad_page` &quot;49 to 56&quot; ? get_text '`get_constant 48 &amp; param_add [INDEX] &amp; get_sample_info key`' : param_equal `sampler_pad_page` &quot;57 to 64&quot; ? get_text '`get_constant 56 &amp; param_add [INDEX] &amp; get_sample_info key`' : get_text ''"/>
          </textzone>
          <textzone>
            <pos x="+90" y="+0"/>
            <size width="50" height="22"/>
            <text fontsize="11" weight="normal" color="#FFFFFF" align="center" action="param_equal `sampler_pad_page` &quot;1 to 8&quot; ? get_text '`get_sample_info [INDEX] mode`' : param_equal `sampler_pad_page` &quot;9 to 16&quot; ? get_text '`get_constant 8 &amp; param_add [INDEX] &amp; get_sample_info mode`' : param_equal `sampler_pad_page` &quot;17 to 24&quot; ? get_text '`get_constant 16 &amp; param_add [INDEX] &amp; get_sample_info mode`' : param_equal `sampler_pad_page` &quot;25 to 32&quot; ? get_text '`get_constant 24 &amp; param_add [INDEX] &amp; get_sample_info mode`' : param_equal `sampler_pad_page` &quot;33 to 40&quot; ? get_text '`get_constant 32 &amp; param_add [INDEX] &amp; get_sample_info mode`' : param_equal `sampler_pad_page` &quot;41 to 48&quot; ? get_text '`get_constant 40 &amp; param_add [INDEX] &amp; get_sample_info mode`' : param_equal `sampler_pad_page` &quot;49 to 56&quot; ? get_text '`get_constant 48 &amp; param_add [INDEX] &amp; get_sample_info mode`' : param_equal `sampler_pad_page` &quot;57 to 64&quot; ? get_text '`get_constant 56 &amp; param_add [INDEX] &amp; get_sample_info mode`' : get_text ''"/>
          </textzone>
        </group>
      </group>
      <group x="+258" y="+0">
        <button action="sampler_pad [INDEX]" rightclick="sampler_edit [INDEX]" query="sampler_play [INDEX] 'auto'" shape="square" visibility="sampler_play [INDEX] 'auto' ? blink 1bt : true">
          <size width="34" height="34"/>
          <icon dx="-1" dy="+0" sysicon="play" width="34" height="34" color="#555555" coloron="white" colorselected="white"/>
        </button>
      </group>
      <button action="sampler_pad [INDEX]" query="sampler_position [INDEX]" deck="master" rightclick="param_equal `sampler_pad_page` &quot;1 to 8&quot; ? sampler_edit [INDEX] : param_equal `sampler_pad_page` &quot;9 to 16&quot; ? get_constant 8 &amp; param_add [INDEX] &amp; sampler_edit : param_equal `sampler_pad_page` &quot;17 to 24&quot; ? get_constant 16 &amp; param_add [INDEX] &amp; sampler_edit : param_equal `sampler_pad_page` &quot;25 to 32&quot; ? get_constant 24 &amp; param_add [INDEX] &amp; sampler_edit : param_equal `sampler_pad_page` &quot;33 to 40&quot; ? get_constant 32 &amp; param_add [INDEX] &amp; sampler_edit : param_equal `sampler_pad_page` &quot;41 to 48&quot; ? get_constant 40 &amp; param_add [INDEX] &amp; sampler_edit : param_equal `sampler_pad_page` &quot;49 to 56&quot; ? get_constant 48 &amp; param_add [INDEX] &amp; sampler_edit : param_equal `sampler_pad_page` &quot;57 to 64&quot; ? get_constant 56 &amp; param_add [INDEX] &amp; sampler_edit : nothing">
        <pos x="+1" y="+1"/>
        <size width="288" height="33"/>
        <off color="transparent" border_size="0"/>
        <on color="transparent" border="dark_8" border_size="1" radius="5"/>
      </button>
    </deck>
  </define>
</defs>
