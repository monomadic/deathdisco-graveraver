<?xml version="1.0" encoding="UTF-8"?>
<module>
  <!-- BOTTOM BAR (UTILITY BAR)
    height: 50px
  -->
  <panel name="bottombar" x="0" y="1080-50">
    <visual width="1920" height="50">
      <off shape="square" color="#000000" border_size="1" border="#222222"/>
    </visual>
    <visual x="+7" y="+8" width="5" height="15">
      <off shape="square" color="[ACCENT_COLOR]" border_size="1" border="#222222"/>
    </visual>
    <!-- PANEL: HASHTAGS -->
    <group name="browser_tools" visibility="var_equal '@$bottombar_mode' 0">
      <group name="genre_tags" x="+38" y="+6">
        <!-- BUTTONS -->
        <panel class="filter_tag_button" x="+0" accent_color="color_tag_genre" tag="#BassHouse" text="#BASS-HOUSE" width="92"/>
        <panel class="filter_tag_button" x="+95" accent_color="color_tag_genre" tag="#Tech-House" text="#TECH-HOUSE" width="90"/>
        <panel class="filter_tag_button" x="+187" accent_color="color_tag_genre" tag="#Techno" text="#TECHNO" width="64"/>
        <panel class="filter_tag_button" x="+253" accent_color="color_tag_genre" tag="#PsyTrance" text="#PSYTRANCE" width="84"/>
        <panel class="filter_tag_button" x="+340" accent_color="color_tag_genre" tag="#Synthwave" width="86" text="#SYNTHWAVE"/>
        <panel class="filter_tag_button" x="+428" accent_color="color_tag_genre" tag="#Rap" width="40" text="#RAP"/>
        <panel class="filter_tag_button" x="+471" accent_color="color_tag_genre" tag="#Melodic" width="70" text="#MELODIC"/>
      </group>
      <group name="genre_tags" x="+38" y="+26">
        <panel class="filter_tag_button" x="+0" accent_color="color_tag_genre" tag="#Trap" text="#TRAP" width="50"/>
        <panel class="filter_tag_button" x="+53" accent_color="color_tag_genre" tag="#BaileFunk" text="#BAILE-FUNK" width="80"/>
      </group>
      <!-- MIX -->
      <group name="mix_tags" x="+600">
        <line x="+0" y="+0" width="1" height="50" highlight="#101010" shadow="#707070"/>
        <textzone class="text" x="+5" y="+0" orientation="vertical" width="15" height="50" fontsize="12" color="color_tag_mix" align="center" weight="bold" text="MIX"/>
        <!-- buttons -->
        <group x="+30" y="+9">
          <panel class="filter_tag_button" x="+0" accent_color="color_tag_mix" tag="#Acapella" text="#ACAPELLA" width="76"/>
          <panel class="filter_tag_button" x="+78" accent_color="color_tag_mix" tag="#BackingTrack" text="#BACKING-TRACK" width="108"/>
          <panel class="filter_tag_button" x="+188" accent_color="color_tag_mix" tag="#DJMix" text="#DJ-MIX" width="58"/>
          <panel class="filter_tag_button" x="+248" accent_color="color_tag_mix" tag="#Mixed" text="#MIXED" width="56"/>
        </group>
      </group>
      <!-- TIMING -->
      <group name="mix_timing" x="+950">
        <line x="+0" y="+0" width="1" height="50" highlight="#101010" shadow="#707070"/>
        <textzone class="text" x="+5" y="+0" orientation="vertical" width="15" height="50" fontsize="10" color="color_tag_timing" align="center" weight="bold" text="TIME"/>
        <!-- BUTTONS -->
        <group x="+30" y="+9">
          <panel class="filter_tag_button" x="+0" accent_color="color_tag_timing" tag="#Opener" text="#OPENER" width="66"/>
          <panel class="filter_tag_button" x="+0+66+2" accent_color="color_tag_timing" tag="#Peak" text="#PEAK" width="50"/>
          <panel class="filter_tag_button" x="+0+66+2+50+2" accent_color="color_tag_timing" tag="#Closer" text="#CLOSER" width="58"/>
        </group>
      </group>
      <!-- MOOD -->
      <group name="mix_mood" x="+1180">
        <line x="+0" y="+0" width="1" height="50" highlight="#101010" shadow="#707070"/>
        <textzone class="text" x="+5" y="+0" orientation="vertical" width="15" height="50" fontsize="10" color="color_tag_mood" align="center" weight="bold" text="MOOD"/>
        <!-- buttons -->
        <group x="+30" y="+9">
          <panel class="filter_tag_button" x="+0" accent_color="color_tag_mood" tag="#Club" width="50" text="#CLUB"/>
          <panel class="filter_tag_button" x="+0+50+2" accent_color="color_tag_mood" tag="#FredAgain" width="84" text="#FRED-AGAIN"/>
          <panel class="filter_tag_button" x="+0+138+2" accent_color="color_tag_mood" tag="#Banger" width="84" text="#BANGER"/>
          <panel class="filter_tag_button" x="+0+226+2" accent_color="color_tag_mood" tag="#OnTrend" width="84" text="#ON-TREND"/>
        </group>
      </group>
      <!-- sidepanel toggles -->
      <group x="+1690" y="+0">
        <!-- sampler -->
        <button x="+0" width="40" height="50" query="show_splitpanel 'sideview' &amp; sideview 'remixes'" action="show_splitpanel 'sideview' &amp; sideview 'remixes'">
          <off color="transparent" border="#000000" border_size="0" shape="square"/>
          <on color="#444444" border="#111111" border_size="0" shape="square"/>
          <over color="transparent" border="#000000" border_size="0" shape="square"/>
          <selected color="#333333" border="#555555" border_size="0" shape="square"/>
          <icon dx="+0" dy="+0" sysicon="sideview 'remixes'" width="30" height="30" color="#888888" colorselected="white" colordown="white" colorover="#FFFFFF"/>
        </button>
        <button x="+0" width="40" height="50" query="show_splitpanel 'sideview' &amp; sideview 'remixes'" action="show_splitpanel 'sideview' &amp; sideview 'remixes'" visibility="has_linked_tracks">
          <off color="#004400" border="#000000" border_size="0" shape="square"/>
          <on color="#004400" border="#111111" border_size="0" shape="square"/>
          <over color="#004400" border="#000000" border_size="0" shape="square"/>
          <selected color="#004400" border="#555555" border_size="0" shape="square"/>
          <icon dx="+0" dy="+0" sysicon="sideview 'remixes'" width="30" height="30" color="#88FF88" colorselected="green" colordown="green" colorover="#FFFFFF"/>
        </button>
        <!-- sampler -->
        <button x="+45" width="40" height="50" query="sideview sampler ? show_splitpanel 'sideview'" action="sideview sampler &amp; show_splitpanel 'sideview'">
          <off color="transparent" border="#000000" border_size="0" shape="square"/>
          <on color="#444444" border="#111111" border_size="0" shape="square"/>
          <over color="transparent" border="#000000" border_size="0" shape="square"/>
          <selected color="#3333A3" border="#555555" border_size="0" shape="square"/>
          <icon dx="+0" dy="+0" sysicon="sideview 'sampler'" width="30" height="30" color="#888888" colorselected="#6688FF" colordown="white" colorover="#FFFFFF"/>
        </button>
        <!-- karaoke -->
        <button x="+90" width="40" height="50" query="sideview karaoke ? show_splitpanel 'sideview'" action="sideview karaoke &amp; show_splitpanel 'sideview'">
          <off color="transparent" border="#000000" border_size="0" shape="square"/>
          <on color="#444444" border="#111111" border_size="0" shape="square"/>
          <over color="transparent" border="#000000" border_size="0" shape="square"/>
          <selected color="#333333" border="#555555" border_size="0" shape="square"/>
          <icon dx="+0" dy="+0" sysicon="sideview 'karaoke'" width="30" height="30" color="#888888" colorselected="white" colordown="white" colorover="#FFFFFF"/>
        </button>
      </group>
      <group name="color/rating/relayplay/automix" x="+1000+494-32+122+105+2+55+2+84" y="+2">
        <group y="+2">
          <visual class="gfx_shape" x="+0" y="+0" width="83" height="42" coloroff="#660099" radius="3"/>
          <button x="+90" width="40" height="50" query="sideview karaoke ? show_splitpanel 'sideview'" action="switch_sidelist_playlist" text="SIDELIST">
            <off color="transparent" border="#000000" border_size="0" shape="square"/>
            <on color="#444444" border="#111111" border_size="0" shape="square"/>
            <over color="transparent" border="#000000" border_size="0" shape="square"/>
            <selected color="#333333" border="#555555" border_size="0" shape="square"/>
            <text size="10" color="br_textoff" text="SIDEPANEL"/>
          </button>
        </group>
      </group>
    </group>
    <group name="custom_buttons" visibility="var_equal '@$bottombar_mode' 1">
      <group x="+20">
        <button class="tag_button" source="24" x="+20" color="white" y="+6" width="80"/>
        <button class="tag_button" source="25" x="+105" y="+6" color="color_tag_genre"/>
        <button class="tag_button" source="26" x="+105*2" y="+6" color="color_tag_genre"/>
        <button class="tag_button" source="27" x="+105*3" y="+6" color="color_tag_genre"/>
        <button class="tag_button" source="28" x="+105*4" y="+6" color="color_tag_genre"/>
        <button class="tag_button" source="29" x="+105*5" y="+6" color="color_tag_mix"/>
        <button class="tag_button" source="30" x="+105*6" y="+6" color="color_tag_mix"/>
        <button class="tag_button" source="31" x="+105*7" y="+6" color="color_tag_mix"/>
        <button class="tag_button" source="32" x="+105*8" y="+6" color="color_tag_mix"/>
        <button class="tag_button" source="33" x="+105*9" y="+6" color="color_tag_mix"/>
        <button class="tag_button" source="34" x="+105*10" y="+6" color="color_tag_timing"/>
        <button class="tag_button" source="35" x="+105*11" y="+6" color="color_tag_timing"/>
        <button class="tag_button" source="36" x="+105*12" y="+6" color="color_tag_timing"/>
        <button class="tag_button" source="37" x="+105*13" y="+6" color="color_tag_timing"/>
        <button class="tag_button" source="38" x="+105*14" y="+6" color="color_tag_mood"/>
        <button class="tag_button" source="39" x="+105*15" y="+6" color="color_tag_mood"/>
        <button class="tag_button" source="40" x="+105*16" y="+6" color="color_tag_mood"/>
        <button class="tag_button" source="41" x="+105*17" y="+6" color="white"/>
      </group>
    </group>
    <button class="button_main" x="+5" y="+5" action="toggle '@$bottombar_mode'" width="28" height="28" textsize="12" textcoloron="needle" coloroff="panel_background" coloron="#333333" bordersize="0" sysicon="settings" iconsize="20"/>
  </panel>
</module>
