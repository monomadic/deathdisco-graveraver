<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Pro layout deck shells mirrored left/right plus the two-deck overlay treatment -->
  <define class="DECK_CONTAINER_PRO_LEFT" placeholders="*deck,*panelname,height=465">
    <deck deck="[DECK]">
      <!-- spine -->
      <panel x="0" y="+0" class="deck_spine"/>
      <!-- PRO: LEFT: PANEL BG (behind jog) -->
      <visual width="765" height="[HEIGHT]" x="+35">
        <off shape="square" color="panel_background" radius="6"/>
      </visual>
      <!-- PRO: LEFT: DECK INNER -->
      <group x="+35">
        <!-- PRO: LEFT: TRACK INFO -->
        <panel class="infos"/>
        <!-- LEFT: action zone -->
        <panel class="track_info_action_zone" y="+55" visibility="not has_video_mix 'active' ? yes : not skin_panel 'videomixer'"/>
        <!-- <panel class="times_bpm_key2" y="+72-2" visibility="has_video_mix 'active' &amp;&amp; skin_panel 'videomixer'"/> -->
        <group x="550">
          <!-- PRO: LEFT JOGWHEEL -->
          <panel class="jogwheel" x="750-150" y="+10" name="jogwheel_spinner"/>
          <!-- PRO: LEFT VOLUME -->
          <panel class="pitch_small" x="765" y="+20"/>
          <!-- PRO: LEFT DECK BORDER -->
        </group>
        <!-- PAD PAGES -->
        <panel class="pad_page_selector_panel" y="+180" x="+6" deck="[DECK]" panelname="[PANELNAME]_[DECK]"/>
        <!-- TRANSPORT BAR -->
        <panel class="transport_bar" y="+425" deck="[DECK]" x="+0" deckside="left"/>
        <!-- deck border -->
        <visual width="765" height="[HEIGHT]" y="+0">
          <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
        </visual>
      </group>
    </deck>
  </define>
  <define class="PRO_2DECKS_OVERLAYS" placeholders="*deck,height=466,width=766">
    <visual source="deck [DECK] select" deck="[DECK]" visibility="var_equal '@$dd_bordermode' 1">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <down color="transparent" border_size="1" border="deckcolor" shape="square" radius="8"/>
    </visual>
    <!-- drop area -->
    <dropzone deck="[DECK]">
      <size width="770-5" height="180"/>
      <over color="transparent" border_size="6" border="#33FFFFFF" shape="square" radius="6"/>
    </dropzone>
  </define>
  <define class="DECK_CONTAINER_PRO_RIGHT" placeholders="deck,*panelname,height=465">
    <deck deck="[DECK]">
      <!-- spine -->
      <panel x="+765" y="+0" class="deck_spine"/>
      <!-- bg behind jog -->
      <visual width="765" height="[HEIGHT]">
        <off shape="square" color="panel_background" radius="6"/>
      </visual>
      <!-- PRO: RIGHT: DECK INNER -->
      <group>
        <!-- cover, title etc -->
        <panel class="infos" x="+800-567" visibility="not has_video_mix 'active' ? yes : not skin_panel 'videomixer'"/>
        <cues dy="0" shade="0">
          <size width="200" height="10"/>
          <clipmask x="27" y="140"/>
        </cues>
        <panel class="track_info_action_zone" x="+800-565" y="+60" visibility="not has_video_mix 'active' ? yes : not skin_panel 'videomixer'"/>
        <panel class="jogwheel" x="+55" y="+2+6+2" name="jogwheel_spinner" visibility="not has_video_mix 'active' ? yes : not skin_panel 'videomixer'"/>
        <panel class="pitch_small" x="+5" y="+20"/>
        <!-- PAD PAGES -->
        <panel class="pad_page_selector_panel" y="+180" x="+6" deck="[DECK]" panelname="[PANELNAME]_[DECK]"/>
        <!-- TRANSPORT BAR -->
        <panel class="transport_bar" y="+425" deck="[DECK]" x="+0" deckside="right"/>
        <!-- deck border -->
        <visual width="765" height="[HEIGHT]" y="+0">
          <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
        </visual>
      </group>
    </deck>
  </define>
  <!-- Performance layout shells, plus the shared browser-zoom mini deck strip -->
  <define class="KNOB_SMALL_THIN" placeholders="*label,knob_color=white">
    <panel x="+0" y="+16">
      <slider action="effect_slider 'colorfx'" rightclick="effect_select 'colorfx'" dblclick="effect_slider 'colorfx' 50%" orientation="round" frommiddle="true" resettomiddle="true">
        <pos x="+15" y="+0"/>
        <size width="30" height="30"/>
        <fill width="30" height="30" radius="11" color="knobfillon" backcolor="#22FFFFFF"/>
        <fader color="[KNOB_COLOR]" width="3" height="12" radius="1" anglemin="-130" anglemax="130"/>
      </slider>
      <textzone action="effect_select colorfx">
        <pos x="+0" y="+29"/>
        <size width="59"/>
        <text fontsize="9" weight="" color="knobtextoff" align="center" action="[LABEL]" important="true" localize="true"/>
      </textzone>
    </panel>
  </define>
  <define class="KNOB_XSMALL_THIN" placeholders="*label,knob_color=#EEEEEE,fill_color=yellow,bg_color=#AAAAAA">
    <visual width="30" height="35">
      <off shape="square" color="#11FFFFFF" radius="0"/>
    </visual>
    <panel x="+5" y="+4">
      <slider orientation="round" frommiddle="true" resettomiddle="true" action="effect_slider 'colorfx'" rightclick="effect_select 'colorfx'" dblclick="effect_slider 'colorfx' 50%">
        <size width="20" height="20"/>
        <fader color="[KNOB_COLOR]" width="2" height="6" radius="1" anglemin="-140" anglemax="140"/>
        <fill width="15" height="20" radius="6" color="[FILL_COLOR]" backcolor="[BG_COLOR]"/>
        <clipmask x="984" y="3142"/>
      </slider>
      <textzone action="effect_select colorfx">
        <pos x="+0" y="+20"/>
        <size width="20"/>
        <text fontsize="7" weight="" color="knobtextoff" align="center" action="[LABEL]" important="true" localize="true"/>
      </textzone>
    </panel>
  </define>
