<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Pad page container used by pro and extended deck layouts -->
  <define class="PAD_PAGE_UPPER_BANK_TAB" placeholders="*page" query="pad_page [PAGE]" action="pad_page [PAGE]" rightclick="pad_page_select [PAGE]">
    <size width="100" height="23"/>
    <off color="#000000" border="dark_6" radius="6" border_size="1"/>
    <over color="#000000" border="dark_6" radius="6" border_size="1"/>
    <down color="#000000" border="dark_6" radius="6" border_size="2"/>
    <selected color="#000000" border="dark_6" radius="6" border_size="2"/>
    <text dy="+1" weight="" fontsize="12" color="dark_7" colordown="white" colorover="white" align="center" action="shift ? get_text '' : pad_page btn[PAGE] &amp; param_uppercase"/>
  </define>
  <define class="PAD_PAGE_LOWER_TAB" placeholders="*page,*altpage" query="shift ? pad_page [ALTPAGE] : pad_page [PAGE]" action="shift ? pad_page [ALTPAGE] : pad_page [PAGE]" rightclick="pad_page_select [PAGE]">
    <size width="110" height="30"/>
    <off color="#000000" border="dark_6" radius="6" border_size="1"/>
    <over color="#000000" border="dark_6" radius="6" border_size="1"/>
    <down color="#000000" border="dark_6" radius="6" border_size="2"/>
    <selected color="#000000" border="dark_6" radius="6" border_size="2"/>
    <text dy="-2" weight="bold" fontsize="14" color="dark_7" colordown="white" colorover="white" align="center" action="shift ? pad_page [ALTPAGE] &amp; param_uppercase : pad_page [PAGE] &amp; param_uppercase"/>
  </define>
  <define class="PAD_PAGE_BANK_BUTTONS" placeholders="*page" query="pad_page [PAGE]" action="pad_page [PAGE]" rightclick="pad_page_select [PAGE]">
    <size width="100" height="23"/>
    <off color="#000000" border="dark_6" radius="6" border_size="1"/>
    <over color="#000000" border="dark_6" radius="6" border_size="1"/>
    <down color="#000000" border="dark_6" radius="6" border_size="2"/>
    <selected color="#000000" border="dark_6" radius="6" border_size="2"/>
    <text dy="+1" weight="" fontsize="12" color="dark_7" colordown="white" colorover="white" align="center" action="shift ? get_text '' : pad_page btn[PAGE] &amp; param_uppercase"/>
  </define>
  <define class="PADBANK_BUTTON" placeholders="textaction,*width=90">
    <size width="[WIDTH]" height="20"/>
    <off color="#000000" border="dark_4" radius="4" bordersize="2"/>
    <over color="#000000" border="dark_7" radius="4" bordersize="2"/>
    <down color="#000000" border="dark_7" radius="4" bordersize="2"/>
    <selected color="dark_3" border="#AAAAAA" radius="4" border_size="2"/>
    <text weight="bold" text="btn2" fontsize="11" color="dark_7" coloron="white" colordown="white" colorover="#AAAAAA" colorselected="white" align="center" action="[TEXTACTION]"/>
  </define>
  <define class="MINI_HOTCUE_BUTTON" placeholders="*index,*cue_width=16,*height=7" visibility="has_cue [INDEX]">
    <visual type="color" source="cue_color [INDEX]" visibility="has_cue [INDEX] ? play ? param_equal `get_cue` [INDEX] ? blink 1bt" radius="5">
      <pos x="+1" y="+1"/>
      <size width="[CUE_WIDTH]-2" height="[HEIGHT]-2"/>
    </visual>
    <button action="hot_cue [INDEX]" rightclick="goto_cue [INDEX]">
      <pos x="+0" y="+0"/>
      <size width="[CUE_WIDTH]" height="[HEIGHT]"/>
      <off color="#00000000" border="dark_8" border_size="1" radius="2"/>
      <over color="transparent" border="dark_7" border_size="1" radius="2"/>
      <text dy="-1" dx="-1" fontsize="12" coloroff="black" coloron="white" weight="" align="center" text=""/>
    </button>
    <visual type="color" source="cue_color [INDEX]" visibility="0.5" radius="5">
      <pos x="+0" y="+0"/>
      <size width="[CUE_WIDTH]" height="[HEIGHT]"/>
    </visual>
  </define>
  <!-- PAD PAGE CONTAINER -->
  <define class="PAD_PAGE_CONTAINER" placeholders="*deck,*panelname,*width=746,*show_shift_pads=true">
    <deck deck="[DECK]">
      <!-- background of entire pad area -->
      <visual class="gfx_shape" x="+0" y="+0" width="[WIDTH]" height="236" coloroff="#050505" bordersize="1" bordercoloroff="dark_5" radius="10"/>
      <group x="+8" y="+8">
        <panel name="@pads16_[PANELNAME]" width="[WIDTH]" group="pad_area_[PANELNAME]" visible="yes" available="yes" displayname="Pads x16" forceshow="16pads">
          <!-- PAD PAGE SELECT -->
          <group name="pad_page_select_8" condition="true">
            <!-- 1-4 -->
            <group>
              <visual width="[WIDTH]-16/2" height="24" visibility="not shift">
                <off shape="square" color="dark_5" border="dark_6" radius="5" border_size="2"/>
              </visual>
              <group x="+2" y="+2">
                <panel group="pads16_[PANELNAME]" visible="yes" available="no" displayname="16 Pads">
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+0" query="pad_page 1" action="pad_page 1" rightclick="pad_page_select 1" textaction="pad_page 1 &amp; param_uppercase"/>
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+[WIDTH]-24/8*1" query="pad_page 2" action="pad_page 2" rightclick="pad_page_select 2" textaction="pad_page 2 &amp; param_uppercase"/>
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+[WIDTH]-24/8*2" query="pad_page 3" action="pad_page 3" rightclick="pad_page_select 3" textaction="pad_page 3 &amp; param_uppercase"/>
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+[WIDTH]-24/8*3" query="pad_page 4" action="pad_page 4" rightclick="pad_page_select 4" textaction="pad_page 4 &amp; param_uppercase"/>
                </panel>
              </group>
              <!-- border when shift is pressed -->
              <visual width="[WIDTH]-16/2" height="24" visibility="shift">
                <off shape="square" color="#88000000" border="dark_3" radius="5" border_size="2"/>
              </visual>
            </group>
            <!-- 4-8 -->
            <group x="+[WIDTH]-14/2">
              <visual width="[WIDTH]-16/2" height="24" visibility="not shift">
                <off shape="square" color="dark_5" border="dark_6" radius="5" border_size="2"/>
              </visual>
              <group x="+2" y="+2">
                <panel group="pads16_[PANELNAME]" visible="yes" available="no" displayname="16 Pads">
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+0" query="pad_page 5" action="pad_page 5" rightclick="pad_page_select 5" textaction="pad_page 5 &amp; param_uppercase"/>
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+[WIDTH]-24/8*1" query="pad_page 6" action="pad_page 6" rightclick="pad_page_select 6" textaction="pad_page 6 &amp; param_uppercase"/>
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+[WIDTH]-24/8*2" query="pad_page 7" action="pad_page 7" rightclick="pad_page_select 7" textaction="pad_page 7 &amp; param_uppercase"/>
                  <button class="padbank_button" width="[WIDTH]-26/8" x="+[WIDTH]-24/8*3" query="pad_page 8" action="pad_page 8" rightclick="pad_page_select 8" textaction="pad_page 8 &amp; param_uppercase"/>
                </panel>
              </group>
              <visual width="[WIDTH]-16/2" height="24" visibility="not shift">
                <off shape="square" color="#66000000" border="dark_5" radius="5" border_size="1"/>
              </visual>
              <visual width="[WIDTH]-16/2" height="24" visibility="shift ? blink">
                <off shape="square" color="transparent" border="dark_6" radius="5" border_size="2"/>
              </visual>
            </group>
          </group>
          <!-- Compact: [WIDTH] < 500, only pad pages 1-4 full width -->
          <group name="pad_page_select_4" condition="constant [SHOW_SHIFT_PADS]">
            <visual width="[WIDTH]" height="24" visibility="not shift">
              <off shape="square" color="dark_5" border="dark_6" radius="5" border_size="2"/>
            </visual>
            <group x="+2" y="+2">
              <button class="padbank_button" width="[WIDTH]-8/4" x="+0" query="pad_page 1" action="pad_page 1" rightclick="pad_page_select 1" textaction="pad_page 1 &amp; param_uppercase"/>
              <button class="padbank_button" width="[WIDTH]-8/4" x="+[WIDTH]-8/4*1" query="pad_page 2" action="pad_page 2" rightclick="pad_page_select 2" textaction="pad_page 2 &amp; param_uppercase"/>
              <button class="padbank_button" width="[WIDTH]-8/4" x="+[WIDTH]-8/4*2" query="pad_page 3" action="pad_page 3" rightclick="pad_page_select 3" textaction="pad_page 3 &amp; param_uppercase"/>
              <button class="padbank_button" width="[WIDTH]-8/4" x="+[WIDTH]-8/4*3" query="pad_page 4" action="pad_page 4" rightclick="pad_page_select 4" textaction="pad_page 4 &amp; param_uppercase"/>
            </group>
          </group>
          <group y="+30">
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*0+0" y="+41*0" width="[WIDTH]-18/4" source="1"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*1+1" y="+41*0" width="[WIDTH]-18/4" source="2"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*2+2" y="+41*0" width="[WIDTH]-18/4" source="3"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*3+3" y="+41*0" width="[WIDTH]-18/4" source="4"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*0+0" y="+41*1" width="[WIDTH]-18/4" source="5"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*1+1" y="+41*1" width="[WIDTH]-18/4" source="6"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*2+2" y="+41*1" width="[WIDTH]-18/4" source="7"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*3+3" y="+41*1" width="[WIDTH]-18/4" source="8"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*0+0" y="+41*2" width="[WIDTH]-18/4" source="9"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*1+1" y="+41*2" width="[WIDTH]-18/4" source="10"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*2+2" y="+41*2" width="[WIDTH]-18/4" source="11"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*3+3" y="+41*2" width="[WIDTH]-18/4" source="12"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*0+0" y="+41*3" width="[WIDTH]-18/4" source="13"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*1+1" y="+41*3" width="[WIDTH]-18/4" source="14"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*2+2" y="+41*3" width="[WIDTH]-18/4" source="15"/>
            <panel class="pad_grid_button" x="+[WIDTH]-18/4*3+3" y="+41*3" width="[WIDTH]-18/4" source="16"/>
          </group>
          <!-- bottom row -->
          <group y="+40*4+30+6">
            <group>
              <group visibility="true">
                <panel class="mini_hotcue_button" index="1" x="+0" y="+0"/>
                <panel class="mini_hotcue_button" index="2" x="+16" y="+0"/>
                <panel class="mini_hotcue_button" index="3" x="+32" y="+0"/>
                <panel class="mini_hotcue_button" index="4" x="+48" y="+0"/>
              </group>
              <group x="+64+8">
                <panel class="mini_hotcue_button" index="5" x="+0" y="+0"/>
                <panel class="mini_hotcue_button" index="6" x="+16" y="+0"/>
                <panel class="mini_hotcue_button" index="7" x="+32" y="+0"/>
                <panel class="mini_hotcue_button" index="8" x="+48" y="+0"/>
              </group>
              <group x="+128+16">
                <panel class="mini_hotcue_button" index="9" x="+0" y="+0"/>
                <panel class="mini_hotcue_button" index="10" x="+16" y="+0"/>
                <panel class="mini_hotcue_button" index="11" x="+32" y="+0"/>
                <panel class="mini_hotcue_button" index="12" x="+48" y="+0"/>
              </group>
              <group x="+192+24">
                <panel class="mini_hotcue_button" index="13" x="+0" y="+0"/>
                <panel class="mini_hotcue_button" index="14" x="+22" y="+0"/>
                <panel class="mini_hotcue_button" index="15" x="+44" y="+0"/>
                <panel class="mini_hotcue_button" index="16" x="+66" y="+0"/>
              </group>
            </group>
            <!-- settings menu -->
            <group x="+[WIDTH]-380">
              <visual>
                <size width="22" height="22"/>
                <off shape="circle" color="transparent" border="dark_6" border_size="2"/>
                <icon sysicon="settings" coloroff="dark_7" colorover="white" colordown="dark_6" colorselected="dark_5" width="18" height="18"/>
              </visual>
              <menu>
                <size width="22" height="22"/>
                <size width="200" height="200"/>
                <icon sysicon="settings" coloroff="dark_8" colorover="white" colordown="white" colorselected="#66FFFFFF" width="18" height="18"/>
                <item text="Auto Match BPM" action="auto_match_bpm" check="auto_match_bpm" visibility="var_equal '@$skin_mode' 2 ? false : var_equal '@$skin_mode' 0 ? false : true"/>
              </menu>
            </group>
            <!-- menu -->
            <group x="+[WIDTH]-346">
              <button action="pad_menu 1" query="auto_match_bpm ? auto_match_key" visibility="pad_has_menu 1" shape="circle">
                <size width="58" height="24"/>
                <off shape="square" color="transparent" border="dark_6" border_size="1" radius="6"/>
                <over shape="square" color="transparent" border="dark_7" border_size="1" radius="6"/>
                <text text="MENU" align="center"/>
              </button>
            </group>
            <group x="+[WIDTH]-285">
              <!-- PARAM 1 -->
              <group name="pad_param1" visibility="pad_param_visible 1">
                <button class="button_main" x="+0" width="26" height="24" action="pad_param -1" iconsize="20" sysicon="arrowleft" coloroff="transparent" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <button class="button_main" x="+26" width="80" height="24" action="" query="off" textaction="pad_param" coloroff="transparent" coloron="xf_background" bordersize="1" textsize="12" textcolor="white"/>
                <button class="button_main" x="+26+80" width="26" height="24" action="pad_param +1" iconsize="20" sysicon="arrowright" coloroff="transparent" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <visual>
                  <size width="26+80+26" height="24"/>
                  <off shape="square" color="transparent" border="dark_6" border_size="1" radius="6"/>
                  <over shape="square" color="transparent" border="dark_7" border_size="1" radius="6"/>
                </visual>
              </group>
              <!-- PARAM 2 -->
              <group x="+26+80+30" name="pad_param1" visibility="pad_param_visible 2">
                <button class="button_main" x="+0" width="26" height="24" action="pad_param2 -1" iconsize="20" sysicon="arrowleft" coloroff="black" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <button class="button_main" x="+26" width="80" height="24" action="" query="off" textaction="pad_param2" coloroff="black" coloron="xf_background" bordersize="0" textsize="12" textcolor="white"/>
                <button class="button_main" x="+26+80" width="26" height="24" action="pad_param2 +1" iconsize="20" sysicon="arrowright" coloroff="black" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <visual>
                  <size width="26+80+26" height="24"/>
                  <off shape="square" color="transparent" border="dark_6" border_size="1" radius="6"/>
                </visual>
              </group>
            </group>
          </group>
        </panel>
      </group>
    </deck>
  </define>
</defs>
