<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Pad page container used by pro and extended deck layouts -->
  <define class="PAD_PAGE_UPPER_BANK_TAB" placeholders="*page" query="pad_page [PAGE]" action="pad_page [PAGE]" rightclick="pad_page_select [PAGE]">
    <size width="100" height="23"/>
    <off color="#000000" border="dark_6" radius="6" border_size="1"/>
    <over color="#000000" border="dark_6" radius="6" border_size="1"/>
    <down color="#000000" border="dark_6" radius="6" border_size="2"/>
    <selected color="#000000" border="dark_6" radius="6" border_size="2"/>
    <text dy="+1" weight="" fontsize="12" color="dark_7" colordown="white" colorover="white" align="center" action="shift ? get_text '' : pad_page btn[PAGE] &amp; param_uppercase"/>
  </define>
  <define class="PAD_PAGE_LOWER_TAB" placeholders="*page,*altpage" query="shift ? pad_page [ALTPAGE] : pad_page [PAGE]" action="shift ? pad_page [ALTPAGE] : pad_page [PAGE]" rightclick="pad_page_select [PAGE]">
    <size width="110" height="30"/>
    <off color="#000000" border="dark_6" radius="6" border_size="1"/>
    <over color="#000000" border="dark_6" radius="6" border_size="1"/>
    <down color="#000000" border="dark_6" radius="6" border_size="2"/>
    <selected color="#000000" border="dark_6" radius="6" border_size="2"/>
    <text dy="-2" weight="bold" fontsize="14" color="dark_7" colordown="white" colorover="white" align="center" action="shift ? pad_page [ALTPAGE] &amp; param_uppercase : pad_page [PAGE] &amp; param_uppercase"/>
  </define>
  <define class="PAD_PAGE_BANK_BUTTONS" placeholders="*page" query="pad_page [PAGE]" action="pad_page [PAGE]" rightclick="pad_page_select [PAGE]">
    <size width="100" height="23"/>
    <off color="#000000" border="dark_6" radius="6" border_size="1"/>
    <over color="#000000" border="dark_6" radius="6" border_size="1"/>
    <down color="#000000" border="dark_6" radius="6" border_size="2"/>
    <selected color="#000000" border="dark_6" radius="6" border_size="2"/>
    <text dy="+1" weight="" fontsize="12" color="dark_7" colordown="white" colorover="white" align="center" action="shift ? get_text '' : pad_page btn[PAGE] &amp; param_uppercase"/>
  </define>
  <define class="PADBANK_BUTTON" placeholders="textaction">
    <size width="90" height="20"/>
    <tooltip/>
    <off color="#000000" border="dark_4" radius="4" bordersize="2"/>
    <over color="#000000" border="dark_7" radius="4" bordersize="2"/>
    <down color="#000000" border="dark_7" radius="4" bordersize="2"/>
    <selected color="dark_3" border="#AAAAAA" radius="4" border_size="2"/>
    <text weight="bold" text="btn2" fontsize="11" color="dark_7" coloron="white" colordown="white" colorover="#AAAAAA" colorselected="white" align="center" action="[TEXTACTION]"/>
  </define>
  <!-- PAD PAGE CONTAINER -->
  <define class="PAD_PAGE_CONTAINER" placeholders="*deck,*panelname">
    <deck deck="[DECK]">
      <!-- background of entire pad area -->
      <visual class="gfx_shape" x="+0" y="+0" width="743" height="236" coloroff="#050505" bordersize="1" bordercoloroff="dark_4" radius="10"/>
      <group x="+6" y="+6">
        <panel name="@pads16_[PANELNAME]" group="pad_area_[PANELNAME]" visible="yes" available="yes" displayname="Pads x16" forceshow="16pads">
          <!-- PAD PAGE SELECT -->
          <group>
            <visual width="365" height="24" visibility="not shift">
              <off shape="square" color="dark_5" border="dark_7" radius="5" border_size="1"/>
            </visual>
            <group x="+3" y="+2">
              <panel group="pads16_[PANELNAME]" visible="yes" available="no" displayname="16 Pads">
                <button class="padbank_button" query="pad_page 1" action="pad_page 1" rightclick="pad_page_select 1" textaction="pad_page 1 &amp; param_uppercase">
                  <pos x="+0"/>
                </button>
                <button class="padbank_button" query="pad_page 2" action="pad_page 2" rightclick="pad_page_select 2" textaction="pad_page 2 &amp; param_uppercase">
                  <pos x="+5+85"/>
                </button>
                <button class="padbank_button" query="pad_page 3" action="pad_page 3" rightclick="pad_page_select 3" textaction="pad_page 3 &amp; param_uppercase">
                  <pos x="+5+85*2"/>
                </button>
                <button class="padbank_button" query="pad_page 4" action="pad_page 4" rightclick="pad_page_select 4" textaction="pad_page 4 &amp; param_uppercase">
                  <pos x="+5+85*3"/>
                </button>
              </panel>
            </group>
            <visual width="365" height="24" visibility="shift">
              <off shape="square" color="#44000000" border="dark_5" radius="5" border_size="1"/>
            </visual>
            <group x="+366">
              <visual width="365" height="24" visibility="shift">
                <off shape="square" color="dark_5" border="dark_7" radius="5" border_size="1"/>
              </visual>
              <group x="+3" y="+2">
                <panel group="pads16_[PANELNAME]" visible="yes" available="no" displayname="16 Pads">
                  <button class="padbank_button" query="pad_page 5" action="pad_page 5" rightclick="pad_page_select 5" textaction="pad_page 5 &amp; param_uppercase">
                    <pos x="+0"/>
                  </button>
                  <button class="padbank_button" query="pad_page 6" action="pad_page 6" rightclick="pad_page_select 6" textaction="pad_page 6 &amp; param_uppercase">
                    <pos x="+5+85"/>
                  </button>
                  <button class="padbank_button" query="pad_page 7" action="pad_page 7" rightclick="pad_page_select 7" textaction="pad_page 7 &amp; param_uppercase">
                    <pos x="+5+85*2"/>
                  </button>
                  <button class="padbank_button" query="pad_page 8" action="pad_page 8" rightclick="pad_page_select 8" textaction="pad_page 8 &amp; param_uppercase">
                    <pos x="+5+85*3"/>
                  </button>
                </panel>
              </group>
              <visual width="365" height="24" visibility="not shift">
                <off shape="square" color="#44000000" border="dark_5" radius="5" border_size="1"/>
              </visual>
            </group>
          </group>
          <group y="+29">
            <visual width="733" height="40*4+5+4" x="-1" y="-1">
              <off shape="square" color="dark_1" border="dark_4" radius="6" border_size="1"/>
            </visual>
            <group x="+2" y="+3">
              <panel class="padbutton3" x="+180*0+2" y="+40*0" source="1"/>
              <panel class="padbutton3" x="+180*1+2" y="+40*0" source="2"/>
              <panel class="padbutton3" x="+180*2+3" y="+40*0" source="3"/>
              <panel class="padbutton3" x="+180*3+4" y="+40*0" source="4"/>
              <panel class="padbutton3" x="+180*0+2" y="+40*1" source="5"/>
              <panel class="padbutton3" x="+180*1+2" y="+40*1" source="6"/>
              <panel class="padbutton3" x="+180*2+3" y="+40*1" source="7"/>
              <panel class="padbutton3" x="+180*3+4" y="+40*1" source="8"/>
              <panel class="padbutton3" x="+180*0+2" y="+40*2" source="9"/>
              <panel class="padbutton3" x="+180*1+2" y="+40*2" source="10"/>
              <panel class="padbutton3" x="+180*2+3" y="+40*2" source="11"/>
              <panel class="padbutton3" x="+180*3+4" y="+40*2" source="12"/>
              <panel class="padbutton3" x="+180*0+2" y="+40*3" source="13"/>
              <panel class="padbutton3" x="+180*1+2" y="+40*3" source="14"/>
              <panel class="padbutton3" x="+180*2+3" y="+40*3" source="15"/>
              <panel class="padbutton3" x="+180*3+4" y="+40*3" source="16"/>
            </group>
          </group>
          <!-- bottom row -->
          <group y="+40*4+30+10">
            <!-- menu -->
            <button action="pad_menu 1" query="auto_match_bpm ? auto_match_key" visibility="pad_has_menu 1" shape="circle">
              <size width="10" height="10"/>
              <pos x="+0" y="+5"/>
              <off shape="circle" color="#777777" border="#555555" border_size="1"/>
              <selected shape="circle" color="#00FF00" border="#222222" border_size="1"/>
              <over shape="circle" color="#00FF00" border="transparent" border_size="1"/>
              <down shape="circle" color="#AA44FF44" border="#8800FF00" border_size="1"/>
            </button>
            <group>
              <!-- MINI HOTCUES -->
              <define class="MINI_CUE_BUTTON_V2" placeholders="*index,*width=21,*height=18" visibility="has_cue [INDEX]">
                <button action="hot_cue [INDEX]" rightclick="goto_cue [INDEX]">
                  <pos x="+0" y="+0"/>
                  <size width="[WIDTH]" height="[HEIGHT]"/>
                  <off color="#00000000" border="dark_7" border_size="1" radius="3"/>
                  <over color="#00000000" border="dark_8" border_size="1" radius="5"/>
                  <text dy="-1" dx="-1" fontsize="11" coloroff="black" coloron="white" weight="normal" align="center" text="[INDEX]"/>
                </button>
                <visual type="color" source="cue_color [INDEX]" visibility="has_cue [INDEX]">
                  <pos x="+1" y="+[HEIGHT]-3"/>
                  <size width="[WIDTH]-2" height="3"/>
                </visual>
              </define>
              <define class="MINI_CUE_BUTTON_V1" placeholders="*index,*width=22,*height=18">
                <visual type="color" source="cue_color [INDEX]" visibility="has_cue [INDEX]">
                  <pos x="+1" y="+1"/>
                  <size width="20" height="[HEIGHT]-2"/>
                </visual>
                <button action="hot_cue [INDEX]" rightclick="goto_cue [INDEX]">
                  <pos x="+0" y="+0"/>
                  <size width="[WIDTH]" height="[HEIGHT]"/>
                  <off color="#00000000" border="dark_3" border_size="1" radius="2"/>
                  <over color="#22000000" border="dark_0" border_size="1" radius="3"/>
                  <text dy="-0" dx="+0" fontsize="10" coloroff="black" coloron="white" weight="bold" align="center" text=""/>
                </button>
              </define>
              <group visibility="true">
                <visual>
                  <pos x="+0" y="+0"/>
                  <size width="21*4+4+4+3" height="26"/>
                  <off shape="square" color="dark_0" border="dark_6" border_size="1" radius="5"/>
                </visual>
                <group x="+4" y="+4">
                  <panel class="mini_cue_button_v2" index="1" x="+0" y="+0"/>
                  <panel class="mini_cue_button_v2" index="2" x="+22" y="+0"/>
                  <panel class="mini_cue_button_v2" index="3" x="+44" y="+0"/>
                  <panel class="mini_cue_button_v2" index="4" x="+66" y="+0"/>
                </group>
              </group>
              <group x="+100">
                <visual>
                  <pos x="+0" y="+0"/>
                  <size width="21*4+4+4+3" height="26"/>
                  <off shape="square" color="dark_0" border="dark_7" border_size="1" radius="5"/>
                </visual>
                <group x="+4" y="+4">
                  <panel class="mini_cue_button_v2" index="5" x="+0" y="+0"/>
                  <panel class="mini_cue_button_v2" index="6" x="+22" y="+0"/>
                  <panel class="mini_cue_button_v2" index="7" x="+44" y="+0"/>
                  <panel class="mini_cue_button_v2" index="8" x="+66" y="+0"/>
                </group>
              </group>
              <group x="+200">
                <visual>
                  <pos x="+0" y="+0"/>
                  <size width="21*4+4+4+3" height="26"/>
                  <off shape="square" color="dark_0" border="dark_7" border_size="1" radius="5"/>
                </visual>
                <group x="+4" y="+4">
                  <panel class="mini_cue_button_v2" index="9" x="+0" y="+0"/>
                  <panel class="mini_cue_button_v2" index="10" x="+22" y="+0"/>
                  <panel class="mini_cue_button_v2" index="11" x="+44" y="+0"/>
                  <panel class="mini_cue_button_v2" index="12" x="+66" y="+0"/>
                </group>
              </group>
              <group x="+300">
                <visual>
                  <pos x="+0" y="+0"/>
                  <size width="21*4+4+4+3" height="26"/>
                  <off shape="square" color="dark_0" border="dark_7" border_size="1" radius="5"/>
                </visual>
                <group x="+4" y="+4">
                  <panel class="mini_cue_button_v2" index="13" x="+0" y="+0"/>
                  <panel class="mini_cue_button_v2" index="14" x="+22" y="+0"/>
                  <panel class="mini_cue_button_v2" index="15" x="+44" y="+0"/>
                  <panel class="mini_cue_button_v2" index="16" x="+66" y="+0"/>
                </group>
              </group>
            </group>
            <group x="+730-26-80-26-26-80-27">
              <!-- PARAM 1 -->
              <group name="pad_param1" visibility="pad_param_visible 1">
                <button class="button_main" x="+0" width="26" height="26" action="pad_param -1" iconsize="20" sysicon="arrowleft" coloroff="transparent" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <button class="button_main" x="+26" width="80" height="26" action="pad_param +1" query="off" textaction="pad_param" coloroff="transparent" coloron="xf_background" bordersize="1" textsize="12" textcolor="white"/>
                <button class="button_main" x="+26+80" width="26" height="26" action="pad_param +1" iconsize="20" sysicon="arrowright" coloroff="transparent" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <visual>
                  <size width="26+80+26" height="24"/>
                  <off shape="square" color="transparent" border="dark_6" border_size="1" radius="6"/>
                </visual>
              </group>
              <!-- PARAM 2 -->
              <group x="+26+80+26+2" name="pad_param1" visibility="pad_param_visible 2">
                <button class="button_main" x="+0" width="26" height="26" action="pad_param2 -1" iconsize="20" sysicon="arrowleft" coloroff="black" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <button class="button_main" x="+26" width="80" height="26" action="pad_param2 +1" query="off" textaction="pad_param2" coloroff="black" coloron="xf_background" bordersize="0" textsize="12" textcolor="white"/>
                <button class="button_main" x="+26+80" width="26" height="26" action="pad_param2 +1" iconsize="20" sysicon="arrowright" coloroff="black" coloron="xf_background" bordersize="0" textcolor="textdarker"/>
                <visual>
                  <size width="26+80+26" height="24"/>
                  <off shape="square" color="transparent" border="dark_6" border_size="1" radius="6"/>
                </visual>
              </group>
            </group>
          </group>
        </panel>
      </group>
    </deck>
  </define>
</defs>
