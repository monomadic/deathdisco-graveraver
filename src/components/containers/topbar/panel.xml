<?xml version="1.0" encoding="UTF-8"?>
<module xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- ALL: TOP BAR
      height: 43px
    -->
  <!-- background -->
  <visual class="gfx_shape" width="1920-2-2" height="45" coloroff="dark_1"/>
  <!-- DECK LAYOUT BUTTONS -->
  <group x="70" y="0">
    <button tooltip="Pro" class="button_main" action="set '@$skin_mode' 0 &amp; load_skin" width="60" height="45" bordersize="0" query="var_equal '@$skin_mode' 0">
      <off color="transparent"/>
      <on color="#222222"/>
      <over color="transparent"/>
      <down color="#222222"/>
      <selected color="#333333"/>
      <text overcolor="white" size="12" oncolor="white" text="PRO"/>
    </button>
    <button x="+60" tooltip="Performance" class="button_main" action="set '@$skin_mode' 1 &amp; load_skin" width="60" height="45" bordersize="0" query="var_equal '@$skin_mode' 1">
      <off color="transparent"/>
      <on color="#222222"/>
      <over color="transparent"/>
      <down color="#222222"/>
      <selected color="#333333"/>
      <text overcolor="white" size="12" oncolor="white" text="PERF"/>
    </button>
    <button x="+120" tooltip="Stack" class="button_main" action="set '@$skin_mode' 2 &amp; load_skin" width="60" height="45" bordersize="0" query="var_equal '@$skin_mode' 2">
      <off color="transparent"/>
      <on color="#222222"/>
      <over color="transparent"/>
      <down color="#222222"/>
      <selected color="#333333"/>
      <text overcolor="white" size="12" oncolor="white" text="STACK"/>
    </button>
  </group>
  <!-- NUMBER OF DECKS -->
  <group x="340" y="2">
    <!-- border -->
    <visual x="+0" y="+7" width="65" height="30">
      <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
    </visual>
    <!-- blackout -->
    <visual x="+16" y="+0" width="32" height="13" visibility="1.0">
      <off shape="square" color="black"/>
    </visual>
    <!-- 2 DECK BUTTON -->
    <button x="+3" y="+8" width="30" height="28" tooltip="2 Decks (4 Swap)" class="button_main" action="set '@$layout_4deck' 0 &amp; set '@$4decks' 1 &amp; load_skin" bordersize="0" query="var_equal '@$layout_4deck' 0 ? var_equal '@$4decks' 1">
      <off color="transparent"/>
      <text overcolor="#999999" fontsize="14" weight="bold" oncolor="white" text="2"/>
    </button>
    <!-- 4 DECK BUTTON -->
    <button x="+32" y="+8" width="30" height="28" tooltip="4 Decks" class="button_main" action="set '@$layout_4deck' 1 &amp; set '@$4decks' 1 &amp; load_skin" bordersize="0">
      <off color="transparent"/>
      <text overcolor="#999999" fontsize="14" weight="bold" oncolor="white" text="4"/>
    </button>
    <!-- label -->
    <textzone>
      <pos x="+0" y="+0"/>
      <size width="65" height="14"/>
      <text fontsize="9" weight="normal" color="#999999" align="center" text="DECKS" important="true"/>
    </textzone>
  </group>
  <group visibility="browser_zoom" x="680" y="8">
    <button tooltip="SHOW WAVEFORMS\nShow or hide waveforms in browser zoom mode." class="button_main" x="+90" action="toggle '@$hide_zoom_waveforms' &amp; load_skin" width="80" height="27" textsize="12" textcoloron="needle" text="WAVES" coloroff="panel_background" coloron="#222222" bordersize="0" query="var_equal '@$hide_zoom_waveforms' '1'"/>
  </group>
  <!-- XL CUSTOM BUTTON -->
  <button class="custom_button" source="100" x="+960-64" y="+8" width="130" height="26" coloroff="black">
    <off color="black" border="#888888"/>
    <on color="#000000"/>
    <over color="#000000" border="white"/>
    <down color="#000000" border="#888888"/>
    <selected color="#000000"/>
    <text overcolor="white" size="14" oncolor="white" align="center"/>
  </button>
  <!-- SETTINGS -->
  <group x="1070" y="+5">
    <!-- PHRASE LEN -->
    <group x="+20" y="+0">
      <textzone>
        <pos x="+5" y="+0"/>
        <size width="70" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="left" text="PHRASE" important="true"/>
      </textzone>
      <button class="button_main" x="+0" y="+0+14" width="70" height="20" action="var_equal '$phrase_len' 16 ? set '$phrase_len' 32 : set '$phrase_len' 16" textsize="10" textaction="var_equal '$phrase_len' 16 ? get_text '16 BARS' : get_text '32 BARS'" coloroff="#111111" coloron="#111111" bordersize="1" textcolor="#999999" textcoloron="white" brcoloroff="#999999" brcoloron="#999999" query="setting 'globalQuantize' 1 ? off : setting 'globalQuantize' 0.125 ? on : setting 'globalQuantize' 0.25 ? on : setting 'globalQuantize' 0.5 ? on : setting 'globalQuantize' 2 ? on : setting 'globalQuantize' 4 ? on : setting 'globalQuantize' 16 ? on : setting 'globalQuantize' 32"/>
    </group>
    <!-- GLOBAL QUANT -->
    <group x="+90" y="+0">
      <textzone>
        <pos x="+5" y="+0"/>
        <size width="70" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="left" text="SNAP" important="true"/>
      </textzone>
      <button class="button_main" x="+0" y="+0+14" width="70" height="20" action="setting 'globalQuantize' 1 ? setting 'globalQuantize' 4 : setting 'globalQuantize' 4 ? setting 'globalQuantize' 16 : setting 'globalQuantize' 16 ? setting 'globalQuantize' 32 : setting 'globalQuantize' 1" textsize="10" textaction="setting 'globalQuantize' 0.125 ? get_text '1/8' : setting 'globalQuantize' 0.25 ? get_text '1/4' : setting 'globalQuantize' 0.5 ? get_text '1/2' : setting 'globalQuantize' 1 ? get_text 'BEAT' : setting 'globalQuantize' 2 ? get_text '2' : setting 'globalQuantize' 4 ? get_text 'BAR' : setting 'globalQuantize' 16 ? get_text 'PHRASE 16' : setting 'globalQuantize' 32 ? get_text 'PHRASE 32' : get_text 'BEAT'" coloroff="#111111" coloron="#111111" bordersize="1" textcolor="#999999" textcoloron="white" brcoloroff="#999999" brcoloron="#999999" query="setting 'globalQuantize' 1 ? off : setting 'globalQuantize' 0.125 ? on : setting 'globalQuantize' 0.25 ? on : setting 'globalQuantize' 0.5 ? on : setting 'globalQuantize' 2 ? on : setting 'globalQuantize' 4 ? on : setting 'globalQuantize' 16 ? on : setting 'globalQuantize' 32"/>
    </group>
    <!-- CUE MODE -->
    <group x="+160" y="+0">
      <textzone>
        <pos x="+5" y="+0"/>
        <size width="70" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="left" text="CUE MODE" important="true"/>
      </textzone>
      <button class="button_main" x="+0" y="+0+14" width="70" height="20" action="setting 'hotcueMode'" textsize="10" textaction="setting 'hotCueMode' &amp; param_uppercase" coloroff="#111111" coloron="#111111" bordersize="1" textcolor="#FFFFFF" textcoloron="white" brcoloroff="#999999" brcoloron="#999999" query="slip_mode ? blink 800ms : off"/>
    </group>
    <!-- SYNC BUTTONS -->
    <group x="+250" y="+0">
      <textzone>
        <size width="26+26+26" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="center" text="GLOBAL SYNC" important="true"/>
      </textzone>
      <group y="+14">
        <!-- MASTER TEMPO BUTTON -->
        <button class="button_main" x="+0" y="+0" width="25" height="15" tooltip="Master Tempo" action="master_tempo" textsize="10" text="MT" coloron="#2D003D" textcoloron="#A800FF" bordersize="1" brcoloron="#A800FF"/>
        <!-- MASTERDECK AUTO BUTTON -->
        <button class="button_main" x="+26" y="+0" width="25" height="15" tooltip="Masterdeck Auto" action="masterdeck_auto" textsize="10" text="M" textcoloron="orange" bordersize="1" brcoloron="orange" coloron="#222200"/>
        <!-- GLOBAL QUANTIZE BUTTON -->
        <button class="button_main" x="+52" y="+0" width="25" height="15" tooltip="Quantize All" action="deck 1 quantize_all &amp; deck 2 quantize_all &amp; deck 3 quantize_all &amp; deck 4 quantize_all" textsize="10" text="Q" textcoloron="#88FF88" bordersize="1" brcoloron="#88FF88" coloron="#002200"/>
      </group>
    </group>
  </group>
  <group x="850" y="8">
    <!-- REFRESH BUTTON -->
    <button tooltip="RELOAD SKIN" action="load_skin">
      <size width="42" height="27"/>
      <off color="transparent"/>
      <icon sysicon="sampler_loop" width="22" height="22" coloroff="#CCCCCC" colorover="#FFFFFF"/>
    </button>
    <!-- SETTINGS BUTTON -->
    <button action="reinit_controller" x="+180">
      <size width="42" height="27"/>
      <off color="transparent"/>
      <icon sysicon="sampler_loop" width="25" height="25" coloroff="#CCCCCC" colorover="#FFFFFF"/>
    </button>
  </group>
  <!-- Accent top line -->
  <line x="0" y="0" width="1920" height="1" highlight="dark_8" shadow="#00000000"/>
  <!-- SETTINGS MENU BUTTON -->
  <group name="applicationbuttons_logo" condition="is_mac">
    <logo>
      <pos x="+1920" y="-40"/>
      <size width="115" height="30"/>
    </logo>
    <menu tooltip="DIRECT OPTIONS">
      <pos x="+10" y="8"/>
      <size width="40" height="30"/>
      <off color="transparent" shape="square"/>
      <over color="transparent" shape="square"/>
      <selected color="button_background" shape="square"/>
      <text dx="+2" dy="+8" fontsize="25" text="iii" color="textoff" colorselected="needle" colorover="needle" orientation="vertical-cw"/>
      <item text="Keyboard Mode [CMD+B]" localize="true" action="toggle '@$dd_bordermode'" check="var_equal '@$dd_bordermode' 1"/>
      <separator/>
      <xi:include href="menu-items.xml" xpointer="xpointer(/menuitems/*)"/>
    </menu>
    <group visibility="false">
      <button action="close">
        <pos x="15" y="+13"/>
        <size width="17" height="17"/>
        <off shape="circle" color="#bf4744"/>
        <down shape="circle" color="#fc5753"/>
        <selected shape="circle" color="#fc5753"/>
      </button>
      <button action="minimize">
        <pos x="15+27" y="+13"/>
        <size width="17" height="17"/>
        <off shape="circle" color="#be8d2f"/>
        <down shape="circle" color="#fdbc40"/>
        <selected shape="circle" color="#fdbc40"/>
      </button>
      <button action="maximize">
        <pos x="15+27+27" y="+13"/>
        <size width="17" height="17"/>
        <off shape="circle" color="#279637"/>
        <down shape="circle" color="#33c748"/>
        <selected shape="circle" color="#33c748"/>
      </button>
    </group>
  </group>
  <!-- vr -->
  <line color="dark_5" x="58" y="1" width="1" height="39"/>
  <group x="250" y="+1">
    <button tooltip="BROWSER ZOOM\nToggle browser zoom mode." class="button_main" x="+0" action="browser_zoom" width="80" height="42" textsize="12" textcoloron="needle" text="BROWSER" coloroff="transparent" coloron="#222222" bordersize="0"/>
  </group>
  <group visibility="browser_zoom" x="680" y="8">
    <button tooltip="SHOW WAVEFORMS\nShow or hide waveforms in browser zoom mode." class="button_main" x="+90" action="toggle '@$hide_zoom_waveforms' &amp; load_skin" width="80" height="27" textsize="12" textcoloron="needle" text="WAVES" coloroff="panel_background" coloron="#222222" bordersize="0" query="var_equal '@$hide_zoom_waveforms' '1'"/>
  </group>
  <!-- XL CUSTOM BUTTON -->
  <button class="custom_button" source="100" x="+960-64" y="+8" width="130" height="30" coloroff="black">
    <off color="black" border="#888888"/>
    <on color="#000000"/>
    <over color="#000000" border="white"/>
    <down color="#000000" border="#888888"/>
    <selected color="#000000"/>
    <text overcolor="white" size="14" oncolor="white" align="center"/>
  </button>
  <!-- PRO: TOP BAR UTILITIES (right) -->
  <group name="pro_skin_utility" visibility="var_equal '@$skin_mode' 0">
    <!-- sandbox button -->
    <group name="sandbox area" x="115+80+900" y="8" visibility="can_sandbox ? false">
      <button class="button_main" width="75" height="27" action="sandbox" coloroff="panel_background" textsize="10" textcoloron="texton" text="SANDBOX" coloron="orange" bordersize="0" query="sandbox ? blink 300ms" visibility="sandbox on ? false : true"/>
      <button class="button_main" width="75" height="27" action="sandbox" coloroff="panel_background" textsize="10" textcoloron="texton" text="SANDBOX" coloron="orange" bordersize="0" query="sandbox ? blink 300ms" visibility="sandbox off ? false : true"/>
      <visual x="115+100+960-1" y="8" width="160" height="27" visibility="sandbox off ? false : true">
        <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
      </visual>
      <!-- sandbox button + wavepos: on state -->
      <songpos class="songpos" deck="sandbox">
        <pos x="118+100+960" y="13"/>
        <size width="150" height="16"/>
      </songpos>
      <visual x="115+100+960-1" y="8" width="160" height="27" visibility="sandbox off ? false : true">
        <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
      </visual>
      <songpos class="songpos" deck="sandbox">
        <pos x="118+100+960" y="13"/>
        <size width="150" height="16"/>
      </songpos>
    </group>
    <!-- ? phrase circles in 4 deck swap ? -->
    <group name="barsleft" x="+660" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? not deck 3 leftdeck">
      <deck deck="1">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsleft" x="+660" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? deck 3 leftdeck">
      <deck deck="3">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsright" x="+660+530" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? not deck 4 rightdeck">
      <deck deck="2">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsright" x="+660+530" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? deck 4 rightdeck">
      <!-- BEAT KEEPER -->
      <group x="+1090" y="+8">
        <visual class="gfx_shape" width="10*4" height="27" coloroff="transparent"/>
        <group>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+0" deck="3"/>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+7" deck="1"/>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+14" deck="2"/>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+21" deck="4"/>
        </group>
      </group>
      <deck deck="4">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsleft4" x="+660-30" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 1">
      <deck deck="1">
        <button class="button_main" x="+0" y="+0" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+0" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+0" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+0" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
      <deck deck="3">
        <button class="button_main" x="+0" y="+15" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+15" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+15" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+15" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsright4" x="+660+530+30" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 1">
      <deck deck="2">
        <button class="button_main" x="+0" y="+0" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+0" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+0" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+0" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
      <deck deck="4">
        <button class="button_main" x="+0" y="+15" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+15" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+15" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+15" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
  </group>
  <!-- PERFORMANCE: TOP BAR -->
  <group name="performance_skin_utility" visibility="var_equal '@$skin_mode' 1">
    <!-- LAYOUT SELECTOR -->
    <group x="410" y="2">
      <!-- border -->
      <visual x="+0" y="+8" width="90" height="28">
        <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
      </visual>
      <!-- blackout -->
      <visual x="+30">
        <size width="28" height="16"/>
        <off shape="square" color="black"/>
      </visual>
      <!-- label -->
      <textzone x="+0">
        <size width="90" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="center" text="LAYOUT" important="true"/>
      </textzone>
      <!-- layout buttons (cycle) -->
      <group x="+0" y="+11">
        <button class="button_main" width="90" height="22" color="transparent" coloroff="transparent" bordersize="0" align="center" radius="10" action="cycle '@$performance_layout' 3 &amp; load_skin">
          <text overcolor="#FFFFFF" color="#999999" weight="normal" align="center" size="14" oncolor="white" action="(get_var '@$performance_layout' &amp; param_equal 2) ? get_text 'HORIZONTAL'              : (get_var '@$performance_layout' &amp; param_equal 0) ? get_text 'EXTENDED'              : get_text 'VERTICAL'"/>
        </button>
      </group>
    </group>
    <menu tooltip="MIXER OPTIONS" visibility="var_equal '@$skin_mode' 1 ? var_equal '@$performance_layout' 0 ? constant 1.0">
      <pos x="700" y="5"/>
      <size width="36" height="36"/>
      <off shape="square" color="black" border="transparent"/>
      <icon sysicon="settings" height="20" width="20" color="dark_8" colorover="white" colordown="needle"/>
      <submenu text="Left Panel (Mixer)" localize="true">
        <item text="Microphone" action="set '@$show_left_mixer_rack' 0" check="var_equal '@$show_left_mixer_rack' 0"/>
        <item text="Headphones" action="set '@$show_left_mixer_rack' 1" check="var_equal '@$show_left_mixer_rack' 1"/>
      </submenu>
      <separator/>
      <submenu text="Right Panel (Mixer)" localize="true">
        <item text="Master" action="set '@$show_right_mixer_rack' 0" check="var_equal '@$show_right_mixer_rack' 0"/>
        <item text="Rec/Broadcast" action="set '@$show_right_mixer_rack' 1" check="var_equal '@$show_right_mixer_rack' 1"/>
      </submenu>
      <separator/>
      <submenu text="Center Panel (FX)" localize="true">
        <item text="Master FX" action="set '@$show_center_fx_rack' 0" check="var_equal '@$show_center_fx_rack' 0"/>
        <item text="Mic FX" action="set '@$show_center_fx_rack' 1" check="var_equal '@$show_center_fx_rack' 1"/>
      </submenu>
      <separator/>
      <submenu text="EQ Frequency Spread" localize="true">
        <item text="Default" action="setting 'equalizerFrequencySpread' 'default'" check="setting 'equalizerFrequencySpread' 'default'"/>
        <item text="Full Kill" action="setting 'equalizerFrequencySpread' 'full kill'" check="setting 'equalizerFrequencySpread' 'full kill'"/>
      </submenu>
      <submenu text="Vu Meter" localize="true">
        <item text="Peak Mode" action="setting 'vuMeter' 'peak'" check="setting 'vuMeter' 'peak'"/>
