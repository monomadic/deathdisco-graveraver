<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Shared building blocks for the WAVEFORM assembly in main-waveform.xml. -->
  <!-- 4-deck beats rhythmzone with its bar counters; mirror is the only variant. -->
  <define class="MAIN_WAVE_RHYTHM_4DECK" placeholders="*mirror,*waveformheight">
    <rhythmzone mirror="[MIRROR]" upsidedown="false" fade="200">
      <pos x="+2" y="+0"/>
      <size width="1920-8" height="[WAVEFORMHEIGHT]"/>
      <colors deck1="waveform_passive1" deck1_active="waveform_active1" deck1_left="0" deck2="waveform_passive2" deck2_active="waveform_active2" deck2_right="0" deck3="waveform_passive3" deck3_active="waveform_active3" deck3_left="0" deck4="waveform_passive4" deck4_active="waveform_active4" deck4_right="0"/>
      <rhythm y="+0" height="[WAVEFORMHEIGHT]-20-16"/>
      <grid height="6" width="5" mainwidth="10">
        <pos y1="+[WAVEFORMHEIGHT]-6-12-16" y2="+[WAVEFORMHEIGHT]-6-12+8-16" y3="+[WAVEFORMHEIGHT]-6-12+8+8-16" y4="+[WAVEFORMHEIGHT]-6-12+8+8+8-16"/>
      </grid>
      <gridlines width="1" color="gridlines" transparency="0.6"/>
      <cue dy="+0" height="[WAVEFORMHEIGHT]">
        <mask x="0" y="0" width="11" height="12"/>
        <text dx="+16" dy="-2" weight="bold" fontsize="15" color="deckcolor" important="true"/>
      </cue>
      <overlay>
        <pos x="960" y="+0"/>
        <size width="2" height="[WAVEFORMHEIGHT]"/>
        <background color="needle" shape="square"/>
      </overlay>
    </rhythmzone>
    <panel class="beat_counter" deck="1" x="960-2-120-40" y="+12" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'centered'"/>
    <panel class="beat_counter" deck="1" x="960-2-598-40" y="+12" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'left'"/>
    <panel class="beat_counter" deck="2" x="960-2-120-40" y="+[WAVEFORMHEIGHT]/4-24-2+12+3+24" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'centered'"/>
    <panel class="beat_counter" deck="2" x="960-2-598-40" y="+[WAVEFORMHEIGHT]/4-24-2+12+3+24" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'left'"/>
    <panel class="beat_counter" deck="3" x="960-2-120-40" y="+77+2+[WAVEFORMHEIGHT]/2-24-2" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'centered'"/>
    <panel class="beat_counter" deck="3" x="960-2-598-40" y="+77+2+[WAVEFORMHEIGHT]/2-24-2" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'left'"/>
    <panel class="beat_counter" deck="4" x="960-2-120-40" y="+[WAVEFORMHEIGHT]/2+18+[WAVEFORMHEIGHT]/2+2" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'centered'"/>
    <panel class="beat_counter" deck="4" x="960-2-598-40" y="+[WAVEFORMHEIGHT]/2+18+[WAVEFORMHEIGHT]/2+2" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'left'"/>
  </define>
  <!-- Left/right bar counter row shared by the split waveform panes. -->
  <define class="SPLIT_WAVE_BEAT_COUNTERS">
    <panel class="beat_counter" deck="left" x="954/2-2-120-40" y="+12" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'centered'"/>
    <panel class="beat_counter" deck="right" x="1436-2-120-40" y="+12" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'centered'"/>
    <panel class="beat_counter" deck="left" x="954/2-2-338-40" y="+12" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'left'"/>
    <panel class="beat_counter" deck="right" x="1436-338-40" y="+12" visibility="var_equal '@$show_bar_counter' 1 ? setting 'waveformCenter' 'left'"/>
  </define>
  <!-- One split-wave scratch deck: the background-off and background-on variants
       differ only by the grid background attributes, so both live here and the
       caller passes the two full visibility expressions. Grid geometry defaults
       to wave_grid_mode 0; grid_2 callers override gridmainsize/gridheight/gridpos. -->
  <define class="SPLIT_SCRATCHWAVE" placeholders="*deck,*x,*y,*w,*h,*visoff,*vison,*overlayheight,*waveformheight,gridmainsize=5,gridheight=6,gridpos=-10,overlayx=+957/2-4">
    <scratchwave deck="[DECK]" orientation="horizontal" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="[VISOFF]">
      <pos x="[X]" y="[Y]"/>
      <size width="[W]" height="[H]"/>
      <grid size="1" mainsize="[GRIDMAINSIZE]" height="[GRIDHEIGHT]" pos="[GRIDPOS]" maincolor="deckcolor" color="darkgray" mirrored="true" shapepos="[GRIDPOS]" shapemirrored="down"/>
      <gridlines width="1" color="gridlines" transparency="0.6"/>
      <cue y="[GRIDPOS]" height="[WAVEFORMHEIGHT]">
        <mask x="0" y="0" width="11" height="15"/>
        <text dx="+16" dy="-2" weight="bold" fontsize="15" color="deckcolor" important="true"/>
      </cue>
      <overlay>
        <pos x="[OVERLAYX]" y="[GRIDPOS]"/>
        <size width="2" height="[OVERLAYHEIGHT]"/>
        <background color="needle" shape="square"/>
      </overlay>
    </scratchwave>
    <scratchwave deck="[DECK]" orientation="horizontal" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="[VISON]">
      <pos x="[X]" y="[Y]"/>
      <size width="[W]" height="[H]"/>
      <grid size="1" mainsize="[GRIDMAINSIZE]" height="[GRIDHEIGHT]" pos="[GRIDPOS]" background="yes" backgroundcolor="wavesbackgroundcolor" backgroundshaded="no" maincolor="deckcolor" color="darkgray" mirrored="true" shapepos="[GRIDPOS]" shapemirrored="down"/>
      <gridlines width="1" color="gridlines" transparency="0.6"/>
      <cue y="[GRIDPOS]" height="[WAVEFORMHEIGHT]">
        <mask x="0" y="0" width="11" height="15"/>
        <text dx="+16" dy="-2" weight="bold" fontsize="15" color="deckcolor" important="true"/>
      </cue>
      <overlay>
        <pos x="[OVERLAYX]" y="[GRIDPOS]"/>
        <size width="2" height="[OVERLAYHEIGHT]"/>
        <background color="needle" shape="square"/>
      </overlay>
    </scratchwave>
  </define>
</defs>
