<?xml version="1.0" encoding="UTF-8"?>
<defs>
    <define class="BEAT_KEEPER_EX" placeholders="deck,bgcolor=transparent,width=10">
      <deck deck="[DECK]">
        <visual class="gfx_shape" width="[WIDTH]*4" height="27" coloroff="red"/>
        <group name="phrase_bars">
          <button class="button_main" x="+0" y="+0" width="[WIDTH]" height="6" shape="square" query="get_phrase_num 1" coloroff="[BGCOLOR]" brcoloron="infos_background" brcoloroff="infos_background" bordersize="0"/>
          <button class="button_main" x="+15" y="+0" width="[WIDTH]" height="6" shape="square" query="get_phrase_num 2" coloroff="[BGCOLOR]" brcoloron="infos_background" brcoloroff="infos_background" bordersize="0"/>
          <button class="button_main" x="+30" y="+0" width="[WIDTH]" height="6" shape="square" query="get_phrase_num 3" coloroff="[BGCOLOR]" brcoloron="infos_background" brcoloroff="infos_background" bordersize="0"/>
          <button class="button_main" x="+45" y="+0" width="[WIDTH]" height="6" shape="square" query="get_phrase_num 4" coloroff="[BGCOLOR]" brcoloron="infos_background" brcoloroff="infos_background" bordersize="0"/>
        </group>
      </deck>
    </define>
    <define class="BEAT_COUNTER" placeholders="deck">
      <deck deck="[DECK]">
      </deck>
    </define>
</defs>
