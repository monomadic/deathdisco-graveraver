<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="DECK_SPINE" placeholders="*deck,*panelname,*width=34,*height=465,*radius=3,color=deckcolor,*label=DECK">
    <deck deck="[DECK]">
      <!-- background -->
      <visual width="[WIDTH]" height="[HEIGHT]">
        <off shape="square" color="black" radius="[RADIUS]"/>
      </visual>
      <!-- transparent full-spine hit area for right-click deck options -->
      <button action="select" rightclick="select &amp; deck_options" query="select">
        <size width="[WIDTH]" height="[HEIGHT]"/>
      </button>
      <!-- deck number circle -->
      <group>
        <button class="deck_button" color="[COLOR]">
          <pos x="+5" y="+10"/>
          <text dx="+0"/>
        </button>
        <textzone orientation="vertical" direction="ccw">
          <pos x="+0" y="+0"/>
          <size width="[WIDTH]" height="100"/>
          <text fontsize="12" color="[COLOR]" scroll="no" align="right" text="[LABEL]" important="true"/>
        </textzone>
      </group>
      <!-- settings menu -->
      <group y="+[HEIGHT]-[WIDTH]">
        <visual x="+[WIDTH]/2-11" y="+[WIDTH]/2-11">
          <size width="22" height="22"/>
          <off shape="circle" color="transparent" border="dark_6" border_size="2"/>
          <icon sysicon="settings" coloroff="dark_7" colorover="white" colordown="dark_6" colorselected="dark_5" width="18" height="18"/>
        </visual>
      </group>
      <menu class="menu_maindecks" x="+0" y="+[HEIGHT]-[WIDTH]" width="[WIDTH]" height="[WIDTH]"/>
      <!-- master deck label -->
      <group visibility="masterdeck">
      </group>
    </deck>
  </define>
  <define class="DECK_SPINE_PAIR" placeholders="*deck,*panelname,*height=465,*mirror=false,*x=0">
    <panel class="deck_spine" x="[X]" deck="[DECK]" panelname="[PANELNAME]" mirror="[MIRROR]" height="[HEIGHT]" label="MASTER" color="color_masterdeck" visibility="masterdeck"/>
    <panel class="deck_spine" x="[X]" deck="[DECK]" panelname="[PANELNAME]" mirror="[MIRROR]" height="[HEIGHT]" label="  DECK [DECK]" color="deckcolor" visibility="not masterdeck"/>
  </define>
</defs>
