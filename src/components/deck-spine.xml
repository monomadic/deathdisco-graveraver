<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="DECK_SPINE" placeholders="*deck,*panelname,width=34,height=465,radius=3,color=deckcolor">
    <!-- background -->
    <visual width="[WIDTH]" height="[HEIGHT]">
      <off shape="square" color="black" radius="[RADIUS]"/>
    </visual>
    <!-- transparent full-spine hit area for right-click deck options -->
    <button action="select" rightclick="select &amp; deck_options" query="select">
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </button>
    <!-- deck number circle -->
    <group x="+5" y="+10">
      <group visibility="masterdeck">
        <button class="deck_button" visibility="masterdeck" color="color_masterdeck">
          <pos x="+0" y="+0"/>
          <text dx="+0"/>
        </button>
      </group>
      <group visibility="not masterdeck">
        <button class="deck_button" visibility="not masterdeck" color="[COLOR]">
          <pos x="+0" y="+0"/>
          <text dx="+0"/>
        </button>
      </group>
    </group>
    <!-- settings menu -->
    <menu class="menu_maindecks" query="select" x="+0" y="+[HEIGHT]-[WIDTH]" width="[WIDTH]" height="[WIDTH]"/>
    <!-- master deck label -->
    <group visibility="masterdeck">
      <textzone orientation="vertical" direction="ccw">
        <pos x="+0" y="+35"/>
        <size width="34" height="105"/>
        <text fontsize="12" color="color_masterdeck" scroll="no" align="center" text="MASTER DECK" important="true"/>
      </textzone>
    </group>
  </define>
</defs>
