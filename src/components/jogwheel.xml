<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="GREEN_LIGHT_INDICATOR" placeholders="*action,*query">
    <visual>
      <size width="20" height="20"/>
      <off shape="circle" color="#333333" border="#222222" border_size="1"/>
    </visual>
    <button shape="circle" action="[ACTION]" query="[QUERY]">
      <size width="10" height="10"/>
      <pos x="+5" y="+5"/>
      <off shape="circle" color="#AAAAAA" border="#000000" border_size="1"/>
      <selected shape="circle" color="#00FF00" border="#222222" border_size="1"/>
      <over shape="circle" color="#DDDDDD" border="#000000" border_size="0"/>
      <down shape="circle" color="#00FF00" border="#88FFFF00" border_size="0"/>
    </button>
  </define>
  <define class="JOGWHEEL_CORNER_BUTTONS" placeholders="*jogsize=155">
    <panel class="green_light_indicator" x="+[JOGSIZE]-20" y="+[JOGSIZE]-20" action="auto_sync_options" query="auto_match_bpm ? auto_match_key ? auto_sync ? auto_pitch_lock"/>
    <!-- settings menu -->
    <group x="+0" y="+0">
      <visual>
        <size width="20" height="20"/>
        <off shape="circle" color="transparent" border="dark_6" border_size="2"/>
      </visual>
      <!-- PRO: JOGWHEEL MENU -->
      <menu>
        <pos x="+0" y="+0"/>
        <size width="20" height="20"/>
        <icon sysicon="settings" height="18" width="18" color="#AAAAAA" colorover="white" colordown="needle"/>
        <item text="Minimal" localize="true" action="set '@$jog_type' 0" check="var_equal '@$jog_type' 0"/>
        <item text="Text" localize="true" action="set '@$jog_type' 1" check="var_equal '@$jog_type' 1"/>
        <item text="Sync Status" localize="true" action="set '@$jog_type' 2" check="var_equal '@$jog_type' 2"/>
        <item text="Cover Art" localize="true" action="set '@$jog_type' 3" check="var_equal '@$jog_type' 3"/>
        <separator localize="true"/>
        <submenu text="Text" localize="true">
          <item text="Key" localize="true" action="set '@$jog_display_mode' 0" check="var_equal '@$jog_display_mode' 0"/>
          <item text="Loop Size" localize="true" action="set '@$jog_display_mode' 1" check="var_equal '@$jog_display_mode' 1"/>
          <item text="Elapsed" localize="true" action="set '@$jog_display_mode' 2" check="var_equal '@$jog_display_mode' 2"/>
          <item text="Remain" localize="true" action="set '@$jog_display_mode' 3" check="var_equal '@$jog_display_mode' 3"/>
        </submenu>
        <submenu text="RPM" localize="true">
          <item text="25" localize="true" action="setting 'RPM' 25" check="setting 'RPM' 25"/>
          <item text="33" localize="true" action="setting 'RPM' 33" check="setting 'RPM' 33"/>
          <item text="45" localize="true" action="setting 'RPM' 45" check="setting 'RPM' 45"/>
          <item text="4 Beats" localize="true" action="setting 'RPM' '4 beats'" check="setting 'RPM' '4 beats'"/>
        </submenu>
        <separator localize="true"/>
        <item text="Auto Disc Marker" action="setting 'autoDiscMarker'" check="setting 'autoDiscMarker'"/>
      </menu>
    </group>
  </define>
  <define class="JOGWHEEL" placeholders="*jogsize=155">
    <!-- JOGWHEEL A: MINIMAL -->
    <group name="jogwheel_a" visibility="var_equal '@$jog_type' 0">
      <!-- empty deck outer ring -->
      <visual visibility="not loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="dark_1" border="dark_4" border_size="1"/>
      </visual>
      <visual source="song_pos 'show warning'" type="circle" visibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff"/>
        <on shape="circle" color="dark_6"/>
      </visual>
      <visual name="innercircle_border" visibility="loaded">
        <pos x="+4" y="+4"/>
        <size width="[JOGSIZE]-8" height="[JOGSIZE]-8"/>
        <off shape="circle" color="#111111" border_size="35" border="dark_0"/>
      </visual>
      <visual name="innercircle_border" visibility="loaded">
        <pos x="+52" y="+52"/>
        <size width="[JOGSIZE]-104" height="[JOGSIZE]-104"/>
        <off shape="circle" color="#33FFFFFF" border_size="1" border="#33FFFFFF"/>
      </visual>
      <!-- SONG ENDING WARNING -->
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink" tooltip="">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="20" border="transparent" color="mixerbackground" shape="circle"/>
        <on border_size="4" border="#FF4444" color="#33FF0000" shape="circle"/>
      </visual>
      <group x="+45" y="+110" visibility="loaded ? songpos_warning">
        <visual width="70" height="30" visibility="songpos_warning blink">
          <off shape="square" color="#AA000000" border="#33FF4444" border_size="1" radius="4"/>
        </visual>
        <textzone class="text" width="70" height="15" fontsize="8" color="white" align="center" weight="bold" text="REMAINING"/>
        <textzone class="text" y="+10" width="70" height="20" fontsize="17" color="white" align="center" weight="bold" textaction="get_time 'remain'"/>
      </group>
      <group>
        <!-- inner needle piece -->
        <slider class="dome_spinner" visibility="loaded" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="jogprogressoff" widthfader="8" heightfader="20" radius="8"/>
        <visual name="innercircle_border">
          <pos x="+69" y="+69"/>
          <size width="[JOGSIZE]-69-69" height="[JOGSIZE]-69-69"/>
          <off shape="circle" color="dark_9" border_size="0" border="black"/>
        </visual>
        <!-- light needle piece -->
        <slider class="dome_spinner" visibility="loaded" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="white" widthfader="1" heightfader="45" radius="30"/>
        <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="jog_slider" widthfader="5" heightfader="5" radius="69"/>
        <panel class="jogwheel_corner_buttons"/>
      </group>
      <visual visibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="transparent" border="dark_4" border_size="1"/>
      </visual>
    </group>
    <!-- JOGWHEEL B: TEXT -->
    <group name="jogwheel_b" visibility="var_equal '@$jog_type' 1">
      <visual>
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
      </visual>
      <!-- SONG ENDING WARNING -->
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink" tooltip="" visibility="songpos_warning ? blink 1bt">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="2" border="transparent" color="red" shape="circle"/>
        <on border_size="5" border="deckcolor" color="mixerbackground" shape="circle"/>
      </visual>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="deckcolor" widthfader="14" heightfader="32" radius="42"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="jog_slider" widthfader="14" heightfader="32" radius="42"/>
      <visual name="innercircle_border">
        <pos x="+10" y="+10"/>
        <size width="[JOGSIZE]-20" height="[JOGSIZE]-20"/>
        <off shape="circle" color="jogwheelbackground2" border_size="1" border="deckcolor"/>
      </visual>
      <!-- BPM -->
      <group x="+0" y="+25" visibility="loaded">
        <!-- BPM VALUE -->
        <textzone class="text" width="[JOGSIZE]" height="46" fontsize="23" color="needle" align="center" weight="bold" textaction="var_equal '@$bpm_hide_options' 1 ? get_text '--.--' : var_equal '@$jog_bpm_digits' 0 ? get_text '%Pbpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%Pbpmex'"/>
        <button action="pitch_reset 8bt">
          <pos x="+0" y="-10"/>
          <size width="+[JOGSIZE]" height="25"/>
          <text fontsize="12" weight="" color="white" align="center" action="get_text '%Ppitch%'" important="true"/>
          <textover color="white" text="RESET" align="center"/>
        </button>
        <group y="+15">
          <!-- PITCH DOWN BUTTON -->
          <button class="button_main" x="+65-40" width="30" height="20" action="pitch -1 bpm" textcoloroff="transparent" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="minus"/>
          <!-- PITCH UP BUTTON -->
          <button class="button_main" x="+65+40" width="30" height="20" action="pitch +1 bpm" textcoloroff="transparent" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="plus"/>
        </group>
      </group>
      <group x="+[JOGSIZE]/2-50+1" y="+70">
        <group x="+15">
          <button x="+0" class="button_main" action="key_match_button" width="20" height="18" coloroff="black" coloron="transparent" brcoloroff="red" brcoloron="green" brcolorover="white" bordersize="0" textsize="12" textcolor="red" textcoloron="green" text="K" visibility="loaded ? not masterdeck ? not match_key ? blink 1bt : true" radius="2"/>
          <button x="+22" class="button_main" action="sync" width="20" height="18" color="blue" coloroff="transparent" brcoloroff="red" brcoloron="green" coloron="black" bordersize="0" textsize="12" textcolor="red" textcoloron="green" text="B" query="is_sync" visibility="loaded ? not masterdeck ? not is_sync ? blink 1bt : true"/>
          <button x="+44" class="button_main" action="sync &amp; phrase_sync 32" width="20" height="18" color="blue" coloroff="transparent" brcoloroff="red" brcoloron="green" coloron="black" bordersize="0" textsize="12" textcolor="red" textcoloron="green" text="P" query="is_sync" visibility="loaded ? not masterdeck ? not is_sync ? blink 1bt : true"/>
        </group>
        <!-- MASTER BUTTON -->
        <button class="button_main" action="key_match_button" width="100" height="18" coloroff="transparent" coloron="transparent" bordersize="0" brcoloroff="orange" brcoloron="orange" radius="1" textsize="12" textcolor="orange" textcoloron="orange" textaction="masterdeck ? masterdeck_auto ? get_text 'MASTER (AUTO)' : get_text 'MANUAL' : get_text 'SLAVE'" visibility="loaded ? masterdeck"/>
      </group>
      <!-- bottom -->
      <!-- KEY -->
      <group x="+0" y="+93" visibility="loaded">
        <textzone class="text" width="[JOGSIZE]" height="28" fontsize="22" color="white" align="center" weight="bold" textaction="get_key" visibility="loaded ? var_equal '@$jog_display_mode' 0"/>
        <group visibility="not masterdeck">
          <!-- KEY DOWN BUTTON -->
          <button class="button_main" x="+65-40" y="+2" width="30" height="20" action="key_move -1" textcoloroff="transparent" textcoloron="white" coloron="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="minus"/>
          <!-- KEY UP BUTTON -->
          <button class="button_main" x="+65+40" y="+2" width="30" height="20" action="key_move +1" textcoloroff="transparent" textcoloron="white" coloron="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="plus"/>
        </group>
        <!-- key difference bottom text -->
        <button action="match_key" rightclick="key_match_menu" visibility="loaded ? not masterdeck ? not match_key ? blink 1bt : true">
          <pos x="+0" y="+18"/>
          <size width="+[JOGSIZE]" height="25"/>
          <text fontsize="12" weight="" align="center" coloroff="red" coloron="green" colorover="black" action="get_key_modifier" important="true"/>
        </button>
      </group>
      <button class="button_main" x="+18" y="+92" width="[JOGSIZE]-36" height="26" action="loop" textsize="14" coloroff="transparent" coloron="transparent" bordersize="0" align="center" weight="bold" textaction="get_text '`get_loop` LOOP'" visibility="loaded ? var_equal '@$jog_display_mode' 1"/>
      <panel class="jogwheel_corner_buttons"/>
    </group>
    <!-- JOGWHEEL C: SYNC STATUS -->
    <group name="jogwheel_c" visibility="var_equal '@$jog_type' 2">
      <visual novisibility="loaded">
        <tooltip/>
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogprogressoff" border="jogprogressoff"/>
      </visual>
      <!-- outer progress ring -->
      <visual source="song_pos" type="circle" visibility="not masterdeck">
        <tooltip/>
        <pos x="-1" y="-1"/>
        <size width="[JOGSIZE]+2" height="[JOGSIZE]+2"/>
        <off shape="circle" color="#333333" border="transparent"/>
        <on shape="circle" color="deckcolor" border="transparent"/>
      </visual>
      <visual source="song_pos" type="circle" visibility="masterdeck">
        <tooltip/>
        <pos x="-1" y="-1"/>
        <size width="[JOGSIZE]+2" height="[JOGSIZE]+2"/>
        <off shape="circle" color="#333333" border="transparent"/>
        <on shape="circle" color="color_masterdeck" border="transparent"/>
      </visual>
      <!-- song end warning -->
      <visual source="song_pos" type="circle" visibility="songpos_warning ? blink 1bt">
        <pos x="-1" y="-1"/>
        <size width="[JOGSIZE]+2" height="[JOGSIZE]+2"/>
        <off shape="circle" color="red" border="red"/>
        <on shape="circle" color="#DDFFAAAA" border="red"/>
      </visual>
      <!-- time spinner -->
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="#222222" widthfader="10" heightfader="50" radius="30"/>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="#DDDDDD" widthfader="5" heightfader="50" radius="28"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+10" y="+10" width="[JOGSIZE]-20" height="[JOGSIZE]-20" offcolor="transparent" colorfader="jog_slider" widthfader="8" heightfader="8" radius="66"/>
      <!-- SONG ENDING WARNING -->
      <visual source="song_pos 'show warning'" type="circle" visibility="loaded" color="red" width="40" height="40" x="+0" y="+0"/>
      <!-- black circle mask -->
      <visual name="innercircle_border">
        <pos x="+10" y="+10"/>
        <size width="[JOGSIZE]-20" height="[JOGSIZE]-20"/>
        <off shape="circle" color="jogwheelbackground2"/>
      </visual>
      <visual name="innercircle_border" visibility="songpos_warning ? blink 1bt">
        <pos x="+10" y="+10"/>
        <size width="[JOGSIZE]-20" height="[JOGSIZE]-20"/>
        <off shape="circle" color="#44FF0000"/>
      </visual>
      <group name="jogwheel_content" visibility="loaded">
        <group>
          <!-- BPM % DIFF -->
          <textzone>
            <pos x="+0" y="+12"/>
            <size width="+[JOGSIZE]" height="25"/>
            <text fontsize="12" weight="" color="white" align="center" format="`get_text '%Ppitch%'`" important="true"/>
          </textzone>
          <!-- BPM -->
          <button action="pitch_reset 8bt" x="+0" y="+36" width="[JOGSIZE]" height="22" border_size="1" border="red">
            <text fontsize="24" coloron="red" colorselected="green" weight="bold" align="center" action="var_equal '@$bpm_hide_options' 1 ? get_text '--.--' : var_equal '@$jog_bpm_digits' 0 ? get_text '%Pbpm' : get_text '%Pbpmex'"/>
          </button>
        </group>
        <group x="+8" y="+60">
          <button class="button_main" action="sync" width="43" height="18" x="+16" color="blue" coloroff="transparent" brcoloroff="red" brcoloron="green" coloron="black" bordersize="1" textsize="12" textcolor="red" textcoloron="green" text="BEAT" query="is_sync" visibility="loaded ? not masterdeck ? not is_sync ? blink 1bt : true"/>
          <button class="button_main" action="sync &amp; phrase_sync 32" width="66" height="18" x="+60" color="blue" coloroff="transparent" brcoloroff="red" brcoloron="green" coloron="black" bordersize="1" textsize="12" textcolor="red" textcoloron="green" text="PHRASE" query="is_sync" visibility="loaded ? not masterdeck ? not is_sync ? blink 1bt : true"/>
          <button class="button_main" action="key_match_button" width="110" height="18" x="+16" y="+20" coloroff="black" coloron="transparent" brcoloroff="red" brcoloron="green" brcolorover="white" bordersize="1" textsize="12" textcolor="red" textcoloron="green" text="KEY" visibility="loaded ? not masterdeck ? not match_key ? blink 1bt : true" radius="2"/>
        </group>
        <!-- MASTER BUTTON -->
        <button class="button_main" action="key_match_button" width="110" height="30" x="+16+6" y="+63" coloroff="transparent" coloron="transparent" bordersize="1" brcoloroff="orange" brcoloron="orange" radius="1" textsize="12" textcolor="orange" textcoloron="orange" textaction="masterdeck ? masterdeck_auto ? get_text 'AUTO MASTER' : get_text 'MASTER' : get_text 'SLAVE'" visibility="loaded ? masterdeck"/>
        <!-- KEY -->
        <group x="+20" y="+103">
          <!-- KEY TEXT -->
          <textzone class="text" x="+19" y="+0" width="128-26-26" height="20" action="match_key" rightclick="key_match_menu" fontsize="20" color="white" align="center" weight="bold" textaction="get_key"/>
          <!-- KEY DOWN BUTTON -->
          <button class="button_main" x="+8" y="+0" width="30" height="20" action="key_move -1" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" border="0" iconsize="15" sysicon="minus" iconcolor="green"/>
          <!-- KEY MATCH BUTTON -->
          <button class="button_main" action="match_key" rightclick="key_match_menu" width="100-26-26" height="14" x="+32" y="+21" coloroff="black" coloron="black" bordersize="0" textsize="12" textcolor="red" textcoloron="green" textaction="get_key_modifier">
            <over color="red"/>
            <text coloroff="red" colorover="black"/>
          </button>
          <!-- KEY UP BUTTON -->
          <button class="button_main" x="+75" y="+0" width="30" height="20" action="key_move +1" textcoloroff="transparent" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="plus"/>
        </group>
        <panel class="jogwheel_corner_buttons"/>
      </group>
    </group>
    <!-- PRO: JOGWHEEL D: COVER ART -->
    <group name="jogwheel_d" visibility="var_equal '@$jog_type' 3">
      <visual name="innercircle_border">
        <pos x="+0" y="+0"/>
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off shape="circle" color="jogwheelbackground2" border_size="10" border="jogprogressoff"/>
      </visual>
      <group visibility="0.6">
        <visual name="outerborder" x="+0" y="+0" source="masterdeck" query="masterdeck">
          <size width="[JOGSIZE]" height="[JOGSIZE]"/>
          <off border_size="1" border="dark_5" color="transparent" shape="circle"/>
          <on border_size="1" border="color_masterdeck" color="black" shape="circle"/>
        </visual>
      </group>
      <slider class="dome_spinner" visibility="loaded" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="jogprogressoff" widthfader="20" heightfader="32" radius="42"/>
      <slider class="dome_spinner" action="get_rotation_slip" visibility="loaded ? get_slip_active" tooltip="" x="+5" y="+5" width="[JOGSIZE]-10" height="[JOGSIZE]-10" offcolor="transparent" colorfader="jog_slider" widthfader="20" heightfader="32" radius="42"/>
      <!-- base (yours) -->
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="2" border="transparent" color="mixerbackground" shape="circle"/>
        <on border_size="7" border="jogprogressoff" color="mixerbackground" shape="circle"/>
      </visual>
      <cover rotate="yes" visibility="0.9">
        <pos x="+12" y="+12"/>
        <size width="[JOGSIZE]-24" height="[JOGSIZE]-24"/>
      </cover>
      <visual source="song_pos 'show warning'" type="circle" visibility="loaded" color="red" width="40" height="40" x="+0" y="+0"/>
      <visual name="outerborder" x="+0" y="+0" source="songpos_warning blink">
        <size width="[JOGSIZE]" height="[JOGSIZE]"/>
        <off border_size="2" border="transparent" color="mixerbackground" shape="circle"/>
        <on border_size="10" border="red" color="#33FF0000" shape="circle"/>
      </visual>
      <panel class="jogwheel_corner_buttons"/>
    </group>
  </define>
</defs>
