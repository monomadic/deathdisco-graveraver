      <button class="button_main" x="+0" y="+6+30+4+30+2+62" width="58" height="24" action="pitch_reset 4bt" coloroff="transparent" brcoloroff="transparent" textcolor="textoff2" textaction="get_text '%Ppitch%'" query="pitch_reset ? blink 400ms"/>
