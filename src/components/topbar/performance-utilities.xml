<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="TOPBAR_PERFORMANCE_UTILITIES">
    <!-- LAYOUT SELECTOR -->
    <group x="410" y="2">
      <!-- border -->
      <visual x="+0" y="+8" width="90" height="28">
        <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
      </visual>
      <!-- blackout -->
      <visual x="+30">
        <size width="28" height="16"/>
        <off shape="square" color="black"/>
      </visual>
      <!-- label -->
      <textzone x="+0">
        <size width="90" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="center" text="LAYOUT" important="true"/>
      </textzone>
      <!-- layout buttons (cycle) -->
      <group x="+0" y="+11">
        <button class="button_main" width="90" height="22" color="transparent" coloroff="transparent" bordersize="0" align="center" radius="10" action="cycle '@$dd_performance_layout' 2 &amp; load_skin">
          <text colorover="#FFFFFF" color="#999999" weight="normal" align="center" size="14" coloron="white" action="(get_var '@$dd_performance_layout' &amp; param_equal 1) ? get_text 'HORIZONTAL' : get_text 'VERTICAL'"/>
        </button>
      </group>
    </group>
    <panel class="topbar_rack_toggles" x="505" y="2"/>
    <group visibility="0.75">
      <visual class="gfx_shape" x="115+80+300+90+643" y="8" width="75" height="27" coloroff="panel_background" visibility="not can_sandbox"/>
    </group>
  </define>
</defs>
