<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="TOPBAR_PRO_UTILITIES">
    <!-- LAYOUT SELECTOR: mixer panel on/off (off = extended decks) -->
    <group x="410" y="2">
      <!-- border -->
      <visual x="+0" y="+8" width="90" height="28">
        <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
      </visual>
      <!-- blackout -->
      <visual x="+30">
        <size width="28" height="16"/>
        <off shape="square" color="black"/>
      </visual>
      <!-- label -->
      <textzone x="+0">
        <size width="90" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="center" text="LAYOUT" important="true"/>
      </textzone>
      <!-- toggle -->
      <group x="+0" y="+11">
        <button tooltip="Toggle the center mixer panel (off = extended decks)" class="button_main" width="90" height="22" color="transparent" coloroff="transparent" bordersize="0" align="center" radius="10" action="toggle '@$dd_hide_pro_mixer' &amp; load_skin">
          <text colorover="#FFFFFF" color="#999999" weight="normal" align="center" size="14" coloron="white" action="(get_var '@$dd_hide_pro_mixer' &amp; param_equal 1) ? get_text 'EXTENDED' : get_text 'MIXER'"/>
        </button>
      </group>
    </group>
    <!-- RACKS: show/hide the rack band (same control as the Performance topbar) -->
    <panel class="topbar_rack_toggles" x="505" y="2"/>
    <!-- MIXER OPTIONS: configures the rack panels (both Pro variants). Show/hide of the
         rack band itself is handled by the RACKS button group. -->
    <menu tooltip="MIXER OPTIONS" visibility="var_equal '@$dd_skin_mode' 0">
      <pos x="700" y="5"/>
      <size width="36" height="36"/>
      <off shape="square" color="black" border="transparent"/>
      <icon sysicon="settings" height="20" width="20" color="dark_8" colorover="white" colordown="needle"/>
      <submenu text="Left Panel (Mixer)" localize="true">
        <item text="Microphone" action="set '@$dd_left_rack_headphones' 0" check="var_equal '@$dd_left_rack_headphones' 0"/>
        <item text="Headphones" action="set '@$dd_left_rack_headphones' 1" check="var_equal '@$dd_left_rack_headphones' 1"/>
      </submenu>
      <separator/>
      <submenu text="Right Panel (Mixer)" localize="true">
        <item text="Master" action="set '@$dd_right_rack_record' 0" check="var_equal '@$dd_right_rack_record' 0"/>
        <item text="Rec/Broadcast" action="set '@$dd_right_rack_record' 1" check="var_equal '@$dd_right_rack_record' 1"/>
      </submenu>
      <separator/>
      <submenu text="Center Panel (FX)" localize="true">
        <item text="Master FX" action="set '@$dd_show_center_fx_rack' 0" check="var_equal '@$dd_show_center_fx_rack' 0"/>
        <item text="Mic FX" action="set '@$dd_show_center_fx_rack' 1" check="var_equal '@$dd_show_center_fx_rack' 1"/>
      </submenu>
      <separator/>
      <submenu text="EQ Frequency Spread" localize="true">
        <item text="Default" action="setting 'equalizerFrequencySpread' 'default'" check="setting 'equalizerFrequencySpread' 'default'"/>
        <item text="Full Kill" action="setting 'equalizerFrequencySpread' 'full kill'" check="setting 'equalizerFrequencySpread' 'full kill'"/>
      </submenu>
      <submenu text="Vu Meter" localize="true">
        <item text="Peak Mode" action="setting 'vuMeter' 'peak'" check="setting 'vuMeter' 'peak'"/>
        <item text="Power Mode" action="setting 'vuMeter' 'power'" check="setting 'vuMeter' 'power'"/>
        <separator text="Color"/>
        <item text="Per Deck" action="set '@$dd_vu_alt_colors' 0" check="var_equal '@$dd_vu_alt_colors' 0"/>
        <item text="Natural" action="set '@$dd_vu_alt_colors' 1" check="var_equal '@$dd_vu_alt_colors' 1"/>
        <separator/>
        <item text="Show Extra Peak Meter" localize="true" action="toggle '@$dd_show_peak_meter'" check="var_equal '@$dd_show_peak_meter' 1"/>
      </submenu>
      <submenu text="Filter Resonance" localize="true">
        <item text="Default" action="setting 'filterDefaultResonance' 'default'" check="setting 'filterDefaultResonance' 'default'"/>
        <item text="Strong" action="setting 'filterDefaultResonance' 'strong'" check="setting 'filterDefaultResonance' 'strong'"/>
        <item text="Subtle" action="setting 'filterDefaultResonance' 'subtle'" check="setting 'filterDefaultResonance' 'subtle'"/>
      </submenu>
      <submenu text="Fader Start" localize="true">
        <item text="ON" action="deck all setting 'faderStart' on" check="setting 'faderStart' on"/>
        <item text="OFF" action="deck all setting 'faderStart' off" check="setting 'faderStart' off"/>
      </submenu>
      <submenu text="Fader StartStop" localize="true">
        <item text="ON" action="deck all setting 'faderStartStop' on" check="setting 'faderStartStop' on"/>
        <item text="OFF" action="deck all setting 'faderStartStop' off" check="setting 'faderStartStop' off"/>
      </submenu>
      <separator/>
      <item text="Reset EQ On Load" localize="true" action="setting 'resetEqOnLoad'" check="setting 'resetEqOnLoad'"/>
      <item text="Use Auto Gain" localize="true" action="setting 'autoGain' 'auto' ? setting 'autoGain' 'no' : setting 'autoGain' 'auto'" check="setting 'autoGain' 'auto'"/>
      <item text="Show Drop Down Menus" localize="true" action="toggle '@$dd_hide_drop_menus'" check="var_equal '@$dd_hide_drop_menus' 0"/>
    </menu>
    <group name="barsleft4" x="+660-30" y="+10" visibility="var_equal '@$dd_phrase_circle' 1">
      <deck deck="1">
        <button class="button_main" x="+0" y="+0" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+0" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+0" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+0" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
      <deck deck="3">
        <button class="button_main" x="+0" y="+15" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+15" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+15" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+15" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsright4" x="+660+530+30" y="+10" visibility="var_equal '@$dd_phrase_circle' 1">
      <deck deck="2">
        <button class="button_main" x="+0" y="+0" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+0" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+0" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+0" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
      <deck deck="4">
        <button class="button_main" x="+0" y="+15" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+15" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+15" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+15" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
  </define>
</defs>
