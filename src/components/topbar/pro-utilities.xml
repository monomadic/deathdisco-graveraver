<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="TOPBAR_PRO_UTILITIES">
    <!-- LAYOUT SELECTOR: mixer panel on/off (off = extended decks) -->
    <group x="410" y="2">
      <!-- border -->
      <visual x="+0" y="+8" width="90" height="28">
        <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
      </visual>
      <!-- blackout -->
      <visual x="+30">
        <size width="28" height="16"/>
        <off shape="square" color="black"/>
      </visual>
      <!-- label -->
      <textzone x="+0">
        <size width="90" height="16"/>
        <text fontsize="9" weight="normal" color="#999999" align="center" text="LAYOUT" important="true"/>
      </textzone>
      <!-- toggle -->
      <group x="+0" y="+11">
        <button tooltip="Toggle the center mixer panel (off = extended decks)" class="button_main" width="90" height="22" color="transparent" coloroff="transparent" bordersize="0" align="center" radius="10" action="toggle '@$hide_pro_mixer' &amp; load_skin">
          <text overcolor="#FFFFFF" color="#999999" weight="normal" align="center" size="14" oncolor="white" action="(get_var '@$hide_pro_mixer' &amp; param_equal 1) ? get_text 'EXTENDED' : get_text 'MIXER'"/>
        </button>
      </group>
    </group>
    <!-- RACKS: show/hide the rack band (same control as the Performance topbar) -->
    <group x="505" y="2">
      <group>
        <group x="+5" y="+9">
          <button class="button_main" x="+0" action="var_equal '@$rack_mode' 1 ? toggle '@$show_mixer_rack' &amp; set '@$show_fx_rack' 0 &amp; set '@$show_pads_rack' 0 &amp; set '@$show_video_rack' 0 &amp;&amp; load_skin : toggle '@$show_mixer_rack' &amp; load_skin" width="60" height="27" bordersize="0">
            <off color="transparent"/>
            <text color="dark_6" overcolor="dark_8" size="12" oncolor="white" text="MIXER"/>
          </button>
          <button class="button_main" x="+53" action="var_equal '@$rack_mode' 1 ? toggle '@$show_video_rack' &amp; set '@$show_fx_rack' 0 &amp; set '@$show_mixer_rack' 0 &amp; set '@$show_pads_rack' 0 &amp;&amp; load_skin : toggle '@$show_video_rack' &amp; load_skin" width="60" height="27" bordersize="0">
            <off color="transparent"/>
            <text color="dark_6" overcolor="dark_8" size="12" oncolor="white" text="VIDEO"/>
          </button>
          <button class="button_main" x="+55+60" action="var_equal '@$rack_mode' 1 ? toggle '@$show_fx_rack' &amp; set '@$show_pads_rack' 0 &amp; set '@$show_mixer_rack' 0 &amp; set '@$show_video_rack' 0 &amp;&amp; load_skin : toggle '@$show_fx_rack' &amp; load_skin" width="60" height="27" bordersize="0">
            <off color="transparent"/>
            <text color="dark_6" overcolor="dark_8" size="12" oncolor="white" text="EFFECTS"/>
          </button>
        </group>
        <!-- border -->
        <visual x="+0" y="+8" width="190" height="28">
          <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
        </visual>
        <!-- label -->
        <textzone x="+0">
          <size width="180" height="16"/>
          <text fontsize="9" weight="normal" color="#999999" align="center" text="RACKS" important="true"/>
        </textzone>
      </group>
    </group>
    <!-- MIXER OPTIONS: configures the rack panels (both Pro variants). Show/hide of the
         rack band itself is handled by the RACKS button group. -->
    <menu tooltip="MIXER OPTIONS" visibility="var_equal '@$skin_mode' 0">
      <pos x="700" y="5"/>
      <size width="36" height="36"/>
      <off shape="square" color="black" border="transparent"/>
      <icon sysicon="settings" height="20" width="20" color="dark_8" colorover="white" colordown="needle"/>
      <submenu text="Left Panel (Mixer)" localize="true">
        <item text="Microphone" action="set '@$show_left_mixer_rack' 0" check="var_equal '@$show_left_mixer_rack' 0"/>
        <item text="Headphones" action="set '@$show_left_mixer_rack' 1" check="var_equal '@$show_left_mixer_rack' 1"/>
      </submenu>
      <separator/>
      <submenu text="Right Panel (Mixer)" localize="true">
        <item text="Master" action="set '@$show_right_mixer_rack' 0" check="var_equal '@$show_right_mixer_rack' 0"/>
        <item text="Rec/Broadcast" action="set '@$show_right_mixer_rack' 1" check="var_equal '@$show_right_mixer_rack' 1"/>
      </submenu>
      <separator/>
      <submenu text="Center Panel (FX)" localize="true">
        <item text="Master FX" action="set '@$show_center_fx_rack' 0" check="var_equal '@$show_center_fx_rack' 0"/>
        <item text="Mic FX" action="set '@$show_center_fx_rack' 1" check="var_equal '@$show_center_fx_rack' 1"/>
      </submenu>
      <separator/>
      <submenu text="EQ Frequency Spread" localize="true">
        <item text="Default" action="setting 'equalizerFrequencySpread' 'default'" check="setting 'equalizerFrequencySpread' 'default'"/>
        <item text="Full Kill" action="setting 'equalizerFrequencySpread' 'full kill'" check="setting 'equalizerFrequencySpread' 'full kill'"/>
      </submenu>
      <submenu text="Vu Meter" localize="true">
        <item text="Peak Mode" action="setting 'vuMeter' 'peak'" check="setting 'vuMeter' 'peak'"/>
        <item text="Power Mode" action="setting 'vuMeter' 'power'" check="setting 'vuMeter' 'power'"/>
        <separator text="Color"/>
        <item text="Per Deck" action="set '@$hntnhvumetercolors' 0" check="var_equal '@$hntnhvumetercolors' 0"/>
        <item text="Natural" action="set '@$hntnhvumetercolors' 1" check="var_equal '@$hntnhvumetercolors' 1"/>
        <separator/>
        <item text="Show Extra Peak Meter" localize="true" action="toggle '@$show_peak_meter'" check="var_equal '@$show_peak_meter' 1"/>
      </submenu>
      <submenu text="Filter Resonance" localize="true">
        <item text="Default" action="setting 'filterDefaultResonance' 'default'" check="setting 'filterDefaultResonance' 'default'"/>
        <item text="Strong" action="setting 'filterDefaultResonance' 'strong'" check="setting 'filterDefaultResonance' 'strong'"/>
        <item text="Subtle" action="setting 'filterDefaultResonance' 'subtle'" check="setting 'filterDefaultResonance' 'subtle'"/>
      </submenu>
      <submenu text="Fader Start" localize="true">
        <item text="ON" action="deck all setting 'faderStart' on" check="setting 'faderStart' on"/>
        <item text="OFF" action="deck all setting 'faderStart' off" check="setting 'faderStart' off"/>
      </submenu>
      <submenu text="Fader StartStop" localize="true">
        <item text="ON" action="deck all setting 'faderStartStop' on" check="setting 'faderStartStop' on"/>
        <item text="OFF" action="deck all setting 'faderStartStop' off" check="setting 'faderStartStop' off"/>
      </submenu>
      <separator/>
      <item text="Reset EQ On Load" localize="true" action="setting 'resetEqOnLoad'" check="setting 'resetEqOnLoad'"/>
      <item text="Use Auto Gain" localize="true" action="setting 'autoGain' 'auto' ? setting 'autoGain' 'no' : setting 'autoGain' 'auto'" check="setting 'autoGain' 'auto'"/>
      <item text="Show Drop Down Menus" localize="true" action="toggle '@$show_drop_menus'" check="var_equal '@$show_drop_menus' 0"/>
    </menu>
    <!-- ? phrase circles in 4 deck swap ? -->
    <group name="barsleft" x="+660" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? not deck 3 leftdeck">
      <deck deck="1">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsleft" x="+660" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? deck 3 leftdeck">
      <deck deck="3">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsright" x="+660+530" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? not deck 4 rightdeck">
      <deck deck="2">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsright" x="+660+530" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 0 ? deck 4 rightdeck">
      <!-- BEAT KEEPER -->
      <group x="+1090" y="+8">
        <visual class="gfx_shape" width="10*4" height="27" coloroff="transparent"/>
        <group>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+0" deck="3"/>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+7" deck="1"/>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+14" deck="2"/>
          <panel class="beat_keeper_ex" bgcolor="#222222" width="10" y="+21" deck="4"/>
        </group>
      </group>
      <deck deck="4">
        <button class="button_main" x="+0" y="+0" width="30" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+0" width="30" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+0" y="+15" width="30" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+34" y="+15" width="30" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsleft4" x="+660-30" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 1">
      <deck deck="1">
        <button class="button_main" x="+0" y="+0" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+0" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+0" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+0" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
      <deck deck="3">
        <button class="button_main" x="+0" y="+15" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+15" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+15" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+15" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
    <group name="barsright4" x="+660+530+30" y="+10" visibility="var_equal '@$phrasecircle' 1 ? var_equal '@$4decks' 1">
      <deck deck="2">
        <button class="button_main" x="+0" y="+0" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+0" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+0" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+0" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
      <deck deck="4">
        <button class="button_main" x="+0" y="+15" width="15" height="10" shape="square" query="goto_bar 1" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17" y="+15" width="15" height="10" shape="square" query="goto_bar 2" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*2" y="+15" width="15" height="10" shape="square" query="goto_bar 3" coloroff="infos_background" brcoloroff="infos_background"/>
        <button class="button_main" x="+17*3" y="+15" width="15" height="10" shape="square" query="goto_bar 4" coloroff="infos_background" brcoloroff="infos_background"/>
      </deck>
    </group>
  </define>
</defs>
