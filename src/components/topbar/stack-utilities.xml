<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="TOPBAR_STACK_UTILITIES">
    <!-- PANEL TOGGLES -->
    <group x="450" y="+8">
      <button tooltip="Show/Hide Pad Panel" class="button_main" x="+60*0" action="toggle '@$dd_stack_controls'" width="55" height="27" bordersize="0">
        <off color="black"/>
        <on color="#222222"/>
        <over color="#000000"/>
        <down color="#222222"/>
        <selected color="#333333"/>
        <text colorover="white" size="12" coloron="white" text="PADS"/>
      </button>
    </group>
    <!-- Shared rack toggles in the Stack palette (see rack-toggles.generated.xml) -->
    <panel class="topbar_rack_toggles" x="450+60" y="+8" inset_x="+0" inset_y="+0" frame="false"/>
  </define>
</defs>
