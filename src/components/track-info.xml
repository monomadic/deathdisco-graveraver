<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="COVER_ART_OCCLUDED" placeholders="*cover_width=170">
    <cover action="" rightclick="" dblclick="">
      <size width="[COVER_WIDTH]" height="[COVER_WIDTH]"/>
      <clipmask x="920" y="100" width="100" height="90"/>
    </cover>
    <!-- highlight -->
    <visual>
      <size width="170" height="65"/>
      <off shape="square" color="transparent" border="#22FFFFFF" border_size="1"/>
    </visual>
  </define>
  <define class="TRACK_INFO_PRO" placeholders="*width=550,height=75">
    <!-- LEFT DECK -->
    <!-- background: black glass (behind cover) -->
    <button class="button_main" action="select" width="[WIDTH]" height="[HEIGHT]" coloroff="#000000" coloron="black" brcoloroff="#333333" brcoloron="#444444" bordersize="0"/>
    <!-- ACAPELLA/INSTRUMENTAL LINE BORDER -->
    <group visibility="loaded">
    </group>
    <!-- COVER ART: HIDE -->
    <group visibility="var_equal '@$show_cover_title' 0 &amp; loaded">
      <pos x="+15" y="+8"/>
      <!-- LEFT -->
      <!-- title -->
      <textzone tooltip="" visibility="get_deck 1 ? true : get_deck 3 ? true : false">
        <size width="[WIDTH]/2" height="70-6-6-26"/>
        <text fontsize="22" weight="bold" color="needle" align="left" scroll="no" action="loaded ? get_text '`get_title_before_remix`' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <!-- artist -->
      <textzone tooltip="" visibility="get_deck 1 ? true : get_deck 3 ? true : false">
        <pos y="+30"/>
        <size width="[WIDTH]/2" height="70-6-6-26"/>
        <text fontsize="17" weight="" color="#888888" align="left" scroll="no" action="loaded ? get_text '`get_loaded_song remix` `get_bpm absolute`bpm' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <!-- RIGHT -->
      <textzone tooltip="" visibility="get_deck 2 ? true : get_deck 4 ? true : false">
        <size width="[WIDTH]/2" height="70-6-6-26"/>
        <text fontsize="22" weight="bold" color="needle" align="right" scroll="no" action="loaded ? get_text '`get_title_before_remix`' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <textzone tooltip="" visibility="get_deck 2 ? true : get_deck 4 ? true : false">
        <pos y="+30"/>
        <size width="[WIDTH]/2" height="70-6-6-26"/>
        <text fontsize="17" weight="" color="#888888" align="right" scroll="no" action="loaded ? get_text '`get_loaded_song remix` `get_bpm absolute`bpm' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
    </group>
    <!-- COVER ART: SHOW -->
    <group visibility="var_equal '@$show_cover_title' 1">
      <!-- Left decks -->
      <panel class="track_info_metadata" x="+10+170+10" y="+0" visibility="get_deck 1 ? true : get_deck 3 ? true : false" width="[WIDTH]-200"/>
      <!-- Right decks -->
      <panel class="track_info_metadata" x="+10" y="+0" visibility="get_deck 2 ? true : get_deck 4 ? true : false" width="[WIDTH]-200"/>
      <!-- left -->
      <group class="cover_art_occluded" x="+10" y="+6" visibility="loaded ? param_equal `get_deck` 1 | param_equal `get_deck` 3"/>
      <!-- right -->
      <group class="cover_art_occluded" x="+[WIDTH]-170-5" y="+6" visibility="loaded ? param_equal `get_deck` 2 | param_equal `get_deck` 4"/>
    </group>
  </define>
  <define class="TRACK_INFO_METADATA" placeholders="deck,*width=340">
    <panel>
      <group visibility="loaded">
        <button y="+5" class="button_main" action="search `get_title_before_remix`" rightclick="file_info" tooltip="" bordersize="0">
          <size width="[WIDTH]" height="18"/>
          <off color="black"/>
          <down color="black"/>
          <selected color="black"/>
          <text action="get_title_before_remix &amp; param_uppercase" color="white" align="left" fontsize="16" weight="bold"/>
          <textover action="get_text 'SEARCH: &quot;`get_title_before_remix &amp; param_uppercase`&quot;'" fontsize="16" weight="bold"/>
        </button>
        <!-- LINE 2: ARTIST -->
        <button y="+22" class="button_main" action="search `get_loaded_song 'artist'`" rightclick="file_info" tooltip="" bordersize="0">
          <size width="[WIDTH]" height="16"/>
          <off color="black"/>
          <down color="black"/>
          <selected color="black"/>
          <text action="get_loaded_song 'artist' &amp; param_uppercase" color="#888888" align="left" fontsize="12" weight="normal"/>
          <textover action="get_text 'SEARCH: &quot;`get_loaded_song artist &amp; param_uppercase`&quot;'" color="#888888" fontsize="12" weight="normal"/>
        </button>
        <group y="+40">
          <!-- border, outer -->
          <visual>
            <pos y="+0"/>
            <size width="[WIDTH]" height="30"/>
            <off shape="square" color="transparent" border="#555555" border_size="1"/>
          </visual>
          <!-- border, vertical internal -->
          <visual>
            <pos x="+58"/>
            <size width="50" height="30"/>
            <off shape="square" color="transparent" border="#555555" border_size="1"/>
          </visual>
          <!-- BPM -->
          <textzone>
            <pos x="+3" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" text="BPM" localize="true" important="true"/>
          </textzone>
          <textzone tooltip="">
            <pos x="+2" y="+11"/>
            <size width="80" height="18"/>
            <!-- Use format with inline eval: backticks around the expression -->
            <text fontsize="14" weight="" color="#eeeeee" align="left" scroll="no" format="`get_loaded_song 'bpm'`" localize="true" important="true"/>
          </textzone>
          <!-- KEY (toggle Musical/Harmonic) -->
          <textzone>
            <pos x="+61" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" text="KEY" localize="true" important="true"/>
          </textzone>
          <button action="var_equal 'keyDisplayToggle' 1 ? setting 'keyDisplay' 'Musical' &amp; set 'keyDisplayToggle' 0 : setting 'keyDisplay' 'Harmonic' &amp; set 'keyDisplayToggle' 1" query="var_equal 'keyDisplayToggle' 1">
            <pos x="+61" y="+11"/>
            <size width="40" height="18"/>
            <!-- colored when key exists -->
            <text fontsize="14" weight="" align="left" visibility="get_key" color="white" action="get_loaded_song 'key'"/>
            <!-- fallback when no key/color -->
            <text fontsize="14" weight="" align="left" visibility="not get_key" color="white" action="get_loaded_song 'key'"/>
          </button>
          <!-- TIME REMAINING -->
          <textzone>
            <pos x="+110" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" action="display_time" localize="true" important="true"/>
          </textzone>
          <button tooltip="" action="display_time">
            <pos x="+110" y="+11"/>
            <size width="80" height="18"/>
            <!-- Use format with inline eval: backticks around the expression -->
            <text fontsize="14" weight="" color="#eeeeee" align="left" scroll="no" action="get_time" localize="true" important="true"/>
          </button>
          <group x="+195" y="+0">
            <!-- FILETYPE -->
            <square width="45" border="1" border_color="#555555" height="15" visibility="loaded" color="#111111"/>
            <textzone>
              <size width="45" height="16"/>
              <text fontsize="11" color="#888888" align="center" scroll="no" action="get_loaded_song 'file type' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <button action="show_splitpanel 'sideview' on &amp; sideview 'remixes' on" query="has_linked_tracks" border_size="1" border="red">
            <pos x="+296" y="+6"/>
            <size width="40" height="18"/>
            <off color="black" radius="3" border="green" bordersize="1"/>
            <over color="green" radius="3" border="green" bordersize="1"/>
            <!-- colored when key exists -->
            <text fontsize="11" weight="normal" align="center" visibility="has_linked_tracks" color="green" text="LINKS"/>
            <!-- fallback when no key/color -->
            <text fontsize="11" weight="normal" align="center" visibility="not has_linked_tracks" color="black" coloron="black" text="LINKS"/>
          </button>
        </group>
      </group>
    </panel>
  </define>
  <define class="TRACK_INFO_EXTENDED" placeholders="*deck,*mirror=false,*width=920,*height=75">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="[WIDTH]" height="[HEIGHT]" coloroff="black"/>
      <!-- cover -->
      <group x="+10" y="+5" visibility="loaded" condition="not [MIRROR]">
        <cover action="" rightclick="" dblclick="">
          <size width="[HEIGHT]*2+20" height="[HEIGHT]*2"/>
          <clipmask x="920" y="100" width="100" height="[HEIGHT]"/>
        </cover>
      </group>
      <group x="+742" y="+5" visibility="loaded" condition="[MIRROR]">
        <cover action="" rightclick="" dblclick="">
          <size width="170" height="170"/>
          <clipmask x="920" y="100" width="100" height="90"/>
        </cover>
      </group>
      <!-- title etc -->
      <panel class="track_info_metadata" width="410">
        <pos x="+190" condition="not [MIRROR]"/>
        <pos x="+320" condition="[MIRROR]"/>
      </panel>
    </deck>
  </define>
  <define class="SYNC_INFO_EXTENDED" placeholders="*deck,*width=920,*height=75">
    <!-- SYNC INFO -->
    <!-- BPM -->
    <group>
      <!-- outline -->
      <visual shape="square" width="98" height="[HEIGHT]">
        <off color="transparent" border="dark_5" border_size="1"/>
      </visual>
      <group x="+10" y="+1">
        <!-- label -->
        <textzone action="pitch_reset" tooltip="">
          <size width="90" height="18"/>
          <text color="dark_8" align="left" weight="" size="15" action="get_text BPM"/>
        </textzone>
        <!-- topright -->
        <textzone class="text" fontsize="10" color="dark_8" align="right" weight="normal" action="cycle '@$hauntinstimesdisplay' 3" textaction="var_equal '@$jog_bpm_digits' 0 ? get_text '%bpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%bpmex'" visibility="not var_equal '@$jog_type' 0">
          <pos x="+48"/>
          <size width="25" height="18"/>
        </textzone>
        <!-- bpm -->
        <textzone>
          <pos x="+0" y="+17"/>
          <size width="90" height="30"/>
          <text color="`deck [DECK] masterdeck ? color 'orange' : color 'white'`" align="left" size="36" weight="bold" action="var_equal '@$bpm_hide_options' 1 ? get_text '--.--' : var_equal '@$jog_bpm_digits' 0 ? get_text '%Pbpm' : get_text '%Pbpmex'"/>
        </textzone>
        <!-- sync diff -->
        <button action="pitch_reset" tooltip="">
          <pos x="+0" y="+48"/>
          <size width="80" height="20"/>
          <off color="black" border="dark_8" border_size="1" radius="4"/>
          <text size="20" color="dark_8" align="center" weight="" action="get_text '%Ppitch%'"/>
        </button>
      </group>
    </group>
    <!-- key -->
    <group x="+100">
      <!-- outline -->
      <visual shape="square" width="98" height="[HEIGHT]">
        <off color="transparent" border="dark_5" border_size="1"/>
      </visual>
      <group x="+10" y="+1">
        <!-- label -->
        <button tooltip="">
          <size width="90" height="18"/>
          <text color="dark_8" align="left" weight="" size="15" action="get_text KEY"/>
        </button>
        <!-- key -->
        <textzone action="key_match_button" rightclick="key_match_menu">
          <pos x="+0" y="+17"/>
          <size width="90" height="30"/>
          <text size="36" color="`deck [DECK] masterdeck ? color 'orange' : get_key_color`" align="left" weight="bold" action="get_key"/>
        </textzone>
        <!-- key modifier -->
        <button action="get_key_modifier_text">
          <pos x="+15" y="+48"/>
          <size width="50" height="20"/>
          <off color="black" border="dark_8" border_size="1" radius="4"/>
          <text size="20" color="dark_8" align="center" weight="" text="+0"/>
        </button>
      </group>
    </group>
    <!-- time -->
    <group x="+200">
      <!-- outline -->
      <visual shape="square" width="98" height="[HEIGHT]">
        <off color="transparent" border="dark_5" border_size="1"/>
      </visual>
      <!-- label -->
      <group x="+10" y="+1">
        <textzone action="cycle '@$hauntinstimesdisplay' 3" tooltip="">
          <size width="90" height="18"/>
          <text color="dark_8" align="left" weight="" size="15" action="var_equal '@$hauntinstimesdisplay' 0 ? get_text 'ELAPSED' : var_equal '@$hauntinstimesdisplay' 1 ? get_text 'REMAIN' : var_equal '@$hauntinstimesdisplay' 2 ? get_text 'TIME'"/>
        </textzone>
        <!-- time -->
        <textzone tooltip="">
          <pos x="+0" y="+15"/>
          <size width="90" height="27"/>
          <text color="white" align="left" size="32" weight="bold" action="var_equal '@$hauntinstimesdisplay' 0 ? get_time 'ELAPSED' : var_equal '@$hauntinstimesdisplay' 1 ? get_time 'REMAIN' : var_equal '@$hauntinstimesdisplay' 2 ? get_time 'TOTAL'"/>
        </textzone>
      </group>
    </group>
  </define>
  <define class="TRACK_INFO_STACK">
    <!-- title background -->
    <button x="+0" class="button_main" action="toggle '@hntnhtxtscroll'" rightclick="file_info" tooltip="Text Scroll\nRight-click: Tag Editor" width="479" height="124" coloroff="infos_background" coloron="infos_background" brcoloroff="panel_background" brcoloron="panel_background" bordersize="1"/>
    <group x="+4">
      <!-- title -->
      <textzone orientation="vertical" direction="ccw">
        <pos x="+0" y="+5"/>
        <size width="20" height="150"/>
        <text fontsize="16" weight="bold" color="needle" align="right" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <!-- remix -->
      <textzone orientation="vertical">
        <pos x="+15" y="+5"/>
        <size width="20" height="150"/>
        <text fontsize="12" weight="" color="#888888" align="right" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
    </group>
    <!-- cover -->
    <cover rotate="no" visibility="1.0">
      <pos x="+40" y="+5"/>
      <size width="120" height="120"/>
    </cover>
  </define>
  <define class="TRACK_STEM_MODIFIERS">
    <!-- ACAPELLA/INSTRUMENTAL BUTTONS -->
    <group x="+0" y="+0">
      <!-- acapella -->
      <button action="stem_pad 'acapella'" border_size="1">
        <size width="135" height="23"/>
        <off color="#000000" border="#555555" radius="3"/>
        <down color="#222222" border="color_acapella" radius="3"/>
        <selected color="transparent" border="color_acapella" radius="3"/>
        <text fontsize="12" color="#888888" colorover="color_acapella" colorselected="color_acapella" colordown="color_acapella" align="center" text="ACAPELLA"/>
      </button>
      <!-- instrumental -->
      <button x="+140" action="stem_pad 'instrumental'" border_size="1">
        <size width="134" height="23"/>
        <off color="#111111" border="#555555" radius="3"/>
        <down color="#222222" border="color_instrumental" radius="3"/>
        <selected color="transparent" border="color_instrumental" radius="3"/>
        <text fontsize="12" color="#888888" colorover="color_instrumental" colorselected="color_instrumental" colordown="color_instrumental" align="center" text="INSTRUMENTAL"/>
      </button>
    </group>
    <group y="+30">
      <panel class="stem_button" x="+0" y="+0" stem="vocal" label="VOCAL" color="colorvocal"/>
      <panel class="stem_button" x="+70" y="+0" stem="instru" label="INSTR" color="colorinstru"/>
      <panel class="stem_button" x="+140" y="+0" stem="bass" label="BASS" color="colorbass"/>
      <panel class="stem_button" x="+210" y="+0" stem="rhythm" label="DRUM" color="colorbeat"/>
      <group y="+25">
        <group>
          <button class="stem_fx_button" stem="vocal"/>
          <button class="slot_fx_button" slot="vocals" x="+33"/>
        </group>
        <group x="+70">
          <button class="stem_fx_button" stem="instru"/>
          <button class="slot_fx_button" slot="instru" x="+33"/>
        </group>
        <group x="+140">
          <button class="stem_fx_button" stem="bass"/>
          <button class="slot_fx_button" slot="bass" x="+33"/>
        </group>
        <group x="+210">
          <button class="stem_fx_button" stem="rhythm"/>
          <button class="slot_fx_button" slot="rhythm" x="+33"/>
        </group>
      </group>
      <group y="+46">
        <panel class="stem_volume_slider" x="+0" stem="vocal" label="VOCAL" color="colorvocal"/>
        <panel class="stem_volume_slider" x="+70" stem="instru" label="INSTR" color="colorinstru"/>
        <panel class="stem_volume_slider" x="+140" stem="bass" label="BASS" color="colorbass"/>
        <panel class="stem_volume_slider" x="+210" stem="rhythm" label="DRUM" color="colorbeat"/>
      </group>
    </group>
  </define>
  <define class="TRACK_MODIFIERS_PANEL" placeholders="*mirror=false">
    <group visibility="loaded" x="+0" y="+20">
      <!-- NO STEMS ALERT -->
      <group visibility="not has_stems" y="+30">
        <textzone class="text" width="300" height="48" fontsize="10" color="textdarker" align="center" weight="" text="STEMS NOT FOUND"/>
      </group>
      <!-- STEM BUTTONS -->
      <group x="+5" y="+5" visibility="has_stems" condition="not [MIRROR]">
        <panel class="track_stem_modifiers"/>
      </group>
      <group x="+265" y="+5" visibility="has_stems" condition="[MIRROR]">
        <panel class="track_stem_modifiers"/>
      </group>
      <!-- MODIFIERS -->
      <panel>
        <pos x="+292" y="+5" condition="not [MIRROR]"/>
        <pos x="+0" y="+5" condition="[MIRROR]"/>
        <!-- STATUS: COLORFX -->
        <group>
          <button width="80" height="19" action="effect_disable_all 'colorfx'" query="effect_active 'colorfx'" border_size="1">
            <off color="#000000"/>
            <selected color="color_colorfx"/>
            <text dx="+10" fontsize="12" color="#AAAAAA" colorselected="black" align="left" text="COLOR FX"/>
          </button>
          <button x="+82" width="165" height="19" action="effect_disable_all 'colorfx'" query="effect_active colorfx" border_size="1">
            <off color="#000000"/>
            <selected color="#222222" textcolor="color_colorfx" border="#333333"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="color_colorfx" align="left" action="filter_label"/>
          </button>
        </group>
        <!-- STATUS: PADFX -->
        <group y="+22">
          <button width="80" height="19" action="effect_disable_all &amp; effect_disable_all 'sampler'" border_size="1" query="effects_used 'padfx'">
            <off color="#000000"/>
            <selected color="color_padfx"/>
            <text dx="+10" fontsize="12" color="#AAAAAA" colorselected="#333333" align="left" text="PAD FX"/>
          </button>
          <button x="+82" width="165" height="19" action="effect_disable_all 'padfx'" query="effects_used 'padfx'" border_size="1">
            <off color="#000000"/>
            <selected color="#222222" textcolor="color_padfx" border="#333333"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="color_padfx" align="left" action="get_text '`get_effects_used` ACTIVE'"/>
          </button>
        </group>
        <!-- STATUS: SAMPLER -->
        <group y="+44">
          <button width="80" height="19" action="sampler_stop" border_size="1" query="sampler_play_stop">
            <off color="#000000"/>
            <selected color="color_sampler"/>
            <text dx="+10" fontsize="12" color="#AAAAAA" colorselected="black" align="left" text="SAMPLER"/>
          </button>
          <button x="+82" width="165" height="19" action="sampler_stop" query="sampler_play_stop" border_size="1">
            <off color="#000000"/>
            <selected color="#222222" textcolor="color_sampler" border="#333333"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="color_sampler" align="left" action="get_sample_name"/>
          </button>
        </group>
        <!-- STATUS: LOOPER -->
        <group y="+66">
          <button class="button_main" width="32" height="19" action="loop ? loop : nothing" query="loop ? blink 500ms : off" sysicon="sampler_loop" iconsize="16" coloroff="#000000" coloron="#000000" brcoloroff="#000000" brcoloron="#2aa8ff" bordersize="1" textcolor="#555555" textcoloron="#2aa8ff" tooltip="Loop"/>
          <button x="+32" width="48" height="19" action="loop ? loop : nothing" border_size="1" query="loop">
            <off color="#000000"/>
            <selected color="#000000" border="#2aa8ff"/>
            <text dx="+7" fontsize="12" color="#AAAAAA" colorselected="#2aa8ff" align="left" text="LOOP"/>
          </button>
          <button x="+82" width="165" height="19" action="loop ? loop : nothing" border_size="1" query="loop">
            <off color="#000000"/>
            <selected color="#222222" textcolor="#2aa8ff" border="#2aa8ff"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="#2aa8ff" align="left" action="get_text '`get_loop` ACTIVE'"/>
          </button>
        </group>
      </panel>
    </group>
  </define>
</defs>
