        <panel class="textzone_title_artist_combo" x="+2+4+28+8" y="+4" width="478-78" align="left" scroll="no" visibility="var_equal '@hntnhtxtscroll' 0"/>
        <panel class="textzone_title_artist_combo" x="+2+4+28+8" y="+4" width="478-78" align="left" scroll="yes" visibility="var_equal '@hntnhtxtscroll' 1"/>
      </group>
