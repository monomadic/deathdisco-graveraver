<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="COVER_ART_OCCLUDED">
    <cover action="" rightclick="" dblclick="">
      <size width="170" height="170"/>
      <clipmask x="920" y="100" width="100" height="90"/>
    </cover>
    <!-- highlight -->
    <visual>
      <size width="170" height="65"/>
      <off shape="square" color="transparent" border="#22FFFFFF" border_size="1"/>
    </visual>
  </define>
  <define class="TRACK_INFO_PRO" placeholders="width=550,height=75">
    <!-- LEFT DECK -->
    <!-- background: black glass (behind cover) -->
    <button class="button_main" action="select" width="[WIDTH]" height="[HEIGHT]" coloroff="#000000" coloron="black" brcoloroff="#333333" brcoloron="#444444" bordersize="0"/>
    <!-- ACAPELLA/INSTRUMENTAL LINE BORDER -->
    <group visibility="loaded">
    </group>
    <!-- COVER ART: HIDE -->
    <group visibility="var_equal '@$show_cover_title' 0 &amp; loaded">
      <pos x="+15" y="+8"/>
      <!-- LEFT -->
      <textzone tooltip="" visibility="get_deck 1 ? true : get_deck 3 ? true : false">
        <size width="490" height="70-6-6-26"/>
        <text fontsize="22" weight="bold" color="needle" align="left" scroll="no" action="loaded ? get_text '`get_title_before_remix`' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <textzone tooltip="" visibility="get_deck 1 ? true : get_deck 3 ? true : false">
        <pos y="+30"/>
        <size width="490" height="70-6-6-26"/>
        <text fontsize="17" weight="" color="#888888" align="left" scroll="no" action="loaded ? get_text '`get_loaded_song remix` `get_bpm absolute`bpm' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <!-- RIGHT -->
      <textzone tooltip="" visibility="get_deck 2 ? true : get_deck 4 ? true : false">
        <size width="490" height="70-6-6-26"/>
        <text fontsize="22" weight="bold" color="needle" align="right" scroll="no" action="loaded ? get_text '`get_title_before_remix`' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <textzone tooltip="" visibility="get_deck 2 ? true : get_deck 4 ? true : false">
        <pos y="+30"/>
        <size width="490" height="70-6-6-26"/>
        <text fontsize="17" weight="" color="#888888" align="right" scroll="no" action="loaded ? get_text '`get_loaded_song remix` `get_bpm absolute`bpm' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
    </group>
    <!-- COVER ART: SHOW -->
    <group visibility="var_equal '@$show_cover_title' 1">
      <!-- Left decks -->
      <panel class="track_info_metadata" x="+6+170+6" y="+0" visibility="get_deck 1 ? true : get_deck 3 ? true : false"/>
      <!-- Right decks -->
      <panel class="track_info_metadata" x="+8" y="+0" visibility="get_deck 2 ? true : get_deck 4 ? true : false"/>
      <!-- left -->
      <group class="cover_art_occluded" x="+8" y="+6" visibility="loaded ? param_equal `get_deck` 1 | param_equal `get_deck` 3"/>
      <!-- right -->
      <group class="cover_art_occluded" x="+355" y="+6" visibility="loaded ? param_equal `get_deck` 2 | param_equal `get_deck` 4"/>
    </group>
  </define>
  <define class="TRACK_INFO_METADATA" placeholders="DECK">
    <panel>
      <group visibility="loaded">
        <button y="+5" class="button_main" action="search `get_title_before_remix`" rightclick="file_info" tooltip="" bordersize="0">
          <size width="320" height="18"/>
          <off color="black"/>
          <down color="black"/>
          <selected color="black"/>
          <text action="get_title_before_remix &amp; param_uppercase" color="white" align="left" fontsize="16" weight="bold"/>
          <textover action="get_text 'SEARCH: &quot;`get_title_before_remix &amp; param_uppercase`&quot;'" fontsize="16" weight="bold"/>
        </button>
        <!-- LINE 2: ARTIST -->
        <button y="+22" class="button_main" action="search `get_loaded_song 'artist'`" rightclick="file_info" tooltip="" bordersize="0">
          <size width="320" height="16"/>
          <off color="black"/>
          <down color="black"/>
          <selected color="black"/>
          <text action="get_loaded_song 'artist' &amp; param_uppercase" color="#888888" align="left" fontsize="12" weight="normal"/>
          <textover action="get_text 'SEARCH: &quot;`get_loaded_song artist &amp; param_uppercase`&quot;'" color="#888888" fontsize="12" weight="normal"/>
        </button>
        <group y="+40">
          <!-- border, outer -->
          <visual>
            <pos y="+0"/>
            <size width="343" height="30"/>
            <off shape="square" color="transparent" border="#555555" border_size="1"/>
          </visual>
          <!-- border, vertical internal -->
          <visual>
            <pos x="+58"/>
            <size width="50" height="30"/>
            <off shape="square" color="transparent" border="#555555" border_size="1"/>
          </visual>
          <!-- BPM -->
          <textzone>
            <pos x="+3" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" text="BPM" localize="true" important="true"/>
          </textzone>
          <textzone tooltip="">
            <pos x="+2" y="+11"/>
            <size width="80" height="18"/>
            <!-- Use format with inline eval: backticks around the expression -->
            <text fontsize="14" weight="" color="#eeeeee" align="left" scroll="no" format="`get_loaded_song 'bpm'`" localize="true" important="true"/>
          </textzone>
          <!-- KEY (toggle Musical/Harmonic) -->
          <textzone>
            <pos x="+61" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" text="KEY" localize="true" important="true"/>
          </textzone>
          <button action="var_equal 'keyDisplayToggle' 1 ? setting 'keyDisplay' 'Musical' &amp; set 'keyDisplayToggle' 0 : setting 'keyDisplay' 'Harmonic' &amp; set 'keyDisplayToggle' 1" query="var_equal 'keyDisplayToggle' 1">
            <pos x="+61" y="+11"/>
            <size width="40" height="18"/>
            <!-- colored when key exists -->
            <text fontsize="14" weight="" align="left" visibility="get_key" color="white" action="get_loaded_song 'key'"/>
            <!-- fallback when no key/color -->
            <text fontsize="14" weight="" align="left" visibility="not get_key" color="white" action="get_loaded_song 'key'"/>
          </button>
          <!-- TIME REMAINING -->
          <textzone>
            <pos x="+110" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" action="display_time" localize="true" important="true"/>
          </textzone>
          <!-- <textzone class="text" x="+110" y="+11" width="50" fontsize="14" color="white" align="left" weight="" textaction="get_time"/> -->
          <button tooltip="" action="display_time">
            <pos x="+110" y="+11"/>
            <size width="80" height="18"/>
            <!-- Use format with inline eval: backticks around the expression -->
            <text fontsize="14" weight="" color="#eeeeee" align="left" scroll="no" action="get_time" localize="true" important="true"/>
          </button>
          <group x="+195" y="+0">
            <!-- FILETYPE -->
            <square width="45" border="1" border_color="#555555" height="15" visibility="loaded" color="#111111"/>
            <textzone>
              <size width="45" height="16"/>
              <text fontsize="11" color="#888888" align="center" scroll="no" action="get_loaded_song 'file type' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <button action="show_splitpanel 'sideview' on &amp; sideview 'remixes' on" query="has_linked_tracks" border_size="1" border="red">
            <pos x="+296" y="+6"/>
            <size width="40" height="18"/>
            <off color="black" radius="3" border="green" bordersize="1"/>
            <over color="green" radius="3" border="green" bordersize="1"/>
            <!-- colored when key exists -->
            <text fontsize="11" weight="normal" align="center" visibility="has_linked_tracks" color="green" text="LINKS"/>
            <!-- fallback when no key/color -->
            <text fontsize="11" weight="normal" align="center" visibility="not has_linked_tracks" color="black" coloron="black" text="LINKS"/>
          </button>
          <button action="effect_active 6" query="effect_active 6" rightclick="effect_show_gui 6">
            <pos x="+230" y="-20"/>
            <size width="80" height="15"/>
            <off color="black" radius="3" border="dark_6" border_size="1"/>
            <selected color="black" radius="3" border="yellow" border_size="1"/>
            <over color="transparent" radius="3" border="dark_8" border_size="1"/>
            <text fontsize="11" weight="normal" align="center" visibility="not has_linked_tracks" color="dark_8" colorselected="yellow" action="get_effect_name 6"/>
          </button>
        </group>
      </group>
    </panel>
  </define>
  <define class="TRACK_INFO_EXTENDED" placeholders="*deck,*deckside">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="960-35-4" height="70" coloroff="black"/>
      <group x="+190" visibility="param_equal [DECKSIDE] 'left'">
        <!-- LINE 1 (Title) -->
        <textzone>
          <size width="500" height="70-6-6-26"/>
          <text fontsize="18" weight="bold" color="needle" align="left" scroll="yes" action="deck loaded ? get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <button class="button_main" action="search `get_title_before_remix`" rightclick="file_info" x="+4+28+6+170+8" y="+1" tooltip="" width="484-2-4-28-6-2-4-210" height="70-6-6-26" coloroff="transparent" coloron="transparent" brcoloroff="transparent" brcoloron="transparent" bordersize="2"/>
        <!-- LINE 2 (Remix) -->
        <textzone>
          <pos y="+18"/>
          <size width="260" height="70-6-6-26"/>
          <text fontsize="12" color="#888888" align="left" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
      </group>
      <group visibility="param_equal [DECKSIDE] 'right'">
        <!-- LINE 1 (Title) -->
        <textzone x="+232">
          <size width="500" height="70-6-6-26"/>
          <text fontsize="18" weight="bold" color="needle" align="right" scroll="yes" action="deck loaded ? get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <button class="button_main" action="search `get_title_before_remix`" rightclick="file_info" x="+288" y="+1" tooltip="" width="484-2-4-28-6-2-4-210" height="70-6-6-26" coloroff="transparent" coloron="transparent" brcoloroff="transparent" brcoloron="transparent" bordersize="2"/>
        <!-- LINE 2 (Remix) -->
        <textzone x="+472">
          <pos y="+18"/>
          <size width="260" height="70-6-6-26"/>
          <text fontsize="12" color="#888888" align="right" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
      </group>
      <!-- cover -->
      <group x="+10" y="+8" visibility="loaded ? param_equal [DECKSIDE] 'left'">
        <cover action="" rightclick="" dblclick="">
          <size width="170" height="170"/>
          <clipmask x="920" y="100" width="100" height="90"/>
        </cover>
      </group>
      <group x="+742" y="+8" visibility="loaded ? param_equal [DECKSIDE] 'right'">
        <cover action="" rightclick="" dblclick="">
          <size width="170" height="170"/>
          <clipmask x="920" y="100" width="100" height="90"/>
        </cover>
      </group>
      <!-- PERFORMANCE: EXTENDED: LEFT DECK: ACTIONS -->
      <group x="+900/2" visibility="param_equal [DECKSIDE] 'left'">
        <textzone class="text" x="+160" y="+7" width="90" height="34" fontsize="25" color="needle" align="center" weight="bold" textaction="var_equal '@$jog_bpm_digits' 0 ? get_text '%Pbpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%Pbpmex'" visibility="var_equal '@$jog_type' 0"/>
        <textzone class="text" x="+160" y="+7" width="90" height="34" fontsize="25" color="white" align="center" weight="bold" textaction="var_equal '@$jog_bpm_digits' 0 ? get_text '%bpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%bpmex'" visibility="not var_equal '@$jog_type' 0"/>
        <textzone class="text" x="+160" y="+36" action="cycle '@$hauntinstimesdisplay' 3" tooltip="" width="80" height="24" fontsize="12" color="textdarker" align="center" weight="" text="BPM"/>
        <textzone class="text" x="+280" y="+6" width="60" height="34" action="key_match_menu" fontsize="25" color="`get_key_color`" align="center" weight="bold" textaction="get_key"/>
        <!-- key modifier -->
        <textzone class="text" x="+280" y="+38" width="60" height="20" fontsize="12" align="center" weight="" color="#999999" textaction="get_key_modifier_text"/>
        <textzone class="text" x="+380" y="+7" action="cycle '@$hauntinstimesdisplay' 3" tooltip="" width="80" height="34" fontsize="25" color="needle" align="center" weight="bold" textaction="var_equal '@$hauntinstimesdisplay' 0 ? get_time 'ELAPSED' : var_equal '@$hauntinstimesdisplay' 1 ? get_time 'REMAIN' : var_equal '@$hauntinstimesdisplay' 2 ? get_time 'TOTAL'"/>
        <!-- label -->
        <textzone class="text" x="+380" y="+36" action="cycle '@$hauntinstimesdisplay' 3" tooltip="" width="80" height="24" fontsize="12" color="textdarker" align="center" weight="" textaction="var_equal '@$hauntinstimesdisplay' 0 ? get_text 'ELAPSED' : var_equal '@$hauntinstimesdisplay' 1 ? get_text 'REMAIN' : var_equal '@$hauntinstimesdisplay' 2 ? get_text 'TIME'"/>
      </group>
      <!-- PERFORMANCE: EXTENDED: RIGHT DECK: ACTIONS -->
      <group visibility="param_equal [DECKSIDE] 'right'">
        <textzone class="text" x="+222" y="+7" width="90" height="34" fontsize="25" color="needle" align="center" weight="bold" textaction="var_equal '@$jog_bpm_digits' 0 ? get_text '%Pbpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%Pbpmex'" visibility="var_equal '@$jog_type' 0"/>
        <textzone class="text" x="+222" y="+7" width="90" height="34" fontsize="25" color="white" align="center" weight="bold" textaction="var_equal '@$jog_bpm_digits' 0 ? get_text '%bpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%bpmex'" visibility="not var_equal '@$jog_type' 0"/>
        <textzone class="text" x="+232" y="+36" action="cycle '@$hauntinstimesdisplay' 3" tooltip="" width="80" height="24" fontsize="12" color="textdarker" align="center" weight="" text="BPM"/>
        <textzone class="text" x="+132" y="+6" width="60" height="34" action="key_match_menu" fontsize="25" color="`get_key_color`" align="center" weight="bold" textaction="get_key"/>
        <!-- key modifier -->
        <textzone class="text" x="+132" y="+38" width="60" height="20" fontsize="12" align="center" weight="" color="#999999" textaction="get_key_modifier_text"/>
        <textzone class="text" x="+12" y="+7" action="cycle '@$hauntinstimesdisplay' 3" tooltip="" width="80" height="34" fontsize="25" color="needle" align="center" weight="bold" textaction="var_equal '@$hauntinstimesdisplay' 0 ? get_time 'ELAPSED' : var_equal '@$hauntinstimesdisplay' 1 ? get_time 'REMAIN' : var_equal '@$hauntinstimesdisplay' 2 ? get_time 'TOTAL'"/>
        <!-- label -->
        <textzone class="text" x="+12" y="+36" action="cycle '@$hauntinstimesdisplay' 3" tooltip="" width="80" height="24" fontsize="12" color="textdarker" align="center" weight="" textaction="var_equal '@$hauntinstimesdisplay' 0 ? get_text 'ELAPSED' : var_equal '@$hauntinstimesdisplay' 1 ? get_text 'REMAIN' : var_equal '@$hauntinstimesdisplay' 2 ? get_text 'TIME'"/>
      </group>
    </deck>
  </define>
