    <group visibility="get_deck 1 ? true : get_deck 3 ? true : false">
      <button class="button_main" x="+2+4" y="+6" width="28" height="68-6-6" action="select" rightclick="cycle '@infospannelmode' 5" tooltip="Select Deck" coloroff="button_background" textheight="30" textsize="16" textaction="get_deck"/>
      <menu class="menu_maindecks" query="select" x="+2+4" y="+70-8-22" width="28" height="20"/>
