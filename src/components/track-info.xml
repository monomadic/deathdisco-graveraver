      <button class="button_main" x="+10" y="+38+2" width="90" height="18" action="masterdeck" coloroff="button_background" textcolor="textoff4" text="MASTER"/>
      <button class="button_main" x="+10+90+10+80+10-55-22" y="+10+2" width="20" height="22" action="key_move -1" coloroff="button_background" textcolor="textoff4" iconsize="16" sysicon="arrowleft"/>
      <button class="button_main" x="+10+90+10+80+10-55+54" y="+10+2" width="20" height="22" action="key_move +1" coloroff="button_background" textcolor="textoff4" iconsize="16" sysicon="arrowright"/>
