<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="COVER_ART_OCCLUDED" placeholders="*cover_width=170">
    <cover action="" rightclick="" dblclick="">
      <size width="[COVER_WIDTH]" height="[COVER_WIDTH]"/>
      <clipmask x="920" y="100" width="100" height="90"/>
    </cover>
    <!-- highlight -->
    <visual>
      <size width="170" height="65"/>
      <off shape="square" color="transparent" border="#22FFFFFF" border_size="1"/>
    </visual>
  </define>
  <define class="TRACK_INFO_PRO" placeholders="*deckside,*width=550,height=75">
    <!-- LEFT DECK -->
    <!-- background: black glass (behind cover) -->
    <button class="button_main" action="select" width="[WIDTH]" height="[HEIGHT]" coloroff="#000000" coloron="black" brcoloroff="#333333" brcoloron="#444444" bordersize="0"/>
    <!-- ACAPELLA/INSTRUMENTAL LINE BORDER -->
    <group visibility="loaded">
    </group>
    <!-- COVER ART: HIDE -->
    <!-- Two columns: title/remix on the outer edge, BPM/KEY/REMAIN stats on the inner edge. -->
    <group visibility="var_equal '@$dd_show_cover_title' 0 &amp; loaded">
      <pos x="+15" y="+8"/>
      <!-- LEFT -->
      <group condition="param_equal '[DECKSIDE]' 'leftdeck'">
        <textzone tooltip="">
          <size width="[WIDTH]-30-280" height="70-6-6-26"/>
          <text fontsize="22" weight="bold" color="needle" align="left" scroll="no" action="loaded ? get_text '`get_title_before_remix`' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <textzone tooltip="">
          <pos y="+30"/>
          <size width="[WIDTH]-30-280" height="70-6-6-26"/>
          <text fontsize="17" weight="" color="#888888" align="left" scroll="no" action="loaded ? get_loaded_song 'remix' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <panel class="track_info_stats" otherdeck="right" timex="0" div1="81" keyx="85" div2="174" bpmx="176" x="+[WIDTH]-20-276" y="-1"/>
      </group>
      <!-- RIGHT -->
      <group condition="param_equal '[DECKSIDE]' 'rightdeck'">
        <panel class="track_info_stats" otherdeck="left" bpmx="0" div1="101" keyx="103" div2="194" timex="200" x="-10" y="-1"/>
        <textzone tooltip="">
          <pos x="+280"/>
          <size width="[WIDTH]-30-280" height="70-6-6-26"/>
          <text fontsize="22" weight="bold" color="needle" align="right" scroll="no" action="loaded ? get_text '`get_title_before_remix`' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <textzone tooltip="">
          <pos x="+280" y="+30"/>
          <size width="[WIDTH]-30-280" height="70-6-6-26"/>
          <text fontsize="17" weight="" color="#888888" align="right" scroll="no" action="loaded ? get_loaded_song 'remix' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
      </group>
    </group>
    <!-- COVER ART: SHOW -->
    <group visibility="var_equal '@$dd_show_cover_title' 1">
      <!-- Left decks -->
      <panel class="track_info_metadata" x="+10+170+10" y="+0" condition="param_equal '[DECKSIDE]' 'leftdeck'" width="[WIDTH]-200"/>
      <!-- Right decks -->
      <panel class="track_info_metadata" x="+10" y="+0" condition="param_equal '[DECKSIDE]' 'rightdeck'" width="[WIDTH]-200"/>
      <!-- left -->
      <group class="cover_art_occluded" x="+10" y="+6" visibility="loaded" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
      <!-- right -->
      <group class="cover_art_occluded" x="+[WIDTH]-170-5" y="+6" visibility="loaded" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
    </group>
  </define>
  <!-- BPM / KEY / TIME readout for TRACK_INFO_PRO: BPM 100 / KEY 88 / TIME 76 columns split by hairlines
       (276 wide, 66 tall); callers place BPM nearest the mixer and TIME nearest the title. Each column is label / value / detail; inherits the caller's deck scope.
       BPM:  white within +/-10% of the original, yellow to +/-20%, red beyond (detail blinks red).
       KEY:  vs the active deck on the other side ([OTHERDECK]): green when match_key reports
             compatible (white), orange two Camelot steps away (or one step across A/B), red otherwise,
             white when that deck has no key. Click: key-match menu; right-click: toggle Musical/Harmonic (Camelot) notation.
             Detail = MATCH, or the semitone shift.
             Bare match_key / key_match_button return their value (0), not their truth, so wrap them
             as `... ? true : false` when they are a branch or the whole visibility.
       TIME: click cycles @$dd_track_stats_time: -remaining / elapsed / total; white, yellow under 60s
             remaining, red under 20s. Detail = elapsed, or -remaining while elapsed is shown.
       Clicking the BPM column glides the pitch back to 0% over one bar (pitch_reset 4bt). -->
  <define class="TRACK_INFO_STATS" placeholders="*otherdeck,*bpmx,*keyx,*timex,*div1,*div2">
    <line color="#2a2a2a" x="+[DIV1]" y="+4" width="1" height="58"/>
    <line color="#2a2a2a" x="+[DIV2]" y="+4" width="1" height="58"/>
    <textzone action="pitch_reset 4bt">
      <pos x="+[BPMX]"/>
      <size width="100" height="11"/>
      <text fontsize="10" color="#777777" align="center" localize="true" important="true" text="BPM"/>
    </textzone>
    <textzone>
      <pos x="+[KEYX]"/>
      <size width="88" height="11"/>
      <text fontsize="10" color="#777777" align="center" localize="true" important="true" text="KEY"/>
    </textzone>
    <textzone action="cycle '@$dd_track_stats_time' 3">
      <pos x="+[TIMEX]"/>
      <size width="76" height="11"/>
      <text fontsize="10" color="#777777" align="center" localize="true" important="true" action="var_equal '@$dd_track_stats_time' 1 ? get_text 'ELAPSED' : var_equal '@$dd_track_stats_time' 2 ? get_text 'TOTAL' : get_text 'REMAIN'"/>
    </textzone>
    <textzone action="pitch_reset 4bt">
      <pos x="+[BPMX]" y="+10"/>
      <size width="100" height="36"/>
      <text fontsize="32" weight="bold" align="center" scroll="no" important="true" color="`param_bigger 120 get_pitch_value ? color '#ff453a' : param_smaller 80 get_pitch_value ? color '#ff453a' : param_bigger 110 get_pitch_value ? color '#f5c518' : param_smaller 90 get_pitch_value ? color '#f5c518' : color '#eeeeee'`" action="var_equal '@$dd_jog_bpm_digits' 1 ? get_text '%Pbpmex' : get_text '%Pbpm'"/>
    </textzone>
    <!-- key: white with no reference key, else green / orange / red by compatibility -->
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? false : true">
      <pos x="+[KEYX]" y="+10"/>
      <size width="88" height="36"/>
      <text fontsize="32" weight="bold" align="center" scroll="no" important="true" color="#eeeeee" action="get_key"/>
    </textzone>
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? match_key ? true : false : false">
      <pos x="+[KEYX]" y="+10"/>
      <size width="88" height="36"/>
      <text fontsize="32" weight="bold" align="center" scroll="no" important="true" color="#eeeeee" action="get_key"/>
    </textzone>
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? match_key ? false : param_contains 'A' `get_harmonic` ? param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? true : false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? true : false : param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? true : false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? true : false : false">
      <pos x="+[KEYX]" y="+10"/>
      <size width="88" height="36"/>
      <text fontsize="32" weight="bold" align="center" scroll="no" important="true" color="#ff9f1a" action="get_key"/>
    </textzone>
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? match_key ? false : param_contains 'A' `get_harmonic` ? param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? false : true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? false : true : param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? false : true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? false : true : false">
      <pos x="+[KEYX]" y="+10"/>
      <size width="88" height="36"/>
      <text fontsize="32" weight="bold" align="center" scroll="no" important="true" color="#ff453a" action="get_key"/>
    </textzone>
    <textzone action="cycle '@$dd_track_stats_time' 3" >
      <pos x="+[TIMEX]" y="+10"/>
      <size width="76" height="36"/>
      <text fontsize="32" weight="bold" align="center" scroll="no" important="true" color="`get_time 'remain' 1 &amp; param_smaller 20 ? color '#ff453a' : get_time 'remain' 1 &amp; param_smaller 60 ? color '#f5c518' : color '#eeeeee'`" action="var_equal '@$dd_track_stats_time' 1 ? get_time 'elapsed' 'short' : var_equal '@$dd_track_stats_time' 2 ? get_time 'total' 'short' : get_text '-`get_time remain short`'"/>
    </textzone>
    <!-- detail row -->
    <textzone action="pitch_reset 4bt" visibility="get_pitch_zero">
      <pos x="+[BPMX]" y="+44"/>
      <size width="100" height="20"/>
      <text weight="bold" fontsize="15" align="center" scroll="no" important="true" color="#dddddd" action="get_text '%Ppitch%'"/>
    </textzone>
    <textzone action="pitch_reset 4bt" visibility="get_pitch_zero ? false : param_bigger 120 get_pitch_value ? false : param_smaller 80 get_pitch_value ? false : true">
      <pos x="+[BPMX]" y="+44"/>
      <size width="100" height="20"/>
      <text weight="bold" fontsize="15" align="center" scroll="no" important="true" color="#dddddd" action="get_text '%Ppitch%'"/>
    </textzone>
    <textzone action="pitch_reset 4bt" visibility="param_bigger 120 get_pitch_value ? blink 500ms : param_smaller 80 get_pitch_value ? blink 500ms : false">
      <pos x="+[BPMX]" y="+44"/>
      <size width="100" height="20"/>
      <text fontsize="15" align="center" scroll="no" important="true" weight="bold" color="red" action="get_text '%Ppitch%'"/>
    </textzone>
    <textzone action="key_match_button" visibility="key_match_button ? true : false">
      <pos x="+[KEYX]" y="+44"/>
      <size width="88" height="20"/>
      <text fontsize="15" align="center" scroll="no" important="true" weight="bold" color="#eeeeee" action="get_text 'MATCH'"/>
    </textzone>
    <textzone action="key_match_button" visibility="key_match_button ? false : param_equal `get_key_modifier_text` 0 ? true : false">
      <pos x="+[KEYX]" y="+44"/>
      <size width="88" height="20"/>
      <text weight="bold" fontsize="15" align="center" scroll="no" important="true" color="#dddddd" action="get_text '+0 ST'"/>
    </textzone>
    <textzone action="key_match_button" visibility="key_match_button ? false : param_equal `get_key_modifier_text` 0 ? false : true">
      <pos x="+[KEYX]" y="+44"/>
      <size width="88" height="20"/>
      <text fontsize="15" align="center" scroll="no" important="true" weight="bold" color="orange" action="get_text '`get_key_modifier_text` ST'"/>
    </textzone>
    <textzone action="cycle '@$dd_track_stats_time' 3">
      <pos x="+[TIMEX]" y="+44"/>
      <size width="76" height="20"/>
      <text weight="bold" fontsize="15" align="center" scroll="no" important="true" color="#dddddd" action="var_equal '@$dd_track_stats_time' 1 ? get_text '-`get_time remain short`' : get_time 'elapsed' 'short'"/>
    </textzone>
  </define>
  <define class="TRACK_INFO_METADATA" placeholders="deck,*width=340">
    <panel>
      <group visibility="loaded">
        <button y="+5" class="button_main" action="search `get_title_before_remix`" rightclick="file_info" tooltip="" bordersize="0">
          <size width="[WIDTH]" height="18"/>
          <off color="black"/>
          <down color="black"/>
          <selected color="black"/>
          <text action="get_title_before_remix &amp; param_uppercase" color="white" align="left" fontsize="16" weight="bold"/>
          <textover action="get_text 'SEARCH: &quot;`get_title_before_remix &amp; param_uppercase`&quot;'" fontsize="16" weight="bold"/>
        </button>
        <!-- LINE 2: ARTIST -->
        <button y="+22" class="button_main" action="search `get_loaded_song 'artist'`" rightclick="file_info" tooltip="" bordersize="0">
          <size width="[WIDTH]" height="16"/>
          <off color="black"/>
          <down color="black"/>
          <selected color="black"/>
          <text action="get_loaded_song 'artist' &amp; param_uppercase" color="#888888" align="left" fontsize="12" weight="normal"/>
          <textover action="get_text 'SEARCH: &quot;`get_loaded_song artist &amp; param_uppercase`&quot;'" color="#888888" fontsize="12" weight="normal"/>
        </button>
        <group y="+40">
          <!-- border, outer -->
          <visual>
            <pos y="+0"/>
            <size width="[WIDTH]" height="30"/>
            <off shape="square" color="transparent" border="#555555" border_size="1"/>
          </visual>
          <!-- border, vertical internal -->
          <visual>
            <pos x="+58"/>
            <size width="50" height="30"/>
            <off shape="square" color="transparent" border="#555555" border_size="1"/>
          </visual>
          <!-- BPM -->
          <textzone>
            <pos x="+3" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" text="BPM" localize="true" important="true"/>
          </textzone>
          <textzone tooltip="">
            <pos x="+2" y="+11"/>
            <size width="80" height="18"/>
            <!-- Use format with inline eval: backticks around the expression -->
            <text fontsize="14" weight="" color="#eeeeee" align="left" scroll="no" format="`get_loaded_song 'bpm'`" localize="true" important="true"/>
          </textzone>
          <!-- KEY (toggle Musical/Harmonic) -->
          <textzone>
            <pos x="+61" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" text="KEY" localize="true" important="true"/>
          </textzone>
          <button action="var_equal 'keyDisplayToggle' 1 ? setting 'keyDisplay' 'Musical' &amp; set 'keyDisplayToggle' 0 : setting 'keyDisplay' 'Harmonic' &amp; set 'keyDisplayToggle' 1" query="var_equal 'keyDisplayToggle' 1">
            <pos x="+61" y="+11"/>
            <size width="40" height="18"/>
            <!-- colored when key exists -->
            <text fontsize="14" weight="" align="left" visibility="get_key" color="white" action="get_loaded_song 'key'"/>
            <!-- fallback when no key/color -->
            <text fontsize="14" weight="" align="left" visibility="not get_key" color="white" action="get_loaded_song 'key'"/>
          </button>
          <!-- TIME REMAINING -->
          <textzone>
            <pos x="+110" y="+3"/>
            <size width="260"/>
            <text fontsize="9" color="#888888" align="left" action="display_time" localize="true" important="true"/>
          </textzone>
          <button tooltip="" action="display_time">
            <pos x="+110" y="+11"/>
            <size width="80" height="18"/>
            <!-- Use format with inline eval: backticks around the expression -->
            <text fontsize="14" weight="" color="#eeeeee" align="left" scroll="no" action="get_time" localize="true" important="true"/>
          </button>
          <group x="+165" y="+0">
            <!-- FILETYPE -->
            <square width="45" border="1" border_color="#555555" height="15" visibility="loaded" color="#111111"/>
            <textzone>
              <size width="45" height="16"/>
              <text fontsize="11" color="#888888" align="center" scroll="no" action="get_loaded_song 'file type' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <button action="show_splitpanel 'sideview' on &amp; sideview 'remixes' on" query="has_linked_tracks" border_size="1" border="red">
            <pos x="+165" y="+16"/>
            <size width="46" height="13"/>
            <off color="black" radius="3" border="green" bordersize="1"/>
            <over color="green" radius="3" border="green" bordersize="1"/>
            <!-- colored when key exists -->
            <text fontsize="11" weight="normal" align="center" color="green" colorover="black" text="LINKS"/>
          </button>
        </group>
      </group>
    </panel>
  </define>
  <define class="TRACK_INFO_EXTENDED" placeholders="*deck,*mirror=false,*width=920,*height=75">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="[WIDTH]" height="[HEIGHT]" coloroff="black"/>
      <!-- cover -->
      <group x="+10" y="+5" visibility="loaded" condition="not [MIRROR]">
        <cover action="" rightclick="" dblclick="">
          <size width="[HEIGHT]*2+20" height="[HEIGHT]*2"/>
          <clipmask x="920" y="100" width="100" height="[HEIGHT]"/>
        </cover>
      </group>
      <group x="+742" y="+5" visibility="loaded" condition="[MIRROR]">
        <cover action="" rightclick="" dblclick="">
          <size width="170" height="170"/>
          <clipmask x="920" y="100" width="100" height="90"/>
        </cover>
      </group>
      <!-- title etc -->
      <panel class="track_info_metadata" width="410">
        <pos x="+190" condition="not [MIRROR]"/>
        <pos x="+320" condition="[MIRROR]"/>
      </panel>
    </deck>
  </define>
  <define class="SYNC_INFO_EXTENDED" placeholders="*deck,*width=920,*height=75">
    <!-- SYNC INFO -->
    <!-- BPM -->
    <group>
      <!-- outline -->
      <visual shape="square" width="98" height="[HEIGHT]">
        <off color="transparent" border="dark_5" border_size="1"/>
      </visual>
      <group x="+10" y="+1">
        <!-- label -->
        <textzone action="pitch_reset 4bt" tooltip="">
          <size width="90" height="18"/>
          <text color="dark_8" align="left" weight="" size="15" action="get_text BPM"/>
        </textzone>
        <!-- topright -->
        <textzone class="text" fontsize="10" color="dark_8" align="right" weight="normal" action="cycle '@$dd_time_display_mode' 3" textaction="var_equal '@$dd_jog_bpm_digits' 0 ? get_text '%bpm' : var_equal '@$dd_jog_bpm_digits' 1 ? get_text '%bpmex'" visibility="not var_equal '@$dd_jog_type' 0">
          <pos x="+48"/>
          <size width="25" height="18"/>
        </textzone>
        <!-- bpm -->
        <textzone>
          <pos x="+0" y="+17"/>
          <size width="90" height="30"/>
          <text color="`deck [DECK] masterdeck ? color 'orange' : color 'white'`" align="left" size="36" weight="bold" action="var_equal '@$dd_bpm_mask' 1 ? get_text '--.--' : var_equal '@$dd_jog_bpm_digits' 0 ? get_text '%Pbpm' : get_text '%Pbpmex'"/>
        </textzone>
        <!-- sync diff -->
        <button action="pitch_reset 4bt" tooltip="">
          <pos x="+0" y="+48"/>
          <size width="80" height="20"/>
          <off color="black" border="dark_8" border_size="1" radius="4"/>
          <text size="20" color="dark_8" align="center" weight="" action="get_text '%Ppitch%'"/>
        </button>
      </group>
    </group>
    <!-- key -->
    <group x="+100">
      <!-- outline -->
      <visual shape="square" width="98" height="[HEIGHT]">
        <off color="transparent" border="dark_5" border_size="1"/>
      </visual>
      <group x="+10" y="+1">
        <!-- label -->
        <button tooltip="">
          <size width="90" height="18"/>
          <text color="dark_8" align="left" weight="" size="15" action="get_text KEY"/>
        </button>
        <!-- key -->
        <textzone action="key_match_button" rightclick="key_match_menu">
          <pos x="+0" y="+17"/>
          <size width="90" height="30"/>
          <text size="36" color="`deck [DECK] masterdeck ? color 'orange' : get_key_color`" align="left" weight="bold" action="get_key"/>
        </textzone>
        <!-- key modifier -->
        <button action="get_key_modifier_text">
          <pos x="+15" y="+48"/>
          <size width="50" height="20"/>
          <off color="black" border="dark_8" border_size="1" radius="4"/>
          <text size="20" color="dark_8" align="center" weight="" text="+0"/>
        </button>
      </group>
    </group>
    <!-- time -->
    <group x="+200">
      <!-- outline -->
      <visual shape="square" width="98" height="[HEIGHT]">
        <off color="transparent" border="dark_5" border_size="1"/>
      </visual>
      <!-- label -->
      <group x="+10" y="+1">
        <textzone action="cycle '@$dd_time_display_mode' 3" tooltip="">
          <size width="90" height="18"/>
          <text color="dark_8" align="left" weight="" size="15" action="var_equal '@$dd_time_display_mode' 0 ? get_text 'ELAPSED' : var_equal '@$dd_time_display_mode' 1 ? get_text 'REMAIN' : var_equal '@$dd_time_display_mode' 2 ? get_text 'TIME'"/>
        </textzone>
        <!-- time -->
        <textzone tooltip="">
          <pos x="+0" y="+15"/>
          <size width="90" height="27"/>
          <text color="white" align="left" size="32" weight="bold" action="var_equal '@$dd_time_display_mode' 0 ? get_time 'ELAPSED' : var_equal '@$dd_time_display_mode' 1 ? get_time 'REMAIN' : var_equal '@$dd_time_display_mode' 2 ? get_time 'TOTAL'"/>
        </textzone>
      </group>
    </group>
  </define>
  <define class="TRACK_INFO_STACK">
    <!-- title background -->
    <button x="+0" class="button_main" action="toggle '@dd_title_scroll'" rightclick="file_info" tooltip="Text Scroll\nRight-click: Tag Editor" width="479" height="124" coloroff="infos_background" coloron="infos_background" brcoloroff="panel_background" brcoloron="panel_background" bordersize="1"/>
    <group x="+4">
      <!-- title -->
      <textzone orientation="vertical" direction="ccw">
        <pos x="+0" y="+5"/>
        <size width="20" height="150"/>
        <text fontsize="16" weight="bold" color="needle" align="right" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
      <!-- remix -->
      <textzone orientation="vertical">
        <pos x="+15" y="+5"/>
        <size width="20" height="150"/>
        <text fontsize="12" weight="" color="#888888" align="right" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
      </textzone>
    </group>
    <!-- cover -->
    <cover rotate="no" visibility="1.0">
      <pos x="+40" y="+5"/>
      <size width="120" height="120"/>
    </cover>
  </define>
  <define class="TRACK_STEM_MODIFIERS">
    <!-- ACAPELLA/INSTRUMENTAL BUTTONS -->
    <group x="+0" y="+0">
      <!-- acapella -->
      <button action="stem_pad 'acapella'" border_size="1">
        <size width="135" height="23"/>
        <off color="#000000" border="#555555" radius="3"/>
        <down color="#222222" border="color_acapella" radius="3"/>
        <selected color="transparent" border="color_acapella" radius="3"/>
        <text fontsize="12" color="#888888" colorover="color_acapella" colorselected="color_acapella" colordown="color_acapella" align="center" text="ACAPELLA"/>
      </button>
      <!-- instrumental -->
      <button x="+140" action="stem_pad 'instrumental'" border_size="1">
        <size width="134" height="23"/>
        <off color="#111111" border="#555555" radius="3"/>
        <down color="#222222" border="color_instrumental" radius="3"/>
        <selected color="transparent" border="color_instrumental" radius="3"/>
        <text fontsize="12" color="#888888" colorover="color_instrumental" colorselected="color_instrumental" colordown="color_instrumental" align="center" text="INSTRUMENTAL"/>
      </button>
    </group>
    <group y="+30">
      <panel class="stem_button" x="+0" y="+0" stem="vocal" label="VOCAL" color="colorvocal"/>
      <panel class="stem_button" x="+70" y="+0" stem="instru" label="INSTR" color="colorinstru"/>
      <panel class="stem_button" x="+140" y="+0" stem="bass" label="BASS" color="colorbass"/>
      <panel class="stem_button" x="+210" y="+0" stem="rhythm" label="DRUM" color="colorbeat"/>
      <group y="+25">
        <group>
          <button class="stem_fx_button" stem="vocal"/>
          <button class="slot_fx_button" slot="vocals" x="+33"/>
        </group>
        <group x="+70">
          <button class="stem_fx_button" stem="instru"/>
          <button class="slot_fx_button" slot="instru" x="+33"/>
        </group>
        <group x="+140">
          <button class="stem_fx_button" stem="bass"/>
          <button class="slot_fx_button" slot="bass" x="+33"/>
        </group>
        <group x="+210">
          <button class="stem_fx_button" stem="rhythm"/>
          <button class="slot_fx_button" slot="rhythm" x="+33"/>
        </group>
      </group>
      <group y="+46">
        <panel class="stem_volume_slider" x="+0" stem="vocal" label="VOCAL" color="colorvocal"/>
        <panel class="stem_volume_slider" x="+70" stem="instru" label="INSTR" color="colorinstru"/>
        <panel class="stem_volume_slider" x="+140" stem="bass" label="BASS" color="colorbass"/>
        <panel class="stem_volume_slider" x="+210" stem="rhythm" label="DRUM" color="colorbeat"/>
      </group>
    </group>
  </define>
  <define class="TRACK_MODIFIERS_PANEL" placeholders="*mirror=false">
    <group visibility="loaded" x="+0" y="+20">
      <!-- NO STEMS ALERT -->
      <group visibility="not has_stems" y="+30">
        <textzone class="text" width="300" height="48" fontsize="10" color="textdarker" align="center" weight="" text="STEMS NOT FOUND"/>
      </group>
      <!-- STEM BUTTONS -->
      <group x="+5" y="+5" visibility="has_stems" condition="not [MIRROR]">
        <panel class="track_stem_modifiers"/>
      </group>
      <group x="+265" y="+5" visibility="has_stems" condition="[MIRROR]">
        <panel class="track_stem_modifiers"/>
      </group>
      <!-- MODIFIERS -->
      <panel>
        <pos x="+292" y="+5" condition="not [MIRROR]"/>
        <pos x="+0" y="+5" condition="[MIRROR]"/>
        <!-- STATUS: COLORFX -->
        <group>
          <button width="80" height="19" action="effect_disable_all 'colorfx'" query="effect_active 'colorfx'" border_size="1">
            <off color="#000000"/>
            <selected color="color_colorfx"/>
            <text dx="+10" fontsize="12" color="#AAAAAA" colorselected="black" align="left" text="COLOR FX"/>
          </button>
          <button x="+82" width="165" height="19" action="effect_disable_all 'colorfx'" query="effect_active colorfx" border_size="1">
            <off color="#000000"/>
            <selected color="#222222" textcolor="color_colorfx" border="#333333"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="color_colorfx" align="left" action="filter_label"/>
          </button>
        </group>
        <!-- STATUS: PADFX -->
        <group y="+22">
          <button width="80" height="19" action="effect_disable_all &amp; effect_disable_all 'sampler'" border_size="1" query="effects_used 'padfx'">
            <off color="#000000"/>
            <selected color="color_padfx"/>
            <text dx="+10" fontsize="12" color="#AAAAAA" colorselected="#333333" align="left" text="PAD FX"/>
          </button>
          <button x="+82" width="165" height="19" action="effect_disable_all 'padfx'" query="effects_used 'padfx'" border_size="1">
            <off color="#000000"/>
            <selected color="#222222" textcolor="color_padfx" border="#333333"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="color_padfx" align="left" action="get_text '`get_effects_used` ACTIVE'"/>
          </button>
        </group>
        <!-- STATUS: SAMPLER -->
        <group y="+44">
          <button width="80" height="19" action="sampler_stop" border_size="1" query="sampler_play_stop">
            <off color="#000000"/>
            <selected color="color_sampler"/>
            <text dx="+10" fontsize="12" color="#AAAAAA" colorselected="black" align="left" text="SAMPLER"/>
          </button>
          <button x="+82" width="165" height="19" action="sampler_stop" query="sampler_play_stop" border_size="1">
            <off color="#000000"/>
            <selected color="#222222" textcolor="color_sampler" border="#333333"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="color_sampler" align="left" action="get_sample_name"/>
          </button>
        </group>
        <!-- STATUS: LOOPER -->
        <group y="+66">
          <button class="button_main" width="32" height="19" action="loop ? loop : nothing" query="loop ? blink 500ms : off" sysicon="sampler_loop" iconsize="16" coloroff="#000000" coloron="#000000" brcoloroff="#000000" brcoloron="#2aa8ff" bordersize="1" textcolor="#555555" textcoloron="#2aa8ff" tooltip="Loop"/>
          <button x="+32" width="48" height="19" action="loop ? loop : nothing" border_size="1" query="loop">
            <off color="#000000"/>
            <selected color="#000000" border="#2aa8ff"/>
            <text dx="+7" fontsize="12" color="#AAAAAA" colorselected="#2aa8ff" align="left" text="LOOP"/>
          </button>
          <button x="+82" width="165" height="19" action="loop ? loop : nothing" border_size="1" query="loop">
            <off color="#000000"/>
            <selected color="#222222" textcolor="#2aa8ff" border="#2aa8ff"/>
            <text dx="+10" fontsize="12" color="#555555" colorselected="#2aa8ff" align="left" action="get_text '`get_loop` ACTIVE'"/>
          </button>
        </group>
      </panel>
    </group>
  </define>
</defs>
