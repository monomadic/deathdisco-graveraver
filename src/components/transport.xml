<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="TRANSPORT_STACK">
    <!-- sync column: the Pro transport bar's actions (TRANSPORT_BAR below), with BEAT and PHRASE merged into SYNC -->
    <group y="+5" visibility="loaded">
      <!-- KEY -->
      <button class="button_main" x="+0" y="+0" action="select &amp; match_key" query="loaded ? match_key ? true : blink 1bt" visibility="not masterdeck" bordersize="1">
        <size width="60" height="31"/>
        <off color="#330000" border="#FF0000" radius="3"/>
        <over color="#1c1c1c" border="deckcolor" radius="3"/>
        <down color="#222222" border="deckcolor" radius="3"/>
        <selected color="transparent" border="deckcolor" radius="3"/>
        <text fontsize="12" color="#FF0000" colorover="deckcolor" colorselected="deckcolor" colordown="deckcolor" align="center" text="KEY"/>
      </button>
      <button class="button_main" x="+0" y="+0" action="select &amp; match_key" visibility="masterdeck" bordersize="1">
        <size width="60" height="31"/>
        <off color="#000000" border="color_masterdeck" radius="3"/>
        <over color="#1c1c1c" border="color_masterdeck" radius="3"/>
        <down color="#222222" border="color_masterdeck" radius="3"/>
        <selected color="transparent" border="color_masterdeck" radius="3"/>
        <text fontsize="12" color="color_masterdeck" colorover="color_masterdeck" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="KEY"/>
      </button>
      <!-- SYNC: beat + phrase sync to the master; on the master deck, sync every other deck to it -->
      <button class="button_main" x="+0" y="+35" action="select &amp; var_equal '$phrase_len' 16 ? phrase_sync 16 &amp; sync : phrase_sync 32 &amp; sync" query="is_sync '`$phrase_len`' ? on : blink 1bt" visibility="not masterdeck" bordersize="1">
        <size width="60" height="31"/>
        <off color="#330000" border="#FF0000" radius="3"/>
        <over color="#1c1c1c" border="deckcolor" radius="3"/>
        <down color="#222222" border="deckcolor" radius="3"/>
        <selected color="transparent" border="deckcolor" radius="3"/>
        <text fontsize="12" color="#FF0000" colorover="deckcolor" colorselected="deckcolor" colordown="deckcolor" align="center" text="SYNC"/>
      </button>
      <button class="button_main" x="+0" y="+35" action="select &amp; action_deck 1 ? deck 2 sync &amp; deck 3 sync &amp; deck 4 sync : action_deck 2 ? deck 1 sync &amp; deck 3 sync &amp; deck 4 sync : action_deck 3 ? deck 1 sync &amp; deck 2 sync &amp; deck 4 sync : deck 1 sync &amp; deck 2 sync &amp; deck 3 sync" query="loaded" visibility="masterdeck" bordersize="1">
        <size width="60" height="31"/>
        <off color="#330000" border="#FF0000" radius="3"/>
        <over color="#1c1c1c" border="color_masterdeck" radius="3"/>
        <down color="#222222" border="color_masterdeck" radius="3"/>
        <selected color="transparent" border="color_masterdeck" radius="3"/>
        <text fontsize="12" color="#FF0000" colorover="color_masterdeck" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="SYNC"/>
      </button>
      <!-- MASTER: dimmed unless this deck is the master -->
      <button class="button_main" x="+0" y="+70" action="select &amp; masterdeck" bordersize="2" query="masterdeck">
        <size width="60" height="31"/>
        <off color="#000000" border="dark_5" border_size="1" shape="square" radius="3"/>
        <over color="#402900" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
        <down color="#000000" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
        <selected color="color_masterdeck" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
        <text size="11" dx="+0" action="masterdeck ? masterdeck_auto ? get_text 'AUTO' : get_text 'MASTER' : get_text 'MASTER'" color="#555555" colorselected="black" colorover="color_masterdeck" colordown="color_masterdeck" align="center"/>
      </button>
    </group>
    <!-- play: Pro transport-bar look (outlined, deck / master coloured icon, blinks while playing) -->
    <button class="button_main" x="+0" y="+110" textsize="11" width="60" height="49" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" tooltip="Play / Pause\nRight-click: First Beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0">
      <off color="transparent" border="dark_4" border_size="1" shape="square" radius="4"/>
      <over color="#1c1c1c" border="dark_4" border_size="1" shape="square" radius="4"/>
      <down color="transparent" border="dark_4" border_size="1" shape="square" radius="4"/>
      <selected color="transparent" border="dark_4" border_size="1" radius="4"/>
    </button>
    <button class="button_main" x="+0" y="+110" textsize="11" width="60" height="49" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" tooltip="Play / Pause\nRight-click: First Beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0" visibility="not masterdeck ? play ? blink 1bt : on">
      <off color="transparent" border="deckcolor" border_size="1" shape="square" radius="4"/>
      <over color="#1c1c1c" border="deckcolor" border_size="1" shape="square" radius="4"/>
      <down color="#222222" border="dark_4" border_size="1" shape="square" radius="4"/>
      <selected color="transparent" border="deckcolor" border_size="2" radius="4"/>
      <icon coloroff="deckcolor" colorover="#FFFFFF" colordown="#FFFFFF" colorselected="deckcolor"/>
    </button>
    <button class="button_main" x="+0" y="+110" textsize="11" width="60" height="49" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" tooltip="Play / Pause\nRight-click: First Beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0" visibility="masterdeck ? play ? blink 1bt : on">
      <off color="transparent" border="color_masterdeck" border_size="1" shape="square" radius="4"/>
      <over color="#1c1c1c" border="color_masterdeck" border_size="1" shape="square" radius="4"/>
      <down color="#222222" border="dark_4" border_size="1" shape="square" radius="4"/>
      <selected color="transparent" border="color_masterdeck" border_size="2" radius="4"/>
      <icon coloroff="color_masterdeck" colorover="#FFFFFF" colordown="#FFFFFF" colorselected="color_masterdeck"/>
    </button>
  </define>
  <define class="TRANSPORT_BAR" placeholders="*deck,*deckside">
    <deck deck="[DECK]">
      <visual class="gfx_shape" x="+0" y="+0" width="765" height="40" coloroff="black" radius="6"/>
      <line x="+0" y="+0" width="765" height="2" highlight="dark_6" shadow="transparent"/>
      <!-- SONGPOS -->
      <group visibility="loaded">
        <pos x="+6" y="+6" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
        <pos x="+450" y="+6" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
        <songpos class="songpos" x="+3" y="+3" width="304" height="21" colorPlayed="deckcolor"/>
        <!-- border -->
        <visual width="310" height="27">
          <off shape="square" color="transparent" border_size="1" border="#555555" radius="4"/>
        </visual>
      </group>
      <!-- SYNC BUTTONS -->
      <group visibility="loaded">
        <pos x="+325" y="+7" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
        <pos x="+115" y="+7" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
        <!-- KEY BUTTON -->
        <button class="button_main" action="select &amp; match_key" bordersize="1" query="loaded ? match_key ? true : blink 1bt" visibility="not masterdeck">
          <pos x="+0" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
          <pos x="+82*3" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
          <size width="80" height="25"/>
          <off color="#330000" border="#FF0000" radius="3"/>
          <down color="#222222" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="#FF0000" colorselected="deckcolor" colordown="deckcolor" align="center" text="KEY"/>
        </button>
        <!-- KEY BUTTON: masterdeck -->
        <button class="button_main" action="select &amp; match_key" bordersize="1" visibility="masterdeck">
          <pos x="+0" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
          <pos x="+82*3" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
          <size width="80" height="25"/>
          <off color="#000000" border="color_masterdeck" radius="3"/>
          <down color="#222222" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="color_masterdeck" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="KEY"/>
        </button>
        <!-- BEAT BUTTON -->
        <button class="button_main" action="select &amp; sync" bordersize="1" query="loaded ? is_sync ? true : blink 1bt" visibility="not masterdeck">
          <pos x="+82*1" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
          <pos x="+82*2" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
          <size width="80" height="25"/>
          <off color="#330000" border="#FF0000" radius="3"/>
          <down color="#222222" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="#FF0000" colorselected="deckcolor" colordown="deckcolor" align="center" text="BEAT"/>
        </button>
        <!-- BEAT BUTTON (master) -->
        <button class="button_main" action="select &amp; action_deck 1 ? deck 2 sync &amp; deck 3 sync &amp; deck 4 sync : action_deck 2 ? deck 1 sync &amp; deck 3 sync &amp; deck 4 sync : action_deck 3 ? deck 1 sync &amp; deck 2 sync &amp; deck 4 sync : deck 1 sync &amp; deck 2 sync &amp; deck 3 sync" bordersize="1" query="loaded" visibility="masterdeck">
          <pos x="+82*1" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
          <pos x="+82*2" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
          <size width="80" height="25"/>
          <off color="#330000" border="#FF0000" radius="3"/>
          <down color="#222222" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="#FF0000" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="BEAT"/>
        </button>
        <!-- PHRASE BUTTON -->
        <button class="button_main" x="+0" action="select &amp; var_equal '$phrase_len' 16 ? phrase_sync 16 &amp; sync : phrase_sync 32 &amp; sync" bordersize="1" query="is_sync '`$phrase_len`' ? on : blink 1bt" visibility="not masterdeck">
          <pos x="+82*2" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
          <pos x="+82*1" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
          <size width="80" height="25"/>
          <off color="#440000" border="#FF3333" radius="3"/>
          <down color="#222222" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="#FF3333" colorselected="deckcolor" colordown="deckcolor" align="center" action="get_text 'PHRASE `var_equal $phrase_len 32 ? 32 : 16`'"/>
        </button>
        <button class="button_main" x="+0" action="sync &amp; phrase_sync 32" bordersize="1" query="loaded" visibility="masterdeck">
          <pos x="+82*2" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
          <pos x="+82*1" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
          <size width="80" height="25"/>
          <off color="#111111" border="#333333" radius="3"/>
          <down color="#222222" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="#333333" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="PHRASE"/>
        </button>
        <!-- MASTER/SLAVE BUTTON -->
        <button class="button_main" action="select &amp; masterdeck" textcolor="deckcolor" bordersize="2" query="masterdeck" visibility="loaded">
          <pos x="+82*3" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
          <pos x="+0" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
          <size width="80" height="25"/>
          <off color="#000000" border="deckcolor" border_size="1" shape="square" radius="3"/>
          <down color="#000000" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
          <selected color="color_masterdeck" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
          <text size="11" dx="+0" action="masterdeck ? masterdeck_auto ? get_text 'AUTO' : get_text 'MASTER' : get_text 'SLAVE'" colorselected="black" coloron="orange" colorover="white" colordown="orange" align="center"/>
        </button>
      </group>
      <!-- PLAY/PAUSE BUTTON -->
      <line color="dark_5" x="+800-140" y="+2" width="1" height="38" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
      <line color="dark_5" x="+105" y="+2" width="1" height="38" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
      <!-- not master -->
      <button class="button_main" textsize="11" width="100" height="38" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0">
        <pos x="+800-140" y="+0" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
        <pos x="+2" y="+0" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
        <off color="transparent" border="transparent" border_size="0" shape="square" radius="4" iconcolor="blue"/>
        <over color="transparent" border="transparent" border_size="0" shape="square" radius="4"/>
        <down color="transparent" border="transparent" border_size="0" shape="square" radius="4"/>
        <selected color="transparent" border="transparent" border_size="1" radius="4"/>
      </button>
      <button class="button_main" textsize="11" width="102" height="38" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0" visibility="not masterdeck ? play ? blink 1bt : on">
        <pos x="+800-140" y="+0" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
        <pos x="+2" y="+0" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
        <off color="transparent" border="#444444" border_size="0" shape="square" radius="4"/>
        <over color="transparent" border="deckcolor" border_size="1" shape="square" radius="4"/>
        <down color="transparent" border="dark_4" border_size="0" shape="square" radius="4"/>
        <selected color="transparent" border="deckcolor" border_size="2" radius="4"/>
        <icon coloroff="deckcolor" colorover="deckcolor" colordown="#FFFFFF" colorselected="deckcolor"/>
      </button>
      <button class="button_main" textsize="11" width="100" height="38" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" colorselected="red" bordersize="0" visibility="masterdeck ? play ? blink 1bt : on">
        <pos x="+800-140" y="+0" condition="param_equal '[DECKSIDE]' 'leftdeck'"/>
        <pos x="+2" y="+0" condition="param_equal '[DECKSIDE]' 'rightdeck'"/>
        <off color="transparent" border="color_masterdeck" border_size="0" shape="square" radius="4" iconcolor="blue"/>
        <over color="transparent" border="color_masterdeck" border_size="1" shape="square" radius="4"/>
        <down color="transparent" border="#888888" border_size="0" shape="square" radius="4"/>
        <selected color="transparent" border="color_masterdeck" border_size="2" radius="4"/>
        <icon coloroff="color_masterdeck" colorover="color_masterdeck" colordown="#888888" colorselected="color_masterdeck"/>
      </button>
    </deck>
  </define>
</defs>
