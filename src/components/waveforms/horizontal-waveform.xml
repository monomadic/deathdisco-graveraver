<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="HORIZONTAL_WAVEFORM_TRACK_INFO" placeholders="*deck,*height,fullheight=[HEIGHT]*2-4">
    <deck deck="[DECK]">
      <!-- TRACK INFO -->
      <!-- === LEFT DECK WAVEFORM TRACK INFO === -->
      <group x="+34" y="+0" visibility="get_deck 1 ? true : get_deck 3 ? true : false">
        <!-- BG -->
        <square x="+0" y="+0" height="[FULLHEIGHT]" width="[FULLHEIGHT]+40" color="#CC000000"/>
        <!-- black fallback -->
        <button width="[FULLHEIGHT]" height="[FULLHEIGHT]" action="play_button" coloroff="#333333" textcolor="white">
          <off color="black" border="#222222" border_size="4" shape="square"/>
          <over color="black" border="white" border_size="4" shape="square"/>
          <icon dx="+3" sysicon="arrowright" color="#777777" colordown="white" colorselected="white" colorover="white" width="40" height="40"/>
        </button>
        <!-- cover placeholder -->
        <group novisibility="loaded" x="+5" y="+5">
          <visual type="circle">
            <size width="[FULLHEIGHT]-10" height="[FULLHEIGHT]-10"/>
            <off shape="circle" color="dark_3" border="dark_2" border_size="60"/>
          </visual>
          <visual type="circle">
            <size width="[FULLHEIGHT]-10" height="[FULLHEIGHT]-10"/>
            <off shape="circle" color="dark_0" border="transparent" border_size="88"/>
          </visual>
        </group>
        <!-- cover -->
        <cover visibility="loaded" action="" rightclick="" dblclick="">
          <pos x="+0" y="+0"/>
          <size width="[FULLHEIGHT]" height="[FULLHEIGHT]"/>
        </cover>
        <!-- TRACK INFO -->
        <!-- TITLE -->
        <textzone orientation="vertical" direction="ccw">
          <pos x="+[FULLHEIGHT]+5" y="+2"/>
          <size width="20" height="[FULLHEIGHT]-6"/>
          <text fontsize="16" weight="bold" color="needle" align="right" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <!-- REMIX -->
        <textzone orientation="vertical">
          <pos x="+[FULLHEIGHT]+20" y="+4"/>
          <size width="20" height="[FULLHEIGHT]-6"/>
          <text fontsize="12" weight="" color="#888888" align="right" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <!-- play button overlay -->
        <button action="select &amp; play_button" visibility="loaded ? play ? blink 500ms : on : off" query="loaded ? play">
          <size width="[FULLHEIGHT]" height="[FULLHEIGHT]"/>
          <off shape="square" color="transparent" border="#22FFFFFF" border_size="4"/>
          <over shape="square" color="transparent" border="#88FFFFFF" border_size="4"/>
          <on shape="square" color="transparent" border="#11FFFFFF" border_size="10"/>
          <icon sysicon="play" width="[HEIGHT]*0.9" height="[HEIGHT]*0.9" coloroff="#33888888" colorselected="white" colorover="white" coloron="white ? blink 500ms"/>
        </button>
        <!-- PRO: HORIZONTAL WAVEFORM: COVER BORDER -->
        <visual source="select" x="+0" y="+0" visibility="var_equal '@$dd_bordermode' 1">
          <size width="[FULLHEIGHT]+40" height="[FULLHEIGHT]"/>
          <down color="transparent" border_size="1" border="#66FFFFFF" shape="square" radius="4"/>
        </visual>
      </group>
      <group x="1920-[FULLHEIGHT]-27-40" y="-[HEIGHT]" visibility="get_deck 2 ? true : get_deck 4 ? true : false">
        <!-- BG -->
        <square x="+0" y="+0" height="[FULLHEIGHT]" width="[FULLHEIGHT]+40" color="#CC000000"/>
        <!-- black fallback -->
        <button x="+40" width="[FULLHEIGHT]" height="[FULLHEIGHT]" action="play_button" coloroff="#333333" textcolor="white">
          <off color="black" border="#222222" border_size="4" shape="square"/>
          <over color="black" border="white" border_size="4" shape="square"/>
          <icon dx="+3" sysicon="arrowright" color="#777777" colordown="white" colorselected="white" colorover="white" width="40" height="40"/>
        </button>
        <!-- cover placeholder -->
        <group novisibility="loaded" x="+45" y="+5">
          <visual type="circle">
            <size width="[FULLHEIGHT]-10" height="[FULLHEIGHT]-10"/>
            <off shape="circle" color="dark_3" border="dark_2" border_size="60"/>
          </visual>
          <visual type="circle">
            <size width="[FULLHEIGHT]-10" height="[FULLHEIGHT]-10"/>
            <off shape="circle" color="dark_0" border="transparent" border_size="88"/>
          </visual>
        </group>
        <cover x="+40" visibility="loaded ? get_deck 2 ? true : get_deck 4 ? true : false" action="" rightclick="" dblclick="">
          <size width="[FULLHEIGHT]" height="[FULLHEIGHT]"/>
        </cover>
        <!-- TRACK INFO -->
        <!-- TITLE -->
        <textzone orientation="vertical">
          <pos x="+5" y="+2"/>
          <size width="20" height="[FULLHEIGHT]-6"/>
          <text fontsize="16" weight="bold" color="needle" align="right" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <!-- REMIX -->
        <textzone orientation="vertical">
          <pos x="+20" y="+4"/>
          <size width="20" height="[FULLHEIGHT]-6"/>
          <text fontsize="12" weight="" color="#888888" align="right" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
        </textzone>
        <!-- play button overlay -->
        <button x="+40" action="select &amp; play_button" visibility="loaded ? play ? blink 500ms : on : off" query="loaded ? play">
          <size width="[FULLHEIGHT]" height="[FULLHEIGHT]"/>
          <off shape="square" color="transparent" border="#22FFFFFF" border_size="4"/>
          <over shape="square" color="transparent" border="#88FFFFFF" border_size="4"/>
          <on shape="square" color="transparent" border="#11FFFFFF" border_size="10"/>
          <icon sysicon="play" width="[HEIGHT]*0.9" height="[HEIGHT]*0.9" coloroff="#33888888" colorselected="white" colorover="white" coloron="white ? blink 500ms"/>
        </button>
        <!-- PRO: HORIZONTAL WAVEFORM: COVER BORDER -->
        <visual source="select" x="+0" y="+0" visibility="var_equal '@$dd_bordermode' 1">
          <size width="[FULLHEIGHT]+40" height="[FULLHEIGHT]"/>
          <down color="transparent" border_size="1" border="#66FFFFFF" shape="square" radius="4"/>
        </visual>
      </group>
    </deck>
  </define>
  <!-- the main horizontal waveform used in flexible waves etc -->
  <define class="HORIZONTAL_MAIN_WAVEFORM" placeholders="*deck,*height">
    <deck deck="[DECK]">
      <group>
        <!-- LEFT WAVE -->
        <visual x="0" y="+0" width="1920" height="[HEIGHT]-20" visibility="leftdeck">
          <off shape="square" color="transparent" border_size="1" border="dark_4" radius="0"/>
        </visual>
        <!-- <scratchwave orientation="horizontal" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="leftdeck"> -->
        <!-- <pos x="0" y="+20"/> -->
        <!-- <size width="1920" height="[HEIGHT]-40"/> -->
        <!-- <grid height="10" pos="[HEIGHT]-40" maincolor="#888888" size="1" mainsize="1" phrasecolor="white" phrasesize="1" color="transparent" mirrored="false" shapepos="-14" shapemirrored="up"/> -->
        <!-- <gridlines width="1" color="gridlines" transparency="0.3"/> -->
        <!-- <cue y="-20"> -->
        <!-- <mask x="123" y="100" width="6" height="13"/> -->
        <!-- <text dx="+8" dy="-1" fontsize="12" important="true"/> -->
        <!-- </cue> -->
        <!-- </scratchwave> -->
        <scratchwave orientation="horizontal" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="leftdeck">
          <pos x="0" y="+0"/>
          <size width="1920" height="[HEIGHT]-20"/>
          <grid height="20" pos="[HEIGHT]-20" maincolor="#444444" size="1" mainsize="1" phrasecolor="white" phrasesize="1" color="transparent" mirrored="false" shapepos="-14" shapemirrored="down"/>
          <gridlines width="1" color="gridlines" transparency="0.3"/>
          <cue y="+[HEIGHT]-15">
            <mask x="123" y="100" width="6" height="14"/>
            <text dx="+8" dy="-1" fontsize="12" important="true"/>
          </cue>
        </scratchwave>
        <!-- RIGHT WAVE -->
        <!-- grid border: right -->
        <visual x="0" y="+20" width="1920" height="[HEIGHT]-20" visibility="rightdeck">
          <off shape="square" color="transparent" border_size="1" border="dark_4" radius="0"/>
        </visual>
        <!-- RIGHT: cue markers below -->
        <scratchwave orientation="horizontal" color="scratch1" color2="scratch2" colorVocal="colorVocal" colorInstru="colorInstru" colorBeat="colorBeat" colornoBeat="colorNoBeat" colornoInstru="colorNoInstru" colornovocal="colorNoVocal" visibility="rightdeck">
          <pos x="0" y="+20"/>
          <size width="1920" height="[HEIGHT]-20"/>
          <grid height="20" pos="-18" maincolor="#444444" size="1" mainsize="1" phrasecolor="white" phrasesize="1" color="transparent" mirrored="false" shapepos="-14" shapemirrored="up"/>
          <gridlines width="1" color="gridlines" transparency="0.3"/>
          <!-- y = below waveform: [HEIGHT] here is the scratchwave's own height in this context -->
          <cue y="-15">
            <mask x="123" y="100" width="6" height="13"/>
            <text dx="+8" dy="-1" fontsize="12" important="true"/>
          </cue>
        </scratchwave>
      </group>
      <dropzone>
        <pos x="+34" y="+0"/>
        <size width="1920-34-34" height="[HEIGHT]"/>
        <over color="transparent" border="color_dropzone" border_size="4" radius="10"/>
      </dropzone>
    </deck>
  </define>
</defs>
