  <!-- PERFORMANCE: VERTICAL: HOTCUE BUTTON -->
  <define class="HCUE_BUTTON_VERT" placeholders="*source">
    <!-- default background -->
    <button class="button_main" width="26" height="26" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" coloron="button_background" brcoloron="button_background"/>
    <!-- hotcue colored background -->
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE] ? constant 0.7">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="26" height="26"/>
    </visual>
    <!-- <button class="button_main" width="28" height="28" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" text="[SOURCE]" textcoloron="needle" textsize="13" coloroff="transparent" coloron="transparent" brcoloroff="transparent" brcoloron="transparent"/> -->
    <!-- text -->
    <button class="button_main" x="+31" width="145" height="26" action="hot_cue [SOURCE]" rightclick="cue_name [SOURCE]" query="on/off" coloroff="button_background3" coloron="button_background3" brcoloroff="button_background3" brcoloron="button_background3">
      <text align="left" dx="8" width="183" action="cue_display [SOURCE] &amp; param_uppercase" color="textoff2" colorselected="needle"/>
    </button>
    <!-- text -->
    <button x="+0" y="+0" width="26" height="26" action="hot_cue [SOURCE]" coloroff="cue_color [SOURCE]" textcolor="white">
      <off color="cue_color [SOURCE]"/>
      <over color="cue_color [SOURCE] ? constant 0.4"/>
      <icon dx="+2" sysicon="arrowright" color="white" colordown="white" colorselected="white" width="25" height="25"/>
    </button>
  </define>
