<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Extracted from components/buttons.xml; keep button-family definitions grouped by purpose. -->
  <define class="HOTCUE_BUTTON_STACK_PROGRESS" placeholders="*source,width=25,height=22">
    <button class="button_main" width="[WIDTH]" height="[HEIGHT]" action="hot_cue [SOURCE]" rightclick="delete_cue [SOURCE]" coloroff="button_background" coloron="button_background" bordersize="0"/>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE] ? constant 0.12">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </visual>
    <!-- Use a computed slider here because <visual source> is most reliable with built-in/get_* sources. -->
    <slider orientation="vertical" direction="up" source="param_div `cue_countup &amp; param_cast float` `param_add cue_countup cue_countdown &amp; param_cast float`" visibility="get_cue &amp; param_equal [SOURCE] ? constant 0.42 : false">
      <pos x="+1" y="+1"/>
      <size width="[WIDTH]-2" height="[HEIGHT]-2"/>
      <off shape="square" color="transparent" radius="4"/>
      <on shape="square" color="#66FFFFFF" radius="4"/>
    </slider>
  </define>
  <define class="BUTTON_MAIN" placeholders="width,height,text,textheight=height,important=true,textaction,coloroff=button_background,coloron=deckcolor,brcoloroff=button_background,brcoloron=deckcolor,bordersize=1,shape=square,icondx,sysicon,iconsize,textsize=12,textcolor=textoff,textcoloron=texton,align=center,orientation=horizontal,textscroll=no,textdx=0,textdy=0,radius">
    <size width="[WIDTH]" height="[HEIGHT]"/>
    <off color="[COLOROFF]" border="[BRCOLOROFF]" border_size="[BORDERSIZE]" shape="[SHAPE]" radius="[RADIUS]"/>
    <down color="[COLORON]" border="[BRCOLORON]" border_size="[BORDERSIZE]" shape="[SHAPE]"/>
    <selected color="[COLORON]" border="[BRCOLORON]" border_size="[BORDERSIZE]" shape="[SHAPE]"/>
    <text dx="[TEXTDX]" dy="[TEXTDY]" fontsize="[TEXTSIZE]" height="[TEXTHEIGHT]" weight="" color="[TEXTCOLOR]" colorselected="[TEXTCOLORON]" colordown="[TEXTCOLORON]" align="[ALIGN]" orientation="[ORIENTATION]" action="[TEXTACTION]" text="[TEXT]" localize="true" scroll="[TEXTSCROLL]" important="[IMPORTANT]"/>
    <icon dx="[ICONDX]" sysicon="[SYSICON]" color="[TEXTCOLOR]" colordown="[TEXTCOLORON]" colorselected="[TEXTCOLORON]" width="[ICONSIZE]" height="[ICONSIZE]"/>
  </define>
  <define class="TRANSPORT_BUTTON">
    <size width="42" height="42"/>
    <off radius="6" border_size="1" border="pro_panel_border" color="button_bg"/>
    <over radius="6" border_size="1" border="pro_panel_border" color="button_bg_over"/>
    <down radius="6" border_size="1" border="deck_accent" color="button_bg_on"/>
    <selected radius="6" border_size="1" border="deck_accent" color="button_bg_on"/>
  </define>
  <define class="button_main" placeholders="width,height,text,textheight=height,important=true,textaction,coloroff=button_background,coloron=deckcolor,brcoloroff=button_background,brcoloron=deckcolor,bordersize=1,shape=square,icondx,sysicon,iconsize,textsize=13,textcolor=textoff,textcoloron=texton,align=center,orientation=horizontal,textscroll=no" condition="var_equal '@$color_scheme' 4">
    <size width="[WIDTH]" height="[HEIGHT]"/>
    <off color="[COLOROFF]" border="[BRCOLOROFF]" border_size="[BORDERSIZE]" shape="[SHAPE]"/>
    <down color="[COLORON]" border="[BRCOLORON]" border_size="[BORDERSIZE]" shape="[SHAPE]"/>
    <selected color="[COLORON]" border="[BRCOLORON]" border_size="[BORDERSIZE]" shape="[SHAPE]"/>
    <text fontsize="[TEXTSIZE]" height="[TEXTHEIGHT]" weight="bold" color="[TEXTCOLOR]" colorselected="[TEXTCOLORON]" colordown="[TEXTCOLORON]" align="[ALIGN]" orientation="[ORIENTATION]" action="[TEXTACTION]" text="[TEXT]" localize="true" scroll="[TEXTSCROLL]" important="[IMPORTANT]"/>
    <icon dx="[ICONDX]" sysicon="[SYSICON]" color="[TEXTCOLOR]" colordown="[TEXTCOLORON]" colorselected="[TEXTCOLORON]" width="[ICONSIZE]" height="[ICONSIZE]"/>
  </define>
</defs>
