<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="DECK_SPINE" placeholders="*deck,*panelname,width=34,height=465,bgradius=0,buttonx=+5,buttony=+10,buttontextdx=-0,mastercolor=color_masterdeck,notmastercolor=deckcolor,menux=+5,menuy=+396">
    <!-- background -->
    <visual width="[WIDTH]" height="[HEIGHT]">
      <off shape="square" color="black" radius="[BGRADIUS]"/>
    </visual>
    <!-- deck number circle -->
    <group x="[BUTTONX]" y="[BUTTONY]">
      <group visibility="masterdeck">
        <button class="deck_button" visibility="masterdeck" color="[MASTERCOLOR]">
          <pos x="+0" y="+0"/>
          <text dx="[BUTTONTEXTDX]"/>
        </button>
      </group>
      <group visibility="not masterdeck">
        <button class="deck_button" visibility="not masterdeck" color="[NOTMASTERCOLOR]">
          <pos x="+0" y="+0"/>
          <text dx="[BUTTONTEXTDX]"/>
        </button>
      </group>
    </group>
    <!-- settings menu -->
    <menu class="menu_maindecks" query="select" x="+0" y="[HEIGHT]" width="[WIDTH]" height="[HEIGHT]"/>
    <!-- master deck label -->
    <group visibility="loaded ? masterdeck">
      <textzone orientation="vertical" direction="ccw">
        <pos x="+0" y="+35"/>
        <size width="34" height="105"/>
        <text fontsize="12" color="color_masterdeck" scroll="no" align="center" text="MASTER DECK" important="true"/>
      </textzone>
    </group>
  </define>
</defs>
