<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="DECK_SPINE" placeholders="*deck,*panelname,height=465,bgy=+0,bgradius=0,buttonx=+5,buttony=+10,buttontextdx=-0,mastercolor=color_masterdeck,notmastercolor=deckcolor,menux=+5,menuy=+396,menuwidth=34,menuheight=34,labeldirection=ccw,showmasterlabel=yes">
    <visual y="[BGY]" width="34" height="[HEIGHT]">
      <off shape="square" color="black" radius="[BGRADIUS]"/>
    </visual>
    <group x="[BUTTONX]" y="[BUTTONY]">
      <group visibility="masterdeck">
        <button class="deck_button" visibility="masterdeck" color="[MASTERCOLOR]">
          <pos x="+0" y="+0"/>
          <text dx="[BUTTONTEXTDX]"/>
        </button>
      </group>
      <group visibility="not masterdeck">
        <button class="deck_button" visibility="not masterdeck" color="[NOTMASTERCOLOR]">
          <pos x="+0" y="+0"/>
          <text dx="[BUTTONTEXTDX]"/>
        </button>
      </group>
    </group>
    <menu class="menu_maindecks" query="select" x="[MENUX]" y="[MENUY]" width="[MENUWIDTH]" height="[MENUHEIGHT]"/>
    <group visibility="loaded ? masterdeck" condition="param_equal [SHOWMASTERLABEL] 'yes'">
      <textzone orientation="vertical" direction="[LABELDIRECTION]">
        <pos x="+0" y="+35"/>
        <size width="34" height="105"/>
        <text fontsize="12" color="color_masterdeck" scroll="no" align="center" text="MASTER DECK" important="true"/>
      </textzone>
    </group>
  </define>
</defs>
