<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="PRO_DECKS_ABOVE">
    <panel class="area_waves"/>
    <panel class="pro_2decks" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="pro_4decks" condition="var_equal '@$hauntinglayout' 1"/>
    <!-- With waves above, the browser slot only depends on deck density.
         The browser class itself already handles the utility-bar offset. -->
    <browser class="haunting_browser_pro" height="170" condition="var_equal '@$hauntinglayout' 0"/>
    <browser class="haunting_browser_pro4decks" height="200" condition="var_equal '@$hauntinglayout' 1"/>
  </define>
  <define class="PRO_DECKS_BELOW">
    <panel class="pro_2decks" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="pro_4decks" condition="var_equal '@$hauntinglayout' 1"/>
    <panel class="area_waves" y="+450" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="area_waves" y="+450+450" condition="var_equal '@$hauntinglayout' 1"/>
    <!-- Keep the browser decision at the bottom of the composition:
         only the 2-deck slot changes when the utility bar is shown. -->
    <group name="browser_slot">
      <browser class="haunting_browser_pro" height="200" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 0"/>
      <browser class="haunting_browser_pro" height="250" condition="var_equal '@$hauntinglayout' 0 ? var_equal '@$hauntingutilitybar' 1"/>
      <browser class="haunting_browser_pro4decks" height="200" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
  <define class="PROMINI_DECKS_ABOVE">
    <panel class="area_waves"/>
    <panel class="pro_2decks_mini" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="pro_4decks_mini" condition="var_equal '@$hauntinglayout' 1"/>
    <group name="no_utility_bar" condition="var_equal '@$hauntingutilitybar' 0">
      <browser class="haunting_browser_promini" height="1080-98-2-2-2-1" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="haunting_browser_promini4decks" height="1080-98-2-2-2-1-98-2" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
    <group name="utility_bar" condition="var_equal '@$hauntingutilitybar' 1">
      <browser class="haunting_browser_promini" height="1080-98-2-2-2-1-38" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="haunting_browser_promini4decks" height="1080-98-2-2-2-1-98-2-38" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
  <define class="PROMINI_DECKS_BELOW">
    <panel class="pro_2decks_mini" y="+0" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="pro_4decks_mini" y="+0" condition="var_equal '@$hauntinglayout' 1"/>
    <panel class="area_waves" y="+99+2" condition="var_equal '@$hauntinglayout' 0"/>
    <panel class="area_waves" y="+99+2+98+2" condition="var_equal '@$hauntinglayout' 1"/>
    <group name="no_utility_bar" condition="var_equal '@$hauntingutilitybar' 0">
      <browser class="haunting_browser_promini" height="1080-98-2-2-2-1" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="haunting_browser_promini4decks" height="1080-98-2-2-2-1-98-2" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
    <group name="utility_bar" condition="var_equal '@$hauntingutilitybar' 1">
      <browser class="haunting_browser_promini" height="1080-98-2-2-2-1-38" condition="var_equal '@$hauntinglayout' 0"/>
      <browser class="haunting_browser_promini4decks" height="1080-98-2-2-2-1-98-2-38" condition="var_equal '@$hauntinglayout' 1"/>
    </group>
  </define>
</defs>
