    <panel class="area_deck_performance_side" x="+960" panelname="deck2" deck="2" deckside="right" visibility="deck 2 rightdeck"/>
    <panel class="area_deck_performance_side" x="+960" panelname="deck4" deck="4" deckside="right" visibility="deck 4 rightdeck"/>
