      <panel class="browser_overlay_plain" x="0" y="+43+100+2+98+2" width="1920" height="1080-43-2-100-2-98-2-38" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 1"/>
      <panel class="browser_overlay_plain" x="0" y="+43+100+2+98+2" width="1920" height="1080-43-2-100-2-98-2" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 0"/>
