  <define class="PRO_DECKS_NO_WAVES">
    <panel class="pro_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="pro_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <panel class="browser_overlay_plain" y="+432+2" width="1920" height="1080-432-2-2-38" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 1"/>
    <panel class="browser_overlay_plain" y="+432+2" width="1920" height="1080-432-2-2" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 0"/>
    <panel class="browser_overlay_plain" y="+432+2+216+2" width="1920" height="1080-432-2-2-216-2-38" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 1"/>
    <panel class="browser_overlay_plain" y="+432+2+216+2" width="1920" height="1080-432-2-2-216-2" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 0"/>
  </define>
  <define class="PROMINI_DECKS_NO_WAVES">
    <panel class="pro_2decks_mini" y="+0" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="pro_4decks_mini" y="+0" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <panel class="browser_overlay_plain" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 1"/>
    <panel class="browser_overlay_plain" y="+98" width="1920" height="1080-46-100-2" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 0"/>
    <panel class="browser_overlay_plain" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 1"/>
    <panel class="browser_overlay_plain" y="+100+100" width="1920" height="1080-50-100-100" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 0"/>
  </define>
  <!-- These Performance layout shells are selected by @$layout_4deck: 0 = two-deck / swap, 1 = full four-deck -->
  <define class="PERFORMANCE_MAIN_RACKS" placeholders="offset_y=0">
    <panel class="racks_extended" x="+2" y="[OFFSET_Y]" condition="var_equal '@$hide_main_waveforms' 0"/>
    <panel class="racks_single" x="+2" y="[OFFSET_Y]" condition="var_equal '@$hide_main_waveforms' 1"/>
  </define>
  <!-- Browser-zoom mini layouts can optionally keep rack surfaces visible.
       @$show_zoom_racks stays as the single runtime switch, while this
       helper keeps the layout shell from repeating that branch inline. -->
  <define class="PERFORMANCEMINI_RACKS" placeholders="vertical_y=0,mini_y=0">
    <group name="mini_racks_visible" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="racks_vertical" x="+2" y="[VERTICAL_Y]" condition="var_equal '@$hide_zoom_waveforms' 1"/>
      <panel class="racks_mini" x="+2" y="[MINI_Y]" condition="var_equal '@$hide_zoom_waveforms' 0"/>
    </group>
  </define>
  <define class="PERFORMANCE_2DECKS" placeholders="*panelname">
    <!-- Wave-size offset ladder extracted to keep the shell readable -->
    <xi:include href="positions/performance-2decks.xml" xpointer="xpointer(/positions/*)"/>
