    <group name="with_zoom_racks" condition="var_equal '@$show_zoom_racks' 1">
      <group name="utility_bar_hidden" condition="var_equal '@$show_utility_bar' 0">
        <panel class="browser_overlay_with_racks" x="0" y="+98+2" width="1920" height="1080-43-2-98-2-2" condition="var_equal '@$layout_4deck' 0"/>
        <panel class="browser_overlay_with_racks" x="0" y="+98+2+98+2" width="1920" height="1080-43-2-98-2-2-98-2" condition="var_equal '@$layout_4deck' 1"/>
      </group>
      <group name="utility_bar_visible" condition="var_equal '@$show_utility_bar' 1">
        <panel class="browser_overlay_with_racks" x="0" y="+98+2" width="1920" height="1080-43-2-98-2-2-38" condition="var_equal '@$layout_4deck' 0"/>
        <panel class="browser_overlay_with_racks" x="0" y="+98+2+98+2" width="1920" height="1080-43-2-98-2-2-98-2-38" condition="var_equal '@$layout_4deck' 1"/>
      </group>
    </group>
  </define>
  <!-- Stack keeps the same deck-density switch: @$layout_4deck 0 = two-deck / swap, 1 = full four-deck -->
  <define class="STACK_2DECKS" placeholders="*panelname">
    <panel class="area_deck_stack" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="area_deck_stack" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="area_deck_stack" y="+164+2" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="area_deck_stack" y="+164+2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
    <!-- racks -->
    <panel class="racks_stack"/>
  </define>
  <define class="STACK_4DECKS" placeholders="*panelname">
    <group name="1234" visibility="setting 'mixerOrder' '1234'">
      <panel class="area_deck_stack" panelname="deck1" deck="1"/>
      <panel class="area_deck_stack" y="+164+2" panelname="deck2" deck="2"/>
      <panel class="area_deck_stack" y="+164+2+164+2" panelname="deck3" deck="3"/>
      <panel class="area_deck_stack" y="+164+2+164+2+164+2" panelname="deck4" deck="4"/>
    </group>
    <group name="3124" visibility="setting 'mixerOrder' '3124'">
      <panel class="area_deck_stack" panelname="deck3" deck="3"/>
      <panel class="area_deck_stack" y="+164+2" panelname="deck1" deck="1"/>
      <panel class="area_deck_stack" y="+164+2+164+2" panelname="deck2" deck="2"/>
      <panel class="area_deck_stack" y="+164+2+164+2+164+2" panelname="deck4" deck="4"/>
    </group>
    <group name="1342" visibility="setting 'mixerOrder' '1342'">
      <panel class="area_deck_stack" panelname="deck1" deck="1"/>
      <panel class="area_deck_stack" y="+164+2" panelname="deck3" deck="3"/>
      <panel class="area_deck_stack" y="+164+2+164+2" panelname="deck4" deck="4"/>
      <panel class="area_deck_stack" y="+164+2+164+2+164+2" panelname="deck2" deck="2"/>
    </group>
    <panel class="racks_stack" y="+164+2+164+2"/>
  </define>
  <define class="STACK_DECKS">
    <panel class="stack_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="stack_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <group name="no_utility_bar" condition="var_equal '@$show_utility_bar' 0">
      <browser class="browser_stack" height="1080-164-60" condition="var_equal '@$layout_4deck' 0"/>
      <browser class="browser_stack_4decks" height="1080-164-330-60" condition="var_equal '@$layout_4deck' 1"/>
    </group>
    <group name="utility_bar" condition="var_equal '@$show_utility_bar' 1">
      <browser class="browser_stack" height="1080-260" condition="var_equal '@$layout_4deck' 0"/>
      <browser class="browser_stack_4decks" height="1080-260-260-70" condition="var_equal '@$layout_4deck' 1"/>
    </group>
  </define>
</defs>
