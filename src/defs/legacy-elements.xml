<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Embedded copies of select legacy defines to avoid fragile XPointer paths -->
  <define class="gfx_shape" placeholders="width,height,coloroff,coloron,bordercoloroff,bordercoloron,bordersize,radius=0,shape">
    <size width="[WIDTH]" height="[HEIGHT]"/>
    <off color="[COLOROFF]" border="[BORDERCOLOROFF]" border_size="[BORDERSIZE]" radius="[RADIUS]" shape="[SHAPE]"/>
    <on color="[COLORON]" border="[BORDERCOLORON]" border_size="[BORDERSIZE]" radius="[RADIUS]" shape="[SHAPE]"/>
  </define>
  <define class="transport_center">
    <button class="button_main" x="+0" y="+0" width="54" height="30" action="sync" text="SYNC" textcolor="textoff2"/>
    <button class="button_main" x="+54+8" y="+0" width="54" height="30" action="cue_button" textaction="cue_button" textcolor="textoff2"/>
    <button class="button_main" x="+54+8+54+8" y="+0" width="54" height="30" action="play_button" sysicon="play_button" iconsize="39" textcolor="textoff2"/>
  </define>
  <define class="textzone_title_artist_combo" placeholders="*x,*y,*width,*align,scroll=no,titlefontsize=20,artistfontsize=17,titleweight=,artistweight=,titlecolor=needle,artistcolor=deckcolor,titleaction=get_text '`get_title_before_remix` `get_remix_after_title`',artistaction=get_artist,titleheight=34,artistheight=28">
    <textzone tooltip="">
      <pos x="[X]" y="[Y]"/>
      <size width="[WIDTH]" height="[TITLEHEIGHT]"/>
      <text fontsize="[TITLEFONTSIZE]" weight="[TITLEWEIGHT]" color="[TITLECOLOR]" align="[ALIGN]" scroll="[SCROLL]" action="[TITLEACTION]" localize="true" important="true"/>
    </textzone>
    <textzone tooltip="">
      <pos x="[X]" y="[Y]+[TITLEHEIGHT]-6"/>
      <size width="[WIDTH]" height="[ARTISTHEIGHT]"/>
      <text fontsize="[ARTISTFONTSIZE]" weight="[ARTISTWEIGHT]" color="[ARTISTCOLOR]" align="[ALIGN]" scroll="[SCROLL]" action="[ARTISTACTION]" localize="true" important="true"/>
    </textzone>
  </define>
  <define class="text" action="[ACTION]" placeholders="action,width,height,fontsize,color,weight,align,text,textaction,scroll">
    <size width="[WIDTH]" height="[HEIGHT]"/>
    <text fontsize="[FONTSIZE]" color="[COLOR]" localize="true" weight="[WEIGHT]" align="[ALIGN]" text="[TEXT]" action="[TEXTACTION]" scroll="[SCROLL]" important="true"/>
  </define>
  <define class="key_display_left">
    <visual class="gfx_shape" width="128" height="80" coloroff="transparent"/>
    <button class="button_main" x="+16" y="+34" width="26" height="48-16" action="key_move -1" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" border="0" iconsize="22" sysicon="arrowleft"/>
    <textzone class="text" x="+26" y="+0" width="128-26-26" height="48" action="key_match_menu" fontsize="26" color="`get_key_color`" align="center" weight="bold" textaction="get_key"/>
    <button class="button_main" x="+128-26-12" y="+34" width="26" height="48-16" action="key_move +1" textcoloron="white" coloron="transparent" brcoloron="transparent" iconsize="22" sysicon="arrowright"/>
    <button class="button_main" action="key_match_button" width="100-26-26" height="16" x="+42" y="+42" coloroff="button_background" bordersize="0" textsize="12" textcolor="textdarker" textcoloron="black" textaction="get_key_modifier_text" visibility=""/>
    <visual type="square" x="+20" y="+40" width="10" height="10" color="red" visibility="not is_sync ? blink : false"/>
  </define>
  <define class="key_display_right">
    <visual class="gfx_shape" width="128" height="80" coloroff="transparent"/>
    <button class="button_main" x="+0" y="+8" width="26" height="48-16" action="key_move -1" coloroff="button_background" textcolor="textoff4" iconsize="22" sysicon="arrowleft"/>
    <textzone class="text" x="+26" y="+0" width="128-26-26" height="48" action="key_match_menu" fontsize="30" color="`get_key_color`" align="center" weight="bold" textaction="get_key"/>
    <button class="button_main" x="+128-26" y="+8" width="26" height="48-16" action="key_move +1" coloroff="button_background" textcolor="textoff4" iconsize="22" sysicon="arrowright"/>
  </define>
  <define class="DECK_BUTTON_LEFT" placeholders="*deck,*color">
    <button action="select">
      <pos x="+5" y="+5"/>
      <size width="35" height="50"/>
      <off shape="square" color="black" radius="5" border_size="1" border="black"/>
      <on shape="square" color="[COLOR]" radius="5" border_size="1" border="[COLOR]"/>
      <text dx="+1" dy="-5" align="center" size="35" action="get_deck" width="25" color="[COLOR]" colorselected="black"/>
    </button>
    <line visibility="select" x="+34" y="+0" width="1" height="433" color="[COLOR]"/>
  </define>
  <define class="hotcue_button_stack" placeholders="*source,width=25,height=25">
    <button class="button_main" width="[WIDTH]" height="[HEIGHT]" action="hot_cue [SOURCE]" rightclick="delete_cue [SOURCE]" coloroff="button_background" coloron="button_background" bordersize="0" textaction="get_text '[SOURCE]'" textheight="22" textcoloron="needle"/>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE] ? constant 0.12">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </visual>
    <visual type="color" source="cue_color [SOURCE]" visibility="cue_color [SOURCE]">
      <tooltip/>
      <pos x="+0" y="+0"/>
      <size width="[WIDTH]" height="[HEIGHT]"/>
    </visual>
  </define>
  <!-- Legacy-style transport bar (songpos + key/beat/phrase + master) -->
  <define class="TRANSPORT_BAR" placeholders="*deck,*deckside">
    <deck deck="[DECK]">
      <!-- Song position with framed background -->
      <group visibility="loaded">
        <pos x="+45" y="+6" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+460" y="+6" condition="param_equal [DECKSIDE] 'right'"/>
        <songpos class="songpos" x="+6" y="+6" width="290" height="12" colorPlayed="deckcolor"/>
        <visual width="300" height="24">
          <off shape="square" color="transparent" border_size="1" border="pro_panel_border" radius="4"/>
        </visual>
      </group>
      <!-- Key / Beat / Phrase / Master cluster -->
      <group visibility="loaded">
        <pos x="+365" y="+6" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+115" y="+6" condition="param_equal [DECKSIDE] 'right'"/>
        <!-- KEY -->
        <button class="button_main" action="select &amp; match_key" bordersize="1" query="match_key" visibility="not masterdeck">
          <pos x="+0" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*3" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="button_bg" border="pro_panel_border" radius="3"/>
          <down color="button_bg_over" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="pro_text_dim" colorselected="deckcolor" colordown="deckcolor" align="center" text="KEY"/>
        </button>
        <button class="button_main" action="select &amp; match_key" bordersize="1" query="match_key" visibility="masterdeck">
          <pos x="+0" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*3" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="button_bg" border="color_masterdeck" radius="3"/>
          <down color="button_bg_over" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="color_masterdeck" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="KEY"/>
        </button>
        <!-- BEAT -->
        <button class="button_main" action="select &amp; sync" bordersize="1" query="not play ? true : not is_sync ? blink 500ms : true" visibility="not masterdeck">
          <pos x="+82*1" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*2" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="button_bg" border="pro_panel_border" radius="3"/>
          <down color="button_bg_over" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="pro_text_dim" colorselected="deckcolor" colordown="deckcolor" align="center" text="BEAT"/>
        </button>
        <button class="button_main" action="select &amp; sync" bordersize="1" query="not play ? true : not is_sync ? blink 500ms : true" visibility="masterdeck">
          <pos x="+82*1" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*2" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="button_bg" border="pro_panel_border" radius="3"/>
          <down color="button_bg_over" border="color_masterdeck" radius="3"/>
          <selected color="transparent" border="color_masterdeck" radius="3"/>
          <text fontsize="12" color="pro_text_dim" colorselected="color_masterdeck" colordown="color_masterdeck" align="center" text="BEAT"/>
        </button>
        <!-- PHRASE -->
        <button class="button_main" x="+0" action="sync &amp; phrase_sync 32" bordersize="1" query="not playing ? true : is_sync ? true : false" visibility="masterdeck ? true : is_sync ? true : blink 500ms">
          <pos x="+82*2" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+82*1" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="button_bg" border="pro_panel_border" radius="3"/>
          <down color="button_bg_over" border="deckcolor" radius="3"/>
          <selected color="transparent" border="deckcolor" radius="3"/>
          <text fontsize="12" color="pro_text_dim" colorselected="deckcolor" colordown="deckcolor" align="center" text="PHRASE"/>
        </button>
        <!-- MASTER/SLAVE -->
        <button class="button_main" action="select &amp; masterdeck" textcoloron="orange" bordersize="2" query="masterdeck" visibility="loaded">
          <pos x="+82*3" condition="param_equal [DECKSIDE] 'left'"/>
          <pos x="+0" condition="param_equal [DECKSIDE] 'right'"/>
          <size width="80" height="25"/>
          <off color="button_bg" border="pro_panel_border" border_size="1" shape="square" radius="3"/>
          <down color="button_bg_over" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
          <selected color="color_masterdeck" border="color_masterdeck" border_size="1" shape="square" radius="3"/>
          <text size="11" action="masterdeck ? masterdeck_auto ? get_text 'AUTO' : get_text 'MASTER' : get_text 'SLAVE'" color="pro_text_dim" colorselected="black" align="center"/>
        </button>
      </group>
      <!-- Play/Pause (mirrored per deck side) -->
      <button class="button_main" textsize="11" width="80" height="25" action="select &amp; play_pause" query="play" rightclick="goto_first_beat" sysicon="play_button" iconsize="39" textcoloron="black" bordersize="0" visibility="loaded">
        <pos x="+365+82*4+10" y="+6" condition="param_equal [DECKSIDE] 'left'"/>
        <pos x="+15" y="+6" condition="param_equal [DECKSIDE] 'right'"/>
        <off color="button_bg" border="pro_panel_border" border_size="1" shape="square" radius="4"/>
        <over color="button_bg_over" border="pro_panel_border" border_size="1" shape="square" radius="4"/>
        <down color="button_bg_over" border="deckcolor" border_size="1" shape="square" radius="4"/>
        <selected color="deckcolor" border="deckcolor" border_size="1" shape="square" radius="4"/>
      </button>
    </deck>
  </define>
</defs>
