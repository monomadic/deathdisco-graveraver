<?xml version="1.0" encoding="UTF-8"?>
<globals>
  <!-- Runtime skin globals and environment defaults -->
  <!-- Deck state:
    @$dd_layout_4deck is the deck-density switch inside a mode: 0 = compact / swap, 1 = full 4-deck.
    @$dd_hide_pro_mixer selects the Pro variant: 0 = decks + center mixer, 1 = extended (decks fill, no center mixer).
    @$dd_hide_main_waveforms controls main-deck waveform visibility on the normal layout: 0 = show, 1 = hide.
    @$dd_hide_zoom_waveforms controls waveform visibility in browser-zoom / mini-deck mode: 0 = show, 1 = hide.
    @$dd_show_zoom_racks controls rack visibility in browser-zoom / mini-deck mode: 0 = hide, 1 = show.
  -->
  <font name="Helvetica Neue"/>
  <!-- The skin is built for the 4-deck engine only: its waveform and track-info
       visibility chains query decks 3/4, which alias onto real decks when the
       engine only has two. -->
  <nbdecks value="4"/>
  <tooltip size="15" color="dark_9" back="dark_2" shortcut="white" localize="true"/>
  <dialogs darkmode="true"/>
</globals>
