<?xml version="1.0" encoding="UTF-8"?>
<module xmlns:xi="http://www.w3.org/2001/XInclude">
  <panel name="main" visible="yes">
    <!-- BACKGROUND -->
    <!-- A <visual>, not a <square>: squares ignore skin breaklines, so a stretched window
         showed holes below y=1080 (confirmed with probes/wave-stretch). -->
    <visual x="0" y="0" width="1920" height="1080">
      <off shape="square" color="bg_main"/>
    </visual>
    <!-- WINDOW HANDLES -->
    <panel name="grabzones">
      <grabzone x="0" y="0" width="1920" height="40"/>
      <grabzone x="0" y="0" width="10" height="1080"/>
      <grabzone x="1920-10" y="0" width="10" height="1080"/>
      <grabzone x="0" y="1080-5" width="1920" height="5"/>
    </panel>
    <!-- LAYOUT VARIATIONS -->
    <group y="50" name="layouts">
      <xi:include href="pro/base.xml" xpointer="xpointer(/module/*)"/>
      <xi:include href="performance/base.xml" xpointer="xpointer(/module/*)"/>
      <xi:include href="stack/base.xml" xpointer="xpointer(/module/*)"/>
    </group>
  </panel>
</module>
