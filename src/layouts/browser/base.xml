<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <define class="BROWSER_UI_BASE" folders="yes" searchbar="yes" showzoom="yes" toolbar="yes">
    <background color="dark_1" bordercolortop="br_background" bordercolor="br_background" bordersize="0"/>
    <colors>
      <separators background="button_background" line="button_background" text="needle"/>
