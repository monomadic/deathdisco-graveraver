      <pos y="+[HEIGHT]+7-200-164-3-164+38+140+2+86+2+80+2" width="1920" height="+[HEIGHT]-140-2-86-2-80-2" condition="var_equal '@$show_video_rack' 1 ? var_equal '@$show_mixer_rack' 1 ? var_equal '@$show_fx_rack' 1"/>
      <pos y="+[HEIGHT]+7-200-164-3-164+38+140+2+86+2" width="1920" height="+[HEIGHT]-140-2-86-2" condition="var_equal '@$show_video_rack' 1 ? var_equal '@$show_mixer_rack' 1"/>
