<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Shared browser-zoom / mini-deck layout used by all skin modes. -->
  <define class="DECK_CONTAINER_MINI" placeholders="*deck,*deckside,*panelname">
    <deck deck="[DECK]">
      <panel>
        <button class="button_main" action="select" rightclick="file_info" tooltip="Text Scroll\nRight-click: Tag Editor" width="878" height="100-4" coloroff="infos_background" coloron="infos_background" brcoloroff="panel_background" brcoloron="panel_background" bordersize="2"/>
        <group visibility="loaded" condition="param_equal '[DECKSIDE]' 'leftdeck'">
          <button class="button_main" x="+0" y="+0" width="36" height="94" action="select" rightclick="cycle '@dd_info_panel_mode' 5" tooltip="Select Deck \n Right-click: Next Panel" coloroff="transparent" textcoloron="black" textcolor="deckcolor" textsize="33" textaction="get_deck" textheight="55"/>
          <menu class="menu_maindecks" query="select" x="+0" y="+64" width="40" height="20"/>
          <group x="+4+28+4+100" y="+0">
            <textzone tooltip="">
              <size width="478-50-8" height="34"/>
              <text fontsize="16" weight="bold" color="needle" align="left" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
            <textzone tooltip="">
              <pos y="+22"/>
              <size width="478-50-8" height="28"/>
              <text fontsize="12" weight="" color="#888888" align="left" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <cover rotate="no" rightclick="" dblclick="">
            <pos x="+2+4+33" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
          </cover>
          <button action="select" visibility="loaded">
            <pos x="+2+4+33" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
            <off shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
            <over shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
            <on shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
          </button>
          <!-- BPM / KEY / TIME readout (shared with the Pro decks): TIME | KEY | BPM, BPM toward the centre -->
          <panel class="track_info_stats" otherdeck="right" timex="0" div1="81" keyx="85" div2="174" bpmx="176" x="+878-6-276" y="+2"/>
          <songpos class="songpos" x="+4+30+100" y="+62+6" width="734" height="38-4-8-4" colorPlayed="blue"/>
        </group>
        <group visibility="loaded" condition="param_equal '[DECKSIDE]' 'rightdeck'">
          <group x="+878-478-78" y="+0">
            <textzone tooltip="">
              <size width="478-50-8" height="34"/>
              <text fontsize="16" weight="bold" color="needle" align="right" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
            <textzone tooltip="">
              <pos y="+22"/>
              <size width="478-50-8" height="28"/>
              <text fontsize="12" weight="" color="#888888" align="right" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <button orientation="vertical" class="button_main" x="+6" y="+6" width="16" height="52" action="masterdeck" coloroff="button_background" textcolor="textoff4" coloron="black" textcoloron="color_masterdeck" text="MASTER" bordersize="1" textsize="10" brcoloron="color_masterdeck"/>
          <!-- BPM / KEY / TIME readout (shared with the Pro decks): BPM | KEY | TIME, BPM toward the centre -->
          <panel class="track_info_stats" otherdeck="left" bpmx="0" div1="101" keyx="103" div2="194" timex="200" x="+26" y="+2"/>
          <button class="button_main" x="+878-2-4-30" y="-2" width="36" height="100-2" action="select" rightclick="cycle '@dd_info_panel_mode' 5" tooltip="Select Deck \n Right-click: Next Panel" coloroff="transparent" textcoloron="black" textcolor="deckcolor" textsize="33" textheight="55" textaction="get_deck"/>
          <menu class="menu_maindecks" query="select" x="+878-10-28" y="+64" width="40" height="20"/>
          <cover rotate="no" rightclick="" dblclick="">
            <pos x="+878-27-100" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
          </cover>
          <button action="select" visibility="loaded">
            <pos x="+878-27-100" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
            <off shape="square" color="transparent" border="#22FFFFFF" border_size="1"/>
            <over shape="square" color="transparent" border="#44FFFFFF" border_size="1"/>
            <on shape="square" color="transparent" border="#44FFFFFF" border_size="1"/>
          </button>
          <songpos class="songpos" x="+10" y="+62+6" width="734" height="38-4-8-4" colorPlayed="blue"/>
        </group>
      </panel>
      <visual source="select" visibility="var_equal '@$dd_bordermode' 1" x="-2" y="-2">
        <size width="878" height="98"/>
        <down color="transparent" border_size="2" border="deckcolor" shape="square" radius="10"/>
      </visual>
      <dropzone visibility="var_equal '@$dd_layout_4deck' 0">
        <size width="878" height="98"/>
        <over color="transparent" border_size="2" border="deckcolor" shape="square"/>
      </dropzone>
      <dropzone visibility="var_equal '@$dd_layout_4deck' 1">
        <size width="878" height="98"/>
        <over color="transparent" border_size="2" border="needle" shape="square"/>
      </dropzone>
    </deck>
  </define>
  <define class="BROWSER_ZOOM_RACKS" placeholders="vertical_y=0,mini_y=0">
    <group name="mini_racks_visible" condition="var_equal '@$dd_show_zoom_racks' 1">
      <panel class="racks_vertical" x="+2" y="[VERTICAL_Y]" condition="var_equal '@$dd_hide_zoom_waveforms' 1"/>
      <panel class="racks_mini" x="+2" y="[MINI_Y]" condition="var_equal '@$dd_hide_zoom_waveforms' 0"/>
    </group>
  </define>
  <define class="BROWSER_ZOOM_2DECKS" placeholders="*panelname">
    <xi:include href="positions/2decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="deck_container_mini" x="+2" panelname="deck1" deck="1" deckside="leftdeck" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_mini" x="+2" panelname="deck3" deck="3" deckside="leftdeck" visibility="deck 3 leftdeck"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="browser_zoom_racks" vertical_y="-235" mini_y="-235"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck2" deck="2" deckside="rightdeck" visibility="not deck 4 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck4" deck="4" deckside="rightdeck" visibility="deck 4 rightdeck"/>
  </define>
  <define class="BROWSER_ZOOM_4DECKS" placeholders="*panelname">
    <xi:include href="positions/2decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="deck_container_mini" x="+2" panelname="deck1" deck="1" deckside="leftdeck" visibility="deck 1 leftdeck"/>
    <panel class="deck_container_mini" x="+2" panelname="deck3" deck="3" deckside="leftdeck" visibility="deck 3 leftdeck"/>
    <panel class="deck_container_mini" x="+2" y="+98+2" panelname="deck3" deck="3" deckside="leftdeck" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_mini" x="+2" y="+98+2" panelname="deck1" deck="1" deckside="leftdeck" visibility="not deck 1 leftdeck"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="browser_zoom_racks" vertical_y="-235+98+2" mini_y="+50"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck2" deck="2" deckside="rightdeck" visibility="deck 2 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck4" deck="4" deckside="rightdeck" visibility="deck 4 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" y="+98+2" panelname="deck2" deck="2" deckside="rightdeck" visibility="not deck 2 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" y="+98+2" panelname="deck4" deck="4" deckside="rightdeck" visibility="not deck 4 rightdeck"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_ABOVE">
    <panel class="area_waves" y="+0"/>
    <panel class="browser_zoom_2decks" condition="var_equal '@$dd_layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" condition="var_equal '@$dd_layout_4deck' 1"/>
    <panel class="browser_zoom_browser_waves"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_BELOW">
    <panel class="browser_zoom_2decks" y="+0" condition="var_equal '@$dd_layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" y="+0" condition="var_equal '@$dd_layout_4deck' 1"/>
    <panel class="area_waves" y="+99+2" condition="var_equal '@$dd_layout_4deck' 0"/>
    <panel class="area_waves" y="+99+2+98+2" condition="var_equal '@$dd_layout_4deck' 1"/>
    <panel class="browser_zoom_browser_waves"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_NO_WAVES">
    <panel class="browser_zoom_2decks" condition="var_equal '@$dd_layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" condition="var_equal '@$dd_layout_4deck' 1"/>
    <group name="without_zoom_racks" condition="var_equal '@$dd_show_zoom_racks' 0">
      <panel class="browser_overlay_plain" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$dd_layout_4deck' 0"/>
      <panel class="browser_overlay_plain" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$dd_layout_4deck' 1"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$dd_show_zoom_racks' 1">
      <panel class="browser_overlay_with_racks" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$dd_layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$dd_layout_4deck' 1"/>
    </group>
  </define>
  <define class="BROWSER_ZOOM_BROWSER_WAVES">
    <group name="without_zoom_racks" condition="var_equal '@$dd_show_zoom_racks' 0">
      <panel class="browser_overlay_plain_waves" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$dd_layout_4deck' 0"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$dd_layout_4deck' 1"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$dd_show_zoom_racks' 1">
      <panel class="browser_overlay_with_racks_waves" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$dd_layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$dd_layout_4deck' 1"/>
    </group>
  </define>
</defs>
