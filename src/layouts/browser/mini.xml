<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Shared browser-zoom / mini-deck layout used by all skin modes. -->
  <define class="BROWSER_ZOOM_RACKS" placeholders="vertical_y=0,mini_y=0">
    <group name="mini_racks_visible" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="racks_vertical" x="+2" y="[VERTICAL_Y]" condition="var_equal '@$hide_zoom_waveforms' 1"/>
      <panel class="racks_mini" x="+2" y="[MINI_Y]" condition="var_equal '@$hide_zoom_waveforms' 0"/>
    </group>
  </define>
  <define class="BROWSER_ZOOM_2DECKS" placeholders="*panelname">
    <xi:include href="positions/2decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="area_deck_mini" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="area_deck_mini" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="browser_zoom_racks" vertical_y="-235" mini_y="-235"/>
    <panel class="area_deck_mini" x="+1920-878-2" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="area_deck_mini" x="+1920-878-2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="BROWSER_ZOOM_4DECKS" placeholders="*panelname">
    <xi:include href="positions/4decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="area_deck_mini" x="+2" panelname="deck1" deck="1" visibility="deck 1 leftdeck"/>
    <panel class="area_deck_mini" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="area_deck_mini" x="+2" y="+98+2" panelname="deck3" deck="3" visibility="not deck 3 leftdeck"/>
    <panel class="area_deck_mini" x="+2" y="+98+2" panelname="deck1" deck="1" visibility="not deck 1 leftdeck"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="browser_zoom_racks" vertical_y="-235+98+2" mini_y="+50"/>
    <panel class="area_deck_mini" x="+1920-878-2" panelname="deck2" deck="2" visibility="deck 2 rightdeck"/>
    <panel class="area_deck_mini" x="+1920-878-2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
    <panel class="area_deck_mini" x="+1920-878-2" y="+98+2" panelname="deck2" deck="2" visibility="not deck 2 rightdeck"/>
    <panel class="area_deck_mini" x="+1920-878-2" y="+98+2" panelname="deck4" deck="4" visibility="not deck 4 rightdeck"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_ABOVE">
    <panel class="area_waves" y="+0"/>
    <panel class="browser_zoom_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="browser_zoom_browser_waves"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_BELOW">
    <panel class="browser_zoom_2decks" y="+0" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" y="+0" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="area_waves" y="+99+2" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="area_waves" y="+99+2+98+2" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="browser_zoom_browser_waves"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_NO_WAVES">
    <panel class="browser_zoom_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <group name="without_zoom_racks" condition="var_equal '@$show_zoom_racks' 0">
      <panel class="browser_overlay_plain" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 1"/>
      <panel class="browser_overlay_plain" x="0" y="+98" width="1920" height="1080-46-100-2" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 0"/>
      <panel class="browser_overlay_plain" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 1"/>
      <panel class="browser_overlay_plain" x="0" y="+100+100" width="1920" height="1080-50-100-100" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 0"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$show_zoom_racks' 1">
      <group name="utility_bar_hidden" condition="var_equal '@$show_utility_bar' 0">
        <panel class="browser_overlay_with_racks" x="0" y="+98" width="1920" height="1080-46-100-2" condition="var_equal '@$layout_4deck' 0"/>
        <panel class="browser_overlay_with_racks" x="0" y="+100+100" width="1920" height="1080-50-100-100" condition="var_equal '@$layout_4deck' 1"/>
      </group>
      <group name="utility_bar_visible" condition="var_equal '@$show_utility_bar' 1">
        <panel class="browser_overlay_with_racks" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0"/>
        <panel class="browser_overlay_with_racks" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1"/>
      </group>
    </group>
  </define>
  <define class="BROWSER_ZOOM_BROWSER_WAVES">
    <group name="without_zoom_racks" condition="var_equal '@$show_zoom_racks' 0">
      <panel class="browser_overlay_plain_waves" x="0" y="+98" width="1920" height="1080-46-100-2" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 0"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 1"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 0"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 1"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="browser_overlay_with_racks_waves" x="0" y="+98" width="1920" height="1080-46-100-2" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 0"/>
      <panel class="browser_overlay_with_racks_waves" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0 ? var_equal '@$show_utility_bar' 1"/>
      <panel class="browser_overlay_with_racks_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 0"/>
      <panel class="browser_overlay_with_racks_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1 ? var_equal '@$show_utility_bar' 1"/>
    </group>
  </define>
</defs>
