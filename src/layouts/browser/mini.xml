<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Shared browser-zoom / mini-deck layout used by all skin modes. -->
  <define class="DECK_CONTAINER_MINI" placeholders="*deck,*panelname">
    <deck deck="[DECK]">
      <panel>
        <button class="button_main" action="select" rightclick="file_info" tooltip="Text Scroll\nRight-click: Tag Editor" width="878" height="100-4" coloroff="infos_background" coloron="infos_background" brcoloroff="panel_background" brcoloron="panel_background" bordersize="2"/>
        <group visibility="loaded ? get_deck 1 ? true : get_deck 3 ? true : false">
          <button class="button_main" x="+0" y="+0" width="36" height="94" action="select" rightclick="cycle '@infospannelmode' 5" tooltip="Select Deck \n Right-click: Next Panel" coloroff="transparent" textcoloron="black" textcolor="deckcolor" textsize="33" textaction="get_deck" textheight="55" visibility="get_deck 1 ? true : get_deck 3 ? true : false"/>
          <menu class="menu_maindecks" query="select" x="+0" y="+64" width="40" height="20"/>
          <group x="+4+28+4+100" y="+0">
            <textzone tooltip="">
              <size width="478-50-8" height="34"/>
              <text fontsize="16" weight="bold" color="needle" align="left" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
            <textzone tooltip="">
              <pos y="+22"/>
              <size width="478-50-8" height="28"/>
              <text fontsize="12" weight="" color="#888888" align="left" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <cover rotate="no" rightclick="" dblclick="">
            <pos x="+2+4+33" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
          </cover>
          <button action="select" visibility="loaded">
            <pos x="+2+4+33" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
            <off shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
            <over shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
            <on shape="square" color="transparent" border="#88FFFFFF" border_size="1"/>
          </button>
          <button class="button_main" x="+878-10-90" y="+4" width="90" height="30" action="beat_tap" dblclick="reanalyze" rightclick="edit_bpm" coloroff="transparent" coloron="transparent" bordersize="0" textcolor="textdarker" textsize="18" textaction="not loaded ? get_text 'TAP'"/>
          <textzone class="text" x="+878-10-90" y="+4" width="90" height="30" fontsize="22" color="needle" align="center" weight="bold" textaction="var_equal '@$jog_bpm_digits' 0 ? get_text '%Pbpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%Pbpmex'"/>
          <textzone class="text" x="+878-10-90" y="+25" action="pitch_reset" width="90" height="30" fontsize="12" color="textoff2" align="center" weight="" textaction="get_text '%Ppitch%'"/>
          <group x="+878-10-90-10-90" y="+12">
            <visual class="gfx_shape" width="128" height="80" coloroff="transparent"/>
            <textzone class="text" x="+16" y="+0" width="128-26-26" height="20" action="key_match_menu" fontsize="22" color="`get_key_color`" align="center" weight="bold" textaction="get_key"/>
            <button class="button_main" x="+6" y="+0" width="26" height="15" action="key_move -1" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" border="0" iconsize="15" sysicon="minus"/>
            <button class="button_main" action="key_match_button" width="100-26-26" height="14" x="+32" y="+21" coloroff="black" coloron="black" bordersize="0" textsize="12" textcoloroff="red" textcoloron="green" textaction="param_equal '`get_key_modifier_text`' 'KEY' ? get_text '+0' : get_key_modifier_text" visibility="masterdeck"/>
            <button class="button_main" action="key_match_button" width="100-26-26" height="14" x="+32" y="+21" coloroff="black" coloron="black" bordersize="0" textsize="12" textcoloroff="orange" textcoloron="orange" textaction="param_equal '`get_key_modifier_text`' 'KEY' ? get_text '+0' : get_key_modifier_text" visibility="not masterdeck"/>
            <button class="button_main" x="+80" y="+0" width="26" height="16" action="key_move +1" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="plus"/>
            <visual type="square" x="+10" y="+40" width="10" height="10" color="red" visibility="not is_sync ? blink : false"/>
          </group>
          <songpos class="songpos" x="+4+30+100" y="+62+6" width="734" height="38-4-8-4" colorPlayed="blue"/>
        </group>
        <group visibility="loaded ? get_deck 2 ? true : get_deck 4 ? true : false">
          <group x="+878-478-78" y="+0">
            <textzone tooltip="">
              <size width="478-50-8" height="34"/>
              <text fontsize="16" weight="bold" color="needle" align="right" scroll="yes" action="get_title_before_remix &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
            <textzone tooltip="">
              <pos y="+22"/>
              <size width="478-50-8" height="28"/>
              <text fontsize="12" weight="" color="#888888" align="right" scroll="yes" action="get_loaded_song 'artist' &amp; param_uppercase" localize="true" important="true"/>
            </textzone>
          </group>
          <textzone class="text" x="+20" y="+4" width="90" height="30" fontsize="22" color="needle" align="center" weight="bold" textaction="var_equal '@$jog_bpm_digits' 0 ? get_text '%Pbpm' : var_equal '@$jog_bpm_digits' 1 ? get_text '%Pbpmex'"/>
          <button orientation="vertical" class="button_main" x="+6" y="+6" width="16" height="52" action="masterdeck" coloroff="button_background" textcolor="textoff4" coloron="black" textcoloron="color_masterdeck" text="MASTER" bordersize="1" textsize="10" brcoloron="color_masterdeck"/>
          <group x="+120" y="+12">
            <visual class="gfx_shape" width="128" height="80" coloroff="transparent"/>
            <textzone class="text" x="+10" y="+0" width="128-26-26" height="20" action="key_match_menu" fontsize="22" color="`get_key_color`" align="center" weight="bold" textaction="get_key"/>
            <button class="button_main" x="+0" y="+0" width="26" height="15" action="key_move -1" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" border="0" iconsize="15" sysicon="minus"/>
            <button class="button_main" action="key_match_button" width="100-26-26" height="14" x="+22" y="+21" coloroff="black" coloron="black" bordersize="0" textsize="12" textcoloroff="red" textcoloron="green" textaction="param_equal '`get_key_modifier_text`' 'KEY' ? get_text '+0' : get_key_modifier_text" visibility="masterdeck"/>
            <button class="button_main" action="key_match_button" width="100-26-26" height="14" x="+22" y="+21" coloroff="black" coloron="black" bordersize="0" textsize="12" textcoloroff="orange" textcoloron="orange" textaction="param_equal '`get_key_modifier_text`' 'KEY' ? get_text '+0' : get_key_modifier_text" visibility="not masterdeck"/>
            <button class="button_main" x="+70" y="+0" width="26" height="16" action="key_move +1" textcoloron="white" coloron="transparent" coloroff="transparent" brcoloron="transparent" brcoloroff="transparent" iconsize="15" sysicon="plus"/>
            <visual type="square" x="+10" y="+40" width="10" height="10" color="red" visibility="not is_sync ? blink : false"/>
          </group>
          <button class="button_main" x="+878-2-4-30" y="-2" width="36" height="100-2" action="select" rightclick="cycle '@infospannelmode' 5" tooltip="Select Deck \n Right-click: Next Panel" coloroff="transparent" textcoloron="black" textcolor="deckcolor" textsize="33" textheight="55" textaction="get_deck" visibility="get_deck 2 ? true : get_deck 4 ? true : false"/>
          <menu class="menu_maindecks" query="select" x="+878-10-28" y="+64" width="40" height="20"/>
          <cover rotate="no" rightclick="" dblclick="">
            <pos x="+878-27-100" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
          </cover>
          <button action="select" visibility="loaded">
            <pos x="+878-27-100" y="+3"/>
            <size width="100-8-4" height="100-8-4"/>
            <off shape="square" color="transparent" border="#22FFFFFF" border_size="1"/>
            <over shape="square" color="transparent" border="#44FFFFFF" border_size="1"/>
            <on shape="square" color="transparent" border="#44FFFFFF" border_size="1"/>
          </button>
          <songpos class="songpos" x="+10" y="+62+6" width="734" height="38-4-8-4" colorPlayed="blue"/>
        </group>
      </panel>
      <visual source="select" visibility="var_equal '@$dd_bordermode' 1" x="-2" y="-2">
        <size width="878" height="98"/>
        <down color="transparent" border_size="2" border="deckcolor" shape="square" radius="10"/>
      </visual>
      <dropzone visibility="var_equal '@$layout_4deck' 0">
        <size width="878" height="98"/>
        <over color="transparent" border_size="2" border="deckcolor" shape="square"/>
      </dropzone>
      <dropzone visibility="var_equal '@$layout_4deck' 1">
        <size width="878" height="98"/>
        <over color="transparent" border_size="2" border="needle" shape="square"/>
      </dropzone>
    </deck>
  </define>
  <define class="BROWSER_ZOOM_RACKS" placeholders="vertical_y=0,mini_y=0">
    <group name="mini_racks_visible" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="racks_vertical" x="+2" y="[VERTICAL_Y]" condition="var_equal '@$hide_zoom_waveforms' 1"/>
      <panel class="racks_mini" x="+2" y="[MINI_Y]" condition="var_equal '@$hide_zoom_waveforms' 0"/>
    </group>
  </define>
  <define class="BROWSER_ZOOM_2DECKS" placeholders="*panelname">
    <xi:include href="positions/2decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="deck_container_mini" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_mini" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="browser_zoom_racks" vertical_y="-235" mini_y="-235"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="BROWSER_ZOOM_4DECKS" placeholders="*panelname">
    <xi:include href="positions/2decks-mini.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="deck_container_mini" x="+2" panelname="deck1" deck="1" visibility="deck 1 leftdeck"/>
    <panel class="deck_container_mini" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="deck_container_mini" x="+2" y="+98+2" panelname="deck3" deck="3" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_mini" x="+2" y="+98+2" panelname="deck1" deck="1" visibility="not deck 1 leftdeck"/>
    <panel class="levels_mini" x="+2+800+2"/>
    <panel class="browser_zoom_racks" vertical_y="-235+98+2" mini_y="+50"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck2" deck="2" visibility="deck 2 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" y="+98+2" panelname="deck2" deck="2" visibility="not deck 2 rightdeck"/>
    <panel class="deck_container_mini" x="+1920-878-2" y="+98+2" panelname="deck4" deck="4" visibility="not deck 4 rightdeck"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_ABOVE">
    <panel class="area_waves" y="+0"/>
    <panel class="browser_zoom_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="browser_zoom_browser_waves"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_BELOW">
    <panel class="browser_zoom_2decks" y="+0" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" y="+0" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="area_waves" y="+99+2" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="area_waves" y="+99+2+98+2" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="browser_zoom_browser_waves"/>
  </define>
  <define class="BROWSER_ZOOM_DECKS_NO_WAVES">
    <panel class="browser_zoom_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_zoom_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <group name="without_zoom_racks" condition="var_equal '@$show_zoom_racks' 0">
      <panel class="browser_overlay_plain" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_plain" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="browser_overlay_with_racks" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1"/>
    </group>
  </define>
  <define class="BROWSER_ZOOM_BROWSER_WAVES">
    <group name="without_zoom_racks" condition="var_equal '@$show_zoom_racks' 0">
      <panel class="browser_overlay_plain_waves" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_plain_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1"/>
    </group>
    <group name="with_zoom_racks" condition="var_equal '@$show_zoom_racks' 1">
      <panel class="browser_overlay_with_racks_waves" x="0" y="+98" width="1920" height="1080-46-100-2-50" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks_waves" x="0" y="+100+100" width="1920" height="1080-50-100-100-50" condition="var_equal '@$layout_4deck' 1"/>
    </group>
  </define>
</defs>
