<?xml version="1.0" encoding="UTF-8"?>
<module>
  <!-- PERFORMANCE
    Assumes the user will be heavily slanted to controller use,
    and the VirtualDJ screen mostly for visual cues and feedback over interaction.

    Performance uses statically-sized waveforms only. The expanding-wave
    ("extended") layout now lives in Pro (src/layouts/pro/extended.xml).
  -->
  <group name="PERFORMANCE" condition="var_equal '@$dd_skin_mode' 1">
    <!-- @$dd_performance_layout selects the sublayout: 0 = vertical, 1 = horizontal -->
    <!-- @$dd_layout_4deck selects deck density: 0 = two-deck / swap, 1 = full four-deck -->
    <group name="Vertical" condition="not var_equal '@$dd_performance_layout' 1">
      <panel class="performance_decks_vertical" visibility="not browser_zoom"/>
    </group>
    <group name="Horizontal" condition="var_equal '@$dd_performance_layout' 1">
      <panel class="performance_decks_horizontal" visibility="not browser_zoom"/>
    </group>
    <!-- browser zoom -->
    <panel class="browser_zoom_decks_above" condition="var_equal '@$dd_hide_zoom_waveforms' 0 ? var_equal '@$dd_waveform_position' 0" visibility="browser_zoom"/>
    <panel class="browser_zoom_decks_below" condition="var_equal '@$dd_hide_zoom_waveforms' 0 ? var_equal '@$dd_waveform_position' 1" visibility="browser_zoom"/>
    <panel class="browser_zoom_decks_no_waves" condition="var_equal '@$dd_hide_zoom_waveforms' 1" visibility="browser_zoom"/>
  </group>
</module>
