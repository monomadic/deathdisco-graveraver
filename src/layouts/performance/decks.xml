<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Performance deck layout shells. @$layout_4deck: 0 = two-deck / swap, 1 = full four-deck. -->
  <define class="PERFORMANCE_MAIN_RACKS" placeholders="offset_y=0">
    <panel class="racks_extended" x="+2" y="[OFFSET_Y]" condition="var_equal '@$hide_main_waveforms' 0"/>
    <panel class="racks_single" x="+2" y="[OFFSET_Y]" condition="var_equal '@$hide_main_waveforms' 1"/>
  </define>
  <define class="PERFORMANCE_2DECKS" placeholders="*panelname">
    <!-- Wave-size offset ladder extracted to keep the shell readable -->
    <xi:include href="positions/2decks.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="area_deck_performance_side" x="0" panelname="deck1" deck="1" deckside="left" visibility="deck 1 leftdeck"/>
    <panel class="area_deck_performance_side" x="0" panelname="deck3" deck="3" deckside="left" visibility="deck 3 leftdeck"/>
    <panel class="area_deck_performance_side" x="+960" panelname="deck2" deck="2" deckside="right" visibility="deck 2 rightdeck"/>
    <panel class="area_deck_performance_side" x="+960" panelname="deck4" deck="4" deckside="right" visibility="deck 4 rightdeck"/>
    <panel class="performance_main_racks" y="+60"/>
  </define>
  <define class="PERFORMANCE_2DECKS_VERTICAL" placeholders="*panelname">
    <panel class="area_deck_performance_left_vertical" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="area_deck_performance_left_vertical" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="waveform_vertical" x="+2+800+2"/>
    <panel class="racks_vertical" x="+2"/>
    <panel class="area_deck_performance_right_vertical" x="+1920-2-800" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="area_deck_performance_right_vertical" x="+1920-2-800" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="PERFORMANCE_2DECKS_CENTER" placeholders="*panelname">
    <panel class="area_deck_performance_left_center" x="+2" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="area_deck_performance_left_center" x="+2" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="racks_vertical" x="+2"/>
    <panel class="waveform_horizontal_center" waveformwidth="474" waveformheight="333" x="+800-81+4" y="+0"/>
    <panel class="area_deck_performance_right_center" x="+1920-2-800+81" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="area_deck_performance_right_center" x="+1920-2-800+81" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="PERFORMANCE_4DECKS" placeholders="*panelname">
    <!-- Wave-size offset ladder extracted to keep the shell readable -->
    <xi:include href="positions/4decks.xml" xpointer="xpointer(/positions/*)"/>
    <panel class="area_deck_performance_body" x="+2" panelname="deck1" deck="1"/>
    <panel class="area_deck_performance_body" x="+2" y="+264+2" panelname="deck3" deck="3"/>
    <panel class="performance_main_racks" offset_y="+264+2"/>
    <panel class="area_deck_performance_right" x="+1920-2-878-77-2" panelname="deck2" deck="2"/>
    <panel class="area_deck_performance_right" x="+1920-2-878-77-2" y="+264+2" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_4DECKS_VERTICAL" placeholders="*panelname">
    <panel class="area_deck_performance_left_center" x="+2" panelname="deck1" deck="1"/>
    <panel class="area_deck_performance_left_center" x="+2" y="+333+2" panelname="deck3" deck="3"/>
    <panel class="waveform_vertical4" x="+2+800+2-77-2"/>
    <panel class="racks_vertical" x="+2" y="+333+2"/>
    <panel class="area_deck_performance_right_center" x="+1920-2-800+81" panelname="deck2" deck="2"/>
    <panel class="area_deck_performance_right_center" x="+1920-2-800+81" y="+333+2" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_4DECKS_CENTER" placeholders="*panelname">
    <panel class="area_deck_performance_left_center" x="+2" panelname="deck1" deck="1"/>
    <panel class="area_deck_performance_left_center" x="+2" y="+333+2" panelname="deck3" deck="3"/>
    <panel class="waveform_horizontal_center4" waveformwidth="474" waveformheight="333+2+333" x="+800-81+4" y="+0"/>
    <panel class="racks_vertical" x="+2" y="+333+2"/>
    <panel class="area_deck_performance_right_center" x="+1920-2-800+81" panelname="deck2" deck="2"/>
    <panel class="area_deck_performance_right_center" x="+1920-2-800+81" y="+333+2" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_DECKS_VERTICAL">
    <panel class="performance_2decks_vertical" y="+0" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="performance_4decks_vertical" y="+0" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <group name="utility_bar_hidden" condition="var_equal '@$show_utility_bar' 0">
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+323+2" width="1920-4" height="1080-43-2-333-2-2" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+323+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2" condition="var_equal '@$layout_4deck' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$show_utility_bar' 1">
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+323+2" width="1920-4" height="1080-43-2-333-2-2-38" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+43+2+323+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2-38" condition="var_equal '@$layout_4deck' 1"/>
    </group>
  </define>
  <define class="PERFORMANCE_DECKS_CENTER">
    <panel class="performance_2decks_center" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="performance_4decks_center" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <group name="utility_bar_hidden" condition="var_equal '@$show_utility_bar' 0">
      <panel class="browser_overlay_with_racks" x="2" y="+333+2" width="1920-4" height="1080-43-2-333-2-2" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+333+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2" condition="var_equal '@$layout_4deck' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$show_utility_bar' 1">
      <panel class="browser_overlay_with_racks" x="2" y="+333+2" width="1920-4" height="1080-43-2-333-2-2-38" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" x="2" y="+333+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2-38" condition="var_equal '@$layout_4deck' 1"/>
    </group>
  </define>
  <define class="PERFORMANCE_DECKS_NO_WAVES">
    <panel class="performance_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="performance_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <group name="utility_bar_hidden" condition="var_equal '@$show_utility_bar' 0">
      <panel class="browser_overlay_with_racks" y="+264+2" width="1920" height="1080-43-2-264-2-2" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" y="+264+2+264+2" width="1920" height="1080-43-2-264-2-2-264-2" condition="var_equal '@$layout_4deck' 1"/>
    </group>
    <group name="utility_bar_visible" condition="var_equal '@$show_utility_bar' 1">
      <panel class="browser_overlay_with_racks" y="+264+2" width="1920" height="1080-43-2-264-2-2-38" condition="var_equal '@$layout_4deck' 0"/>
      <panel class="browser_overlay_with_racks" y="+264+2+264+2" width="1920" height="1080-43-2-264-2-2-264-2-38" condition="var_equal '@$layout_4deck' 1"/>
    </group>
  </define>
</defs>
