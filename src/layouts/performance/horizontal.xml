<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Horizontal Performance layout: decks arranged around a center waveform. -->
  <define class="PERFORMANCE_2DECKS_HORIZONTAL" placeholders="*panelname">
    <panel class="deck_container_performance_compact" x="+2" width="800-81" height="333" mirror="false" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_performance_compact" x="+2" width="800-81" height="333" mirror="false" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="racks_vertical" x="+2"/>
    <panel class="waveform_horizontal_center" waveformwidth="474" waveformheight="333" x="+800-81+4" y="+0"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800+81" width="800-81" height="333" mirror="true" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800+81" width="800-81" height="333" mirror="true" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="PERFORMANCE_4DECKS_HORIZONTAL" placeholders="*panelname">
    <panel class="deck_container_performance_compact" x="+2" width="800-81" height="333" mirror="false" panelname="deck1" deck="1"/>
    <panel class="deck_container_performance_compact" x="+2" y="+333+2" width="800-81" height="333" mirror="false" panelname="deck3" deck="3"/>
    <panel class="waveform_horizontal_center4" waveformwidth="474" waveformheight="333+2+333" x="+800-81+4" y="+0"/>
    <panel class="racks_vertical" x="+2" y="+333+2"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800+81" width="800-81" height="333" mirror="true" panelname="deck2" deck="2"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800+81" y="+333+2" width="800-81" height="333" mirror="true" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_DECKS_HORIZONTAL">
    <panel class="performance_2decks_horizontal" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="performance_4decks_horizontal" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <panel class="browser_overlay_with_racks" x="2" y="+333+2" width="1920-4" height="1080-43-2-333-2-2-50" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_overlay_with_racks" x="2" y="+333+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2-50" condition="var_equal '@$layout_4deck' 1"/>
  </define>
</defs>
