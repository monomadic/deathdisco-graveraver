<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- Vertical Performance layout: decks flanking a vertical waveform strip. -->
  <define class="PERFORMANCE_2DECKS_VERTICAL" placeholders="*panelname">
    <panel class="deck_container_performance_compact" x="+2" width="800" height="333" deckside="left" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_performance_compact" x="+2" width="800" height="333" deckside="left" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="waveform_vertical" x="+2+800+2"/>
    <panel class="racks_vertical" x="+2"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800" width="800" height="333" deckside="right" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800" width="800" height="333" deckside="right" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
  </define>
  <define class="PERFORMANCE_4DECKS_VERTICAL" placeholders="*panelname">
    <panel class="deck_container_performance_compact" x="+2" width="800-81" height="333" deckside="left" panelname="deck1" deck="1"/>
    <panel class="deck_container_performance_compact" x="+2" y="+333+2" width="800-81" height="333" deckside="left" panelname="deck3" deck="3"/>
    <panel class="waveform_vertical4" x="+2+800+2-77-2"/>
    <panel class="racks_vertical" x="+2" y="+333+2"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800+81" width="800-81" height="333" deckside="right" panelname="deck2" deck="2"/>
    <panel class="deck_container_performance_compact" x="+1920-2-800+81" y="+333+2" width="800-81" height="333" deckside="right" panelname="deck4" deck="4"/>
  </define>
  <define class="PERFORMANCE_DECKS_VERTICAL">
    <panel class="performance_2decks_vertical" y="+0" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="performance_4decks_vertical" y="+0" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <panel class="browser_overlay_with_racks" x="2" y="+43+2+323+2" width="1920-4" height="1080-43-2-333-2-2-50" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="browser_overlay_with_racks" x="2" y="+43+2+323+2+333+2" width="1920-4" height="1080-43-2-333-2-2-333-2-50" condition="var_equal '@$layout_4deck' 1"/>
  </define>
</defs>
