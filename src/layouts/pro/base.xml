<?xml version="1.0" encoding="UTF-8"?>
<module>
  <!-- PRO
    A layout that accounts for laptop control as well as controllers.
    More functionality is included in the virtualdj interface UI itself.
  -->
  <group name="PRO" condition="var_equal '@$dd_skin_mode' 0">
    <!-- @$dd_hide_pro_mixer selects the Pro variant: 0 = decks + center mixer, 1 = extended (decks fill, no center) -->
    <!-- @$dd_layout_4deck selects deck density within Pro: 0 = two-deck / swap, 1 = full four-deck -->
    <!-- @$dd_waveform_position: 0 = waves above decks, 1 = below. @$dd_hide_main_waveforms: 0 = show, 1 = hide -->
    <!-- One shared deck-stack shell; the @$dd_hide_pro_mixer branch lives inside it. -->
    <panel class="decks_above" condition="var_equal '@$dd_hide_main_waveforms' 0 ? var_equal '@$dd_waveform_position' 0" visibility="not browser_zoom"/>
    <panel class="decks_below" condition="var_equal '@$dd_hide_main_waveforms' 0 ? var_equal '@$dd_waveform_position' 1" visibility="not browser_zoom"/>
    <panel class="decks_no_waves" condition="var_equal '@$dd_hide_main_waveforms' 1" visibility="not browser_zoom"/>
    <!-- browser zoom (shared across both variants) -->
    <panel class="browser_zoom_decks_above" condition="var_equal '@$dd_hide_zoom_waveforms' 0 ? var_equal '@$dd_waveform_position' 0" visibility="browser_zoom"/>
    <panel class="browser_zoom_decks_below" condition="var_equal '@$dd_hide_zoom_waveforms' 0 ? var_equal '@$dd_waveform_position' 1" visibility="browser_zoom"/>
    <panel class="browser_zoom_decks_no_waves" condition="var_equal '@$dd_hide_zoom_waveforms' 1" visibility="browser_zoom"/>
  </group>
</module>
