<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Pro deck layout shells. @$layout_4deck: 0 = two-deck / swap, 1 = full four-deck. -->
  <define class="DECK_CONTAINER_PRO" placeholders="*deck,*panelname,*deckside,height=465">
    <deck deck="[DECK]">
      <panel class="deck_spine_pair" deck="[DECK]" panelname="[PANELNAME]" mirror="false" height="[HEIGHT]" condition="param_equal [DECKSIDE] 'left'"/>
      <panel class="deck_spine_pair" deck="[DECK]" panelname="[PANELNAME]" x="+800-34" mirror="true" height="[HEIGHT]" condition="param_equal [DECKSIDE] 'right'"/>
      <visual width="765" height="[HEIGHT]" x="+35" condition="param_equal [DECKSIDE] 'left'">
        <off shape="square" color="panel_background" radius="6"/>
      </visual>
      <visual width="765" height="[HEIGHT]" condition="param_equal [DECKSIDE] 'right'">
        <off shape="square" color="panel_background" radius="6"/>
      </visual>
      <group x="+35" condition="param_equal [DECKSIDE] 'left'">
        <panel class="track_info_pro"/>
        <panel class="track_modifiers_panel" x="+10" y="+60" mirror="false" visibility="not has_video_mix 'active' ? yes : not skin_panel 'videomixer'"/>
        <group x="565" y="+16">
          <panel class="jogwheel" name="jogwheel_spinner" mirror="false"/>
          <panel class="pitch_small" x="765" y="+10"/>
          <panel class="volume_small" x="765" y="+95"/>
        </group>
        <panel class="pad_page_container" y="+180" x="+10" deck="[DECK]" panelname="[PANELNAME]_[DECK]"/>
        <panel class="transport_bar" y="+425" deck="[DECK]" x="+0" deckside="left"/>
        <visual width="765" height="[HEIGHT]" y="+0">
          <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
        </visual>
      </group>
      <group condition="param_equal [DECKSIDE] 'right'">
        <group x="+5" y="+16">
          <panel class="pitch_small" y="+10"/>
          <panel class="volume_small" y="+95"/>
          <panel class="jogwheel" x="+38" name="jogwheel_spinner" visibility="not has_video_mix 'active' ? yes : not skin_panel 'videomixer'"/>
        </group>
        <group x="+210">
          <panel class="track_info_pro"/>
          <panel class="track_modifiers_panel" y="+60" mirror="true" visibility="not has_video_mix 'active' ? yes : not skin_panel 'videomixer'"/>
        </group>
        <panel class="pad_page_container" y="+180" x="+10" deck="[DECK]" panelname="[PANELNAME]_[DECK]"/>
        <panel class="transport_bar" y="+425" deck="[DECK]" x="+0" deckside="right"/>
        <visual width="765" height="[HEIGHT]" y="+0">
          <off shape="square" color="transparent" border_size="1" border="#333333" radius="6"/>
        </visual>
      </group>
    </deck>
  </define>
  <define class="PRO_2DECKS_OVERLAYS" placeholders="*deck,height=466,width=766">
    <visual source="deck [DECK] select" deck="[DECK]" visibility="var_equal '@$dd_bordermode' 1">
      <size width="[WIDTH]" height="[HEIGHT]"/>
      <down color="transparent" border_size="2" border="deckcolor" shape="square" radius="8"/>
    </visual>
    <dropzone deck="[DECK]">
      <size width="770-5" height="180"/>
      <over color="transparent" border_size="6" border="#33FFFFFF" shape="square" radius="6"/>
    </dropzone>
  </define>
  <!-- Pure deck structure: positioned by the shared DECKS_* shell (pro/waves.xml). -->
  <define class="PRO_2DECKS">
    <!-- DECKS -->
    <panel class="deck_container_pro" x="0" panelname="deck1" deck="1" deckside="left" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_pro" x="0" panelname="deck3" deck="3" deckside="left" visibility="deck 3 leftdeck"/>
    <panel class="deck_container_pro" x="+1920-800" panelname="deck2" deck="2" deckside="right" visibility="not deck 4 rightdeck"/>
    <panel class="deck_container_pro" x="+1920-800" panelname="deck4" deck="4" deckside="right" visibility="deck 4 rightdeck"/>
    <!-- PRO: 2 DECK: MIXER PANEL / MIDDLE PANEL -->
    <group x="+800">
      <!-- header -->
      <group name="tabs">
        <button class="button_main" x="+2" width="78" height="23" action="skin_panel 'audiomixer' on" tooltip="AUDIO\nShow the audio (mixer) controls, like equalizers, gain, level, pfl, etc" textcolor="textdarker" textcoloron="needle" text="MIXER" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
        <button class="button_main" x="+2+78" width="78" height="23" action="skin_panel 'samplermixer' on" tooltip="SAMPLER\nShow the sampler controls" textcolor="textdarker" textcoloron="needle" text="SAMPLER" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
        <button class="button_main" x="+2+78+78" width="78" height="23" action="skin_panel 'scratchmixer' on" tooltip="SCRATCH\nShow a scratch-optimized view with vertical waveforms and scratch options" textcolor="textdarker" textcoloron="needle" text="WAVE" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
        <button class="button_main" x="+2+78+78+78" width="78" height="23" action="skin_panel 'mastermixer' on" textcolor="textdarker" tooltip="MASTER\nShow some general controls, like record/broadcast, microphone, or master effects" textcoloron="needle" text="MASTER" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
      </group>
      <!-- panel -->
      <panel name="content" class="mixer" x="+2" y="+24"/>
    </group>
    <panel class="pro_2decks_overlays" x="+35" y="+0" deck="1"/>
    <panel class="pro_2decks_overlays" x="+35" y="+0" deck="3"/>
    <panel class="pro_2decks_overlays" x="+1920-800" y="+0" deck="2"/>
    <panel class="pro_2decks_overlays" x="+1920-800" y="+0" deck="4"/>
  </define>
  <!-- Pure deck structure: positioned by the shared DECKS_* shell (pro/waves.xml). -->
  <define class="PRO_4DECKS" placeholders="*panelname">
    <!-- shared mini deck strip -->
    <!-- LEFT: BOTTOM -->
    <panel class="deck_container_pro" x="+0" panelname="deck1" deck="1" deckside="left" visibility="deck 3 leftdeck"/>
    <panel class="deck_container_pro" x="+0" panelname="deck3" deck="3" deckside="left" visibility="deck 1 leftdeck"/>
    <!-- LEFT: TOP -->
    <panel class="deck_container_pro" x="+0" panelname="deck1" deck="1" deckside="left" visibility="deck 1 leftdeck" y="+180"/>
    <panel class="deck_container_pro" x="+0" panelname="deck3" deck="3" deckside="left" visibility="deck 3 leftdeck" y="+180"/>
    <!-- PRO: 4 DECKS: MIXER PANEL / MIDDLE PANEL -->
    <group x="+802" y="+0">
      <!-- MIDDLE PANEL BORDER -->
      <visual x="+4" y="+25" width="308" height="600">
        <off shape="square" color="#000000" radius="6" bordersize="1" border="dark_6"/>
      </visual>
      <!-- tabs -->
      <button class="button_main" x="+12" width="78" height="23" action="skin_panel 'audiomixer' on" tooltip="AUDIO\nShow the audio (mixer) controls, like equalizers, gain, level, pfl, etc" textcolor="textdarker" textcoloron="needle" text="MIXER" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
      <button class="button_main" x="+7+78" width="78" height="23" action="skin_panel 'samplermixer' on" tooltip="SAMPLER\nShow the sampler" textcolor="textdarker" textcoloron="needle" text="SAMPLER" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
      <button class="button_main" x="+0+78+78" width="78" height="23" action="skin_panel 'scratchmixer' on" tooltip="SCRATCH\nShow a scratch-optimized view with vertical waveforms and scratch options" textcolor="textdarker" textcoloron="needle" text="WAVE" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
      <button class="button_main" x="+0+76+78+78" width="78" height="23" action="skin_panel 'mastermixer' on" textcolor="textdarker" tooltip="MASTER\nShow some general controls, like record/broadcast, microphone, or master effects" textcoloron="needle" text="MASTER" coloroff="xf_background" coloron="xf_background" brcoloroff="xf_background" brcoloron="xf_background"/>
    </group>
    <!-- MIDDLE -->
    <panel class="mixer_4decks" x="+2+800+2" y="+24"/>
    <!-- RIGHT: TOP -->
    <panel class="deck_container_pro" x="+1920-0-800" panelname="deck2" deck="2" deckside="right" visibility="deck 2 rightdeck"/>
    <panel class="deck_container_pro" x="+1920-0-800" panelname="deck4" deck="4" deckside="right" visibility="deck 4 rightdeck"/>
    <!-- RIGHT: BOTTOM -->
    <panel class="deck_container_pro" x="+1920-0-800" y="+180+2" panelname="deck2" deck="2" deckside="right" visibility="deck 4 rightdeck"/>
    <panel class="deck_container_pro" x="+1920-0-800" y="+180+2" panelname="deck4" deck="4" deckside="right" visibility="deck 2 rightdeck"/>
    <!-- RACKS (PADS, ETC) -->
    <panel class="pro_racks" x="+2" y="-2"/>
    <group y="+389">
      <!-- TRANSPORT 4 DECK -->
      <!-- <panel class="transport_bar" deck="3" x="+0" deckside="left" visibility="deck 3 leftdeck"/> -->
      <!-- <panel class="transport_bar" deck="1" x="+0" deckside="left" visibility="not deck 3 leftdeck"/> -->
      <!-- <panel class="transport_bar" deck="2" x="+1920-2-800" deckside="right" visibility="not deck 4 rightdeck"/> -->
      <!-- <panel class="transport_bar" deck="4" x="+1920-2-800" deckside="right" visibility="deck 4 rightdeck"/> -->
    </group>
  </define>
</defs>
