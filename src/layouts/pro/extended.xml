<?xml version="1.0" encoding="UTF-8"?>
<defs>
  <!-- EXTENDED: a Pro sublayout (mixer off).
    Same expanding-wave shell as the mixer variant, but the center mixer panel
    is dropped and the decks widen to fill the full canvas. Selected in
    src/layouts/pro/base.xml via @$hide_pro_mixer 1.

    The deck transport buttons (performance_play_button / performance_cue_button)
    and the dropzone helper (dual_dropzone) are shared with the Performance
    compact decks and live in src/layouts/performance/decks.xml. -->
  <!-- Waveform/browser shells (the expanding wave drives deck offsets). -->
  <define class="EXTENDED_DECKS_ABOVE">
    <panel class="area_waves" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="area_waves_extended_4deck" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="extended_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="extended_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="browser_performance_surface" height="1080-60-2-2-2-1-50" bottom_trim="344" condition="var_equal '@$layout_4deck' 0"/>
  </define>
  <define class="EXTENDED_DECKS_BELOW">
    <panel class="extended_2decks" y="+0" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="extended_4decks" y="+0" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="area_waves" y="+355+3" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="area_waves_extended_4deck" y="+355+2+355+3" condition="var_equal '@$layout_4deck' 1"/>
    <panel class="browser_performance_surface" height="1080-125" bottom_trim="328" condition="var_equal '@$layout_4deck' 0"/>
  </define>
  <define class="EXTENDED_DECKS_NO_WAVES">
    <panel class="extended_2decks" condition="var_equal '@$layout_4deck' 0"/>
    <panel class="extended_4decks" condition="var_equal '@$layout_4deck' 1"/>
    <!-- browsers -->
    <panel class="browser_overlay_with_racks" y="+355+2" width="1920" height="1080-43-2-355-2-2-50" condition="var_equal '@$layout_4deck' 0"/>
  </define>
  <!-- Deck density shells. @$layout_4deck: 0 = two-deck / swap, 1 = full four-deck. -->
  <define class="EXTENDED_2DECKS" placeholders="*panelname,height=355">
    <!-- Wave-size offset ladder kept inline: decks drop as the wave above grows. -->
    <pos y="+381+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 13"/>
    <pos y="+361+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 12"/>
    <pos y="+341+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 11"/>
    <pos y="+321+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 10"/>
    <pos y="+301+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 9"/>
    <pos y="+281+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 8"/>
    <pos y="+261+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 7"/>
    <pos y="+241+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 6"/>
    <pos y="+221+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 5"/>
    <pos y="+201+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 4"/>
    <pos y="+181+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 3"/>
    <pos y="+161+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 2"/>
    <pos y="+141+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 1"/>
    <pos y="+121+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0 ? var_equal '@$infntywavesize' 0"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="0" panelname="deck1" deck="1" mirror="false" visibility="deck 1 leftdeck"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="0" panelname="deck3" deck="3" mirror="false" visibility="deck 3 leftdeck"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="+960" panelname="deck2" deck="2" mirror="true" visibility="deck 2 rightdeck"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="+960" panelname="deck4" deck="4" mirror="true" visibility="deck 4 rightdeck"/>
    <panel class="extended_main_racks" deck_offset="[HEIGHT]"/>
  </define>
  <define class="EXTENDED_4DECKS" placeholders="*panelname,height=355,wave_height=1080-50-50-355-2-355-3">
    <!-- Match the 2-deck shell, with the second deck pair stacked below. -->
    <pos y="+[WAVE_HEIGHT]+3" condition="var_equal '@$hide_main_waveforms' 0 ? var_equal '@$waveform_position' 0"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="0" panelname="deck1" deck="1" mirror="false"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="+960" panelname="deck2" deck="2" mirror="true"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="0" y="+[HEIGHT]+2" panelname="deck3" deck="3" mirror="false"/>
    <panel class="deck_container_extended_side" height="[HEIGHT]" x="+960" y="+[HEIGHT]+2" panelname="deck4" deck="4" mirror="true"/>
    <panel class="extended_main_racks" offset_y="+[HEIGHT]+2" deck_offset="[HEIGHT]"/>
  </define>
  <define class="EXTENDED_MAIN_RACKS" placeholders="offset_y=0,deck_offset=264+2">
    <panel class="racks_extended" x="+2" y="[OFFSET_Y]" deck_offset="[DECK_OFFSET]" condition="var_equal '@$hide_main_waveforms' 0"/>
    <panel class="racks_single" x="+2" y="[OFFSET_Y]" deck_offset="[DECK_OFFSET]" condition="var_equal '@$hide_main_waveforms' 1"/>
  </define>
  <!-- Full-width side decks (no center mixer). -->
  <define class="DECK_CONTAINER_EXTENDED_SIDE" placeholders="*deck,*panelname,*mirror=false,height=340">
    <deck deck="[DECK]">
      <panel class="deck_spine_pair" deck="[DECK]" panelname="[PANELNAME]" height="[HEIGHT]" mirror="[MIRROR]" condition="not [MIRROR]"/>
      <panel class="deck_container_extended_body" x="+35" width="922" height="[HEIGHT]" deck="[DECK]" panelname="[PANELNAME]" mirror="[MIRROR]" condition="not [MIRROR]"/>
      <panel class="deck_container_extended_body" x="+2" width="922" height="[HEIGHT]" deck="[DECK]" panelname="[PANELNAME]" mirror="[MIRROR]" condition="[MIRROR]"/>
      <panel class="deck_spine_pair" deck="[DECK]" x="1920-35" panelname="[PANELNAME]" height="[HEIGHT]" mirror="[MIRROR]" condition="[MIRROR]"/>
    </deck>
  </define>
  <define class="DECK_CONTAINER_EXTENDED_BODY" placeholders="*deck,*panelname,*mirror=false,width=922,height=340">
    <deck deck="[DECK]">
      <visual class="gfx_shape" width="[WIDTH]" height="[HEIGHT]" coloroff="panel_background" bordersize="1" bordercoloroff="transparent"/>
      <panel class="track_info_extended" mirror="[MIRROR]"/>
      <panel class="sync_info_extended" x="+614" condition="not [MIRROR]"/>
      <panel class="sync_info_extended" x="+10" condition="[MIRROR]"/>
      <songpos class="songpos" x="+2" y="+80" width="918" height="20"/>
      <songpos class="cuemap" x="+2" y="+100" width="918" height="2"/>
      <panel class="pad_page_container" x="+10" y="+110" panelname="[PANELNAME]" width="[WIDTH]-232" condition="not [MIRROR]"/>
      <panel class="pad_page_container" x="+221" y="+110" panelname="[PANELNAME]" width="[WIDTH]-232" condition="[MIRROR]"/>
      <group x="+[WIDTH]-170" y="+130" condition="not [MIRROR]">
        <panel class="jogwheel" x="-20" name="jogwheel_spinner"/>
        <panel class="pitch_small" x="+132" y="+10" deck="[DECK]"/>
      </group>
      <group condition="[MIRROR]" y="+130">
        <panel class="pitch_small" deck="[DECK]" x="+5" y="+10"/>
        <panel class="jogwheel" x="+42" name="jogwheel_spinner"/>
      </group>
      <group x="+707" y="+315" condition="not [MIRROR]">
        <panel class="performance_cue_button"/>
        <panel class="performance_play_button" x="+105"/>
      </group>
      <group x="+8" y="+315" condition="[MIRROR]">
        <panel class="performance_play_button"/>
        <panel class="performance_cue_button" x="+105"/>
      </group>
      <visual class="gfx_shape" x="+0" y="+0" width="[WIDTH]" height="[HEIGHT]" coloroff="transparent" bordercoloroff="dark_5" bordersize="1" radius="6"/>
      <visual source="select" x="+0" y="+0" visibility="var_equal '@$dd_bordermode' 1 ? deck [DECK] select">
        <size width="878+77+2-35" height="[HEIGHT]"/>
        <down color="transparent" border_size="3" border="deckcolor" shape="square" radius="8"/>
      </visual>
      <panel x="+1" y="+1" class="dual_dropzone" width="878+77+2-35-2" height="264+60"/>
    </deck>
  </define>
</defs>
