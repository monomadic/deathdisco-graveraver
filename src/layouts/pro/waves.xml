<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Pro waveform/browser layout shells. -->
  <define class="PRO_DECKS_ABOVE">
    <panel class="area_waves"/>
    <!-- With waves above, the browser slot only depends on deck density.
         Slot heights stay numeric here because the browser classes reuse
         HEIGHT inside their own arithmetic expressions. -->
    <!-- 2 decks with utility bar: 1080 - 845 -->
    <group condition="var_equal '@$layout_4deck' 0">
      <panel class="pro_2decks" wave_size="var @$infntywavesize"/>
      <panel class="browser_surface_pro" height="`get_var '@$infntywavesize' &amp; param_multiply 2`"/>
    </group>
    <!-- 4 decks: 1080 - 830 - 50 -->
    <group condition="var_equal '@$layout_4deck' 1">
      <panel class="pro_4decks"/>
      <panel class="browser_surface_pro_4decks" height="410"/>
    </group>
  </define>
  <define class="PRO_DECKS_BELOW">
    <group condition="var_equal '@$layout_4deck' 0">
      <panel class="pro_2decks"/>
      <panel class="area_waves" y="+470"/>
    </group>
    <group condition="var_equal '@$layout_4deck' 1">
      <panel class="pro_4decks"/>
      <panel class="area_waves" y="+450+200"/>
    </group>
    <!-- With waves below, the 2-deck browser keeps a fixed top line at y=830. -->
    <panel class="browser_surface_pro" height="240" condition="var_equal '@$layout_4deck' 0"/>
    <!-- 4 decks: 1080 - 830 - 50 -->
    <panel class="browser_surface_pro_4decks" height="500" condition="var_equal '@$layout_4deck' 1"/>
  </define>
</defs>
