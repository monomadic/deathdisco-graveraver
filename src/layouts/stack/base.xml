<?xml version="1.0" encoding="UTF-8"?>
<module>
  <!-- STACK
    For multi-deck mixing, waveforms are given priority.
  -->
  <group name="STACK" condition="var_equal '@$dd_skin_mode' 2">
    <!-- Main decks -->
    <panel class="stack_decks" visibility="not browser_zoom"/>
    <!-- browser zoom -->
    <panel class="browser_zoom_decks_above" condition="var_equal '@$dd_hide_zoom_waveforms' 0 ? var_equal '@$dd_waveform_position' 0" visibility="browser_zoom"/>
    <panel class="browser_zoom_decks_below" condition="var_equal '@$dd_hide_zoom_waveforms' 0 ? var_equal '@$dd_waveform_position' 1" visibility="browser_zoom"/>
    <panel class="browser_zoom_decks_no_waves" condition="var_equal '@$dd_hide_zoom_waveforms' 1" visibility="browser_zoom"/>
  </group>
</module>
