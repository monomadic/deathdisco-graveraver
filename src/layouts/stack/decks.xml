<?xml version="1.0" encoding="UTF-8"?>
<defs xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Stack deck layout shells. @$dd_layout_4deck: 0 = two-deck / swap, 1 = full four-deck. -->
  <!-- Stack mode uses a single repeated deck strip shell -->
  <define class="DECK_CONTAINER_STACK" placeholders="*deck,*panelname">
    <deck deck="[DECK]">
      <group>
        <!-- the whole left bar selects the deck; the tab and menu below sit on top of it -->
        <button action="select" tooltip="Select Deck">
          <size width="35" height="164"/>
          <off color="transparent"/>
        </button>
        <button textsize="16" class="button_main" action="select" rightclick="cycle '@dd_deck_mode' 3" tooltip="Select Deck \n Right-click: Next Panel" coloroff="button_background" textheight="40" textcoloron="black">
          <size width="30" height="40"/>
          <pos x="+8" y="+6"/>
          <text align="center" weight="bold" action="get_deck" width="25"/>
        </button>
        <menu class="menu_maindecks" x="+0" y="+160-30" width="35" height="20"/>
      </group>
      <group x="+35">
        <panel class="track_info_stack"/>
        <square color="bg_main" canstretch="false">
          <pos x="+35" y="+50"/>
          <size width="485" height="75"/>
        </square>
        <panel class="track_stem_modifiers" x="+40" y="+60" volumes="false" fx="false" idleborder="transparent"/>
        <panel class="stack_header_pads" x="+40" y="+124"/>
        <!-- BPM / KEY readout in the space right of the stem buttons; key compares against the other side -->
        <panel class="stack_bpm_key" otherdeck="right" x="+315" y="+60" condition="param_equal '[DECK]' '1'"/>
        <panel class="stack_bpm_key" otherdeck="left" x="+315" y="+60" condition="param_equal '[DECK]' '2'"/>
        <panel class="stack_bpm_key" otherdeck="right" x="+315" y="+60" condition="param_equal '[DECK]' '3'"/>
        <panel class="stack_bpm_key" otherdeck="left" x="+315" y="+60" condition="param_equal '[DECK]' '4'"/>
        <group name="deck_control" visibility="var_equal '@$dd_stack_controls' 1">
          <panel visibility="var_equal '@dd_deck_mode' 0">
            <panel class="jogwheel" x="+484+7" y="+3" name="jogwheel_spinner"/>
            <panel class="pitch_zone_stack" x="+484+7+155+16"/>
            <panel class="transport_stack" x="+800-60-2-8"/>
          </panel>
          <panel visibility="var_equal '@dd_deck_mode' 1">
            <panel class="pads_rack_stack" x="+484+7"/>
          </panel>
          <panel visibility="var_equal '@dd_deck_mode' 2">
            <panel class="saved_loops_stack" panelname="[PANELNAME]" x="+484+7"/>
          </panel>
        </group>
        <songpos class="songpos" x="+170" y="+5" width="310" height="46"/>
        <panel class="wave_stack" x="+800+2" visibility="var_equal '@$dd_stack_controls' 1"/>
        <panel class="wave_stack" x="+484+2" width="1114+316" visibility="var_equal '@$dd_stack_controls' 0"/>
      </group>
      <visual source="deck [DECK] select" visibility="var_equal '@$dd_bordermode' 1">
        <!-- 2px taller than the strip on each side (into the gaps between decks) so it clears the controls -->
        <pos x="+35" y="-2"/>
        <size width="1920-37" height="164+4"/>
        <down color="transparent" border_size="3" border="deckcolor" shape="square" radius="6"/>
      </visual>
      <!-- load dropzone over the whole deck strip -->
      <dropzone deck="[DECK]">
        <pos x="+35"/>
        <size width="1920-37" height="164"/>
        <over color="transparent" border_size="6" border="#33FFFFFF" shape="square" radius="6"/>
      </dropzone>
    </deck>
  </define>
  <!-- Stack deck BPM / KEY readout in a rounded box; key colours compare against [OTHERDECK].
       On the master deck the box outline takes the master colour. -->
  <define class="STACK_BPM_KEY" placeholders="*otherdeck">
    <visual x="+7" y="+0" width="158" height="60">
      <off shape="square" color="transparent" border_size="1" border="#555555" radius="4"/>
    </visual>
    <line color="#2a2a2a" x="+89" y="+6" width="1" height="46"/>
    <textzone action="pitch_reset 4bt">
      <pos x="+0" y="+2"/>
      <size width="100" height="11"/>
      <text fontsize="10" color="#777777" align="center" localize="true" important="true" text="BPM"/>
    </textzone>
    <textzone>
      <pos x="+79" y="+2"/>
      <size width="88" height="11"/>
      <text fontsize="10" color="#777777" align="center" localize="true" important="true" text="KEY"/>
    </textzone>
    <textzone action="pitch_reset 4bt">
      <pos x="+0" y="+14"/>
      <size width="100" height="28"/>
      <text fontsize="26" weight="bold" align="center" scroll="no" important="true" color="`param_bigger 120 get_pitch_value ? color '#ff453a' : param_smaller 80 get_pitch_value ? color '#ff453a' : param_bigger 110 get_pitch_value ? color '#f5c518' : param_smaller 90 get_pitch_value ? color '#f5c518' : color '#eeeeee'`" action="var_equal '@$dd_jog_bpm_digits' 1 ? get_text '%Pbpmex' : get_text '%Pbpm'"/>
    </textzone>
    <!-- key: neutral with no reference key or when matched, else orange / red by compatibility -->
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? false : true">
      <pos x="+79" y="+14"/>
      <size width="88" height="28"/>
      <text fontsize="26" weight="bold" align="center" scroll="no" important="true" color="#eeeeee" action="get_key"/>
    </textzone>
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? match_key ? true : false : false">
      <pos x="+79" y="+14"/>
      <size width="88" height="28"/>
      <text fontsize="26" weight="bold" align="center" scroll="no" important="true" color="#eeeeee" action="get_key"/>
    </textzone>
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? match_key ? false : param_contains 'A' `get_harmonic` ? param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? true : false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? true : false : param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? true : false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? true : false : false">
      <pos x="+79" y="+14"/>
      <size width="88" height="28"/>
      <text fontsize="26" weight="bold" align="center" scroll="no" important="true" color="#ff9f1a" action="get_key"/>
    </textzone>
    <textzone action="key_match_menu" rightclick="setting 'keyDisplay' 'Musical' ? setting 'keyDisplay' 'Harmonic' : setting 'keyDisplay' 'Musical'" visibility="param_bigger 0 `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer'` ? match_key ? false : param_contains 'A' `get_harmonic` ? param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? false : true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? false : true : param_contains 'A' `deck [OTHERDECK] get_harmonic` ? get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 1 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 11 ? false : true : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 2 ? false : get_harmonic &amp; param_cast 'integer' &amp; param_add 12 &amp; param_add `deck [OTHERDECK] get_harmonic &amp; param_cast 'integer' &amp; param_multiply -1` &amp; param_mod 12 &amp; param_equal 10 ? false : true : false">
      <pos x="+79" y="+14"/>
      <size width="88" height="28"/>
      <text fontsize="26" weight="bold" align="center" scroll="no" important="true" color="#ff453a" action="get_key"/>
    </textzone>
    <!-- detail row -->
    <textzone action="pitch_reset 4bt" visibility="param_bigger 120 get_pitch_value ? false : param_smaller 80 get_pitch_value ? false : true">
      <pos x="+0" y="+37"/>
      <size width="100" height="20"/>
      <text fontsize="12" align="center" scroll="no" important="true" color="#dddddd" action="get_text '%Ppitch%'"/>
    </textzone>
    <textzone action="pitch_reset 4bt" visibility="param_bigger 120 get_pitch_value ? blink 500ms : param_smaller 80 get_pitch_value ? blink 500ms : false">
      <pos x="+0" y="+37"/>
      <size width="100" height="20"/>
      <text fontsize="12" align="center" scroll="no" important="true" color="red" action="get_text '%Ppitch%'"/>
    </textzone>
    <textzone action="key_match_button" visibility="key_match_button ? true : false">
      <pos x="+79" y="+37"/>
      <size width="88" height="20"/>
      <text fontsize="12" align="center" scroll="no" important="true" color="#eeeeee" action="get_text 'MATCH'"/>
    </textzone>
    <textzone action="key_match_button" visibility="key_match_button ? false : param_equal `get_key_modifier_text` 0 ? true : false">
      <pos x="+79" y="+37"/>
      <size width="88" height="20"/>
      <text fontsize="12" align="center" scroll="no" important="true" color="#dddddd" action="get_text '+0 ST'"/>
    </textzone>
    <textzone action="key_match_button" visibility="key_match_button ? false : param_equal `get_key_modifier_text` 0 ? false : true">
      <pos x="+79" y="+37"/>
      <size width="88" height="20"/>
      <text fontsize="12" align="center" scroll="no" important="true" color="orange" action="get_text '`get_key_modifier_text` ST'"/>
    </textzone>
  </define>
  <!-- Eight pads in one row along the bottom of the stack deck header -->
  <define class="STACK_HEADER_PADS" placeholders="height=28">
    <panel class="pad_stack_button" x="+0" source="1" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
    <panel class="pad_stack_button" x="+55" source="2" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
    <panel class="pad_stack_button" x="+110" source="3" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
    <panel class="pad_stack_button" x="+165" source="4" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
    <panel class="pad_stack_button" x="+220" source="5" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
    <panel class="pad_stack_button" x="+275" source="6" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
    <panel class="pad_stack_button" x="+330" source="7" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
    <panel class="pad_stack_button" x="+385" source="8" width="53" height="[HEIGHT]" coloroff="dark_3" coloron="dark_3" multiline="true" textdx="+11" textpad="-13" textsize="11" textdy="+0"/>
  </define>
  <define class="STACK_2DECKS" placeholders="*panelname">
    <panel class="deck_container_stack" panelname="deck1" deck="1" visibility="not deck 3 leftdeck"/>
    <panel class="deck_container_stack" panelname="deck3" deck="3" visibility="deck 3 leftdeck"/>
    <panel class="deck_container_stack" y="+164+2" panelname="deck2" deck="2" visibility="not deck 4 rightdeck"/>
    <panel class="deck_container_stack" y="+164+2" panelname="deck4" deck="4" visibility="deck 4 rightdeck"/>
    <!-- racks -->
    <panel class="racks_stack"/>
  </define>
  <define class="STACK_4DECKS" placeholders="*panelname">
    <group name="1234" visibility="setting 'mixerOrder' '1234'">
      <panel class="deck_container_stack" panelname="deck1" deck="1"/>
      <panel class="deck_container_stack" y="+164+2" panelname="deck2" deck="2"/>
      <panel class="deck_container_stack" y="+164+2+164+2" panelname="deck3" deck="3"/>
      <panel class="deck_container_stack" y="+164+2+164+2+164+2" panelname="deck4" deck="4"/>
    </group>
    <group name="3124" visibility="setting 'mixerOrder' '3124'">
      <panel class="deck_container_stack" panelname="deck3" deck="3"/>
      <panel class="deck_container_stack" y="+164+2" panelname="deck1" deck="1"/>
      <panel class="deck_container_stack" y="+164+2+164+2" panelname="deck2" deck="2"/>
      <panel class="deck_container_stack" y="+164+2+164+2+164+2" panelname="deck4" deck="4"/>
    </group>
    <group name="1342" visibility="setting 'mixerOrder' '1342'">
      <panel class="deck_container_stack" panelname="deck1" deck="1"/>
      <panel class="deck_container_stack" y="+164+2" panelname="deck3" deck="3"/>
      <panel class="deck_container_stack" y="+164+2+164+2" panelname="deck4" deck="4"/>
      <panel class="deck_container_stack" y="+164+2+164+2+164+2" panelname="deck2" deck="2"/>
    </group>
    <panel class="racks_stack" y="+164+2+164+2"/>
  </define>
  <define class="STACK_DECKS">
    <panel class="stack_2decks" condition="var_equal '@$dd_layout_4deck' 0"/>
    <panel class="stack_4decks" condition="var_equal '@$dd_layout_4deck' 1"/>
    <!-- browsers -->
    <panel class="browser_surface_stack" height="1080-260" condition="var_equal '@$dd_layout_4deck' 0"/>
    <panel class="browser_surface_stack_4decks" height="1080-260-260-70" condition="var_equal '@$dd_layout_4deck' 1"/>
  </define>
</defs>
