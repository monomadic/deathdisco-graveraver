<?xml version="1.0"?>
<!--
  DEATHDISCO SKIN v2026.2

  # Navigating this skin
  This skin layout is a total mess at the moment. To find sections in the skin use this rough terminology:

  TOP BAR

  Deck
    Area Deck Left/Right
-->
<skin name="DeathDisco Performance Deck" width="1920" height="1280" version="2026" author="DeathDisco" comment="" image="haunting.png" preview="skinpreview.png" breakline="1280-42" breakline2="1280-42">
  <!-- note: originally loosely based around Alex Zaik's work -->
  <!-- @$hauntinglayout 0=2deck, 1=4deck -->
  <!-- @$hauntingdeckstack 0=hide-pads, 1=show-pads -->
  <!-- @$hauntingdeckmode 0=jog, 1=pads, 2=loops -->
  <font name="Helvetica Neue"/>
  <nbdecks value="2" condition="var_equal '@$4decks' 0"/>
  <nbdecks value="4" condition="var_not_equal '@$4decks' 0"/>
  <!--  dialogs & tooltips -->
  <tooltip size="14" color="#e2e3e4" back="#2f2f2f" shortcut="gray" localize="true"/>
  <dialogs darkmode="true"/>
  <group name="MAIN_WINDOW">
    <visual class="gfx_shape" width="1920" height="1280" coloroff="skin_background" canstretch="yes"/>
    <panel name="grabzones">
      <grabzone x="0" y="0" width="1920" height="40"/>
      <grabzone x="0" y="0" width="10" height="1080"/>
      <grabzone x="1920-10" y="0" width="10" height="1080"/>
      <grabzone x="0" y="1080-5" width="1920" height="5"/>
    </panel>
    <panel class="topbar" x="+2"/>
    <group name="PRO" condition="var_equal '@$hauntingproskinmode' 0">
      <!-- main decks -->
      <panel class="pro_decks_above" condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
      <panel class="pro_decks_bottom" condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
      <panel class="pro_decks_no_waves" condition="var_equal '@$hauntingwavesviewmaindecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
      <!-- browser zoom & (auto switch) -->
      <panel class="promini_decks_above" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      <panel class="promini_decks_bottom" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      <panel class="promini_decks_no_waves" condition="var_equal '@$hauntingwavesviewminidecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      <!-- TESTBED -->
      <deck deck="1">
        <panel>
          <!-- <visual width="250" height="250"> -->
          <!-- <off shape="square" color="#000000"/> -->
          <!-- </visual> -->
        </panel>
      </deck>
      <!-- /TESTBED -->
    </group>
    <group name="PERFORMANCE" condition="var_equal '@$hauntingproskinmode' 1">
      <!-- main decks -->
      <group name="Extended" condition="var_equal '@$hauntingperformancelayout' 0">
        <panel class="performance_decks_above" condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
        <panel class="performance_decks_bottom" condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
        <panel class="performance_decks_no_waves" condition="var_equal '@$hauntingwavesviewmaindecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
      </group>
      <group name="Vertical" condition="var_equal '@$hauntingperformancelayout' 1">
        <panel class="performance_decks_vertical" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
      </group>
      <group name="Horizontal" condition="var_equal '@$hauntingperformancelayout' 2">
        <panel class="performance_decks_center" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
      </group>
      <!-- browser zoom & (auto switch) -->
      <panel class="performancemini_decks_above" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      <panel class="performancemini_decks_bottom" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      <panel class="performancemini_decks_no_waves" condition="var_equal '@$hauntingwavesviewminidecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
    </group>
    <group name="STACK" condition="var_equal '@$hauntingproskinmode' 2">
      <!-- main decks -->
      <panel class="stack_decks" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
      <!-- browser zoom & (auto switch) -->
      <panel class="performancemini_decks_above" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      <panel class="performancemini_decks_bottom" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      <panel class="performancemini_decks_no_waves" condition="var_equal '@$hauntingwavesviewminidecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
    </group>
    <!-- BOTTOM BAR (UTILITY BAR) -->
    <panel class="h_utility_bar" x="+2" y="+1280-38" condition="var_equal '@$hauntingutilitybar' 1"/>
    <!-- external browser -->
    <window name="haunting_browser_window" width="1920" height="768" posx="0" posy="100" breakline="768-42" breakline2="768-42" shown="false">
      <visual class="gfx_shape" width="1920" height="1240" coloroff="skin_background" canstretch="yes"/>
      <visual class="gfx_shape" x="+2" width="1920-2-2" height="43" coloroff="panel_background"/>
      <textzone tooltip="">
        <pos x="+444" y="+15"/>
        <size width="104" height="15"/>
        <text fontsize="14" color="textdarker" align="center" text="LOAD" important="true"/>
      </textzone>
      <button action="deck 3 load" visibility="var_not_equal '@$4decks' 0">
        <pos x="+403+6+156+6" y="+10" width="186" height="26"/>
        <off color="button_background" border="waveform_active3" border_size="1" radius="0"/>
        <on color="waveform_active3" radius="0"/>
        <text fontsize="11" color="needle" colordown="texton" colorselected="texton" align="center" text="DECK 3" important="true"/>
      </button>
      <button action="deck 1 load">
        <pos x="+403+6+156+6+186+12" y="+10" width="186" height="26"/>
        <off color="button_background" border="waveform_active1" border_size="1" radius="0"/>
        <on color="waveform_active1" radius="0"/>
        <text fontsize="11" color="needle" colordown="texton" colorselected="texton" align="center" text="DECK 1" important="true"/>
      </button>
      <button action="deck 2 load">
        <pos x="+403+6+156+6+186+12+186+12" y="+10" width="186" height="26"/>
        <off color="button_background" border="waveform_active2" border_size="1" radius="0"/>
        <on color="waveform_active2" radius="0"/>
        <text fontsize="11" color="needle" colordown="texton" colorselected="texton" align="center" text="DECK 2" important="true"/>
      </button>
      <button action="deck 4 load" visibility="var_not_equal '@$4decks' 0">
        <pos x="+403+6+156+6+186+12+186+12+186+12" y="+10" width="186" height="26"/>
        <off color="button_background" border="waveform_active4" border_size="1" radius="0"/>
        <on color="waveform_active4" radius="0"/>
        <text fontsize="11" color="needle" colordown="texton" colorselected="texton" align="center" text="DECK 4" important="true"/>
      </button>
      <browser class="haunting_browser_basic" x="2" y="+43+2" condition="var_equal '@$hauntingutilitybar2' 1">
        <zoomed width="1920-4" height="768-43-2-38-2"/>
        <size width="1920-4" height="768-43-2-38-2"/>
      </browser>
      <browser class="haunting_browser_basic" x="2" y="+43+2" condition="var_equal '@$hauntingutilitybar2' 0">
        <size width="1920-4" height="768-43-2-2"/>
        <zoomed width="1920-4" height="768-43-2-2"/>
      </browser>
      <panel class="h_utility_bar" x="+2" y="+768-38"/>
      <!-- GUIDE OVERLAY -->
      <!-- RESIZE ZONES -->
      <resizezone>
        <pos x="1916" y="0"/>
        <size width="4" height="768"/>
      </resizezone>
      <resizezone>
        <pos x="0" y="764"/>
        <size width="1920" height="4"/>
      </resizezone>
      <resizezone>
        <pos x="0" y="0"/>
        <size width="4" height="768"/>
      </resizezone>
    </window>
  </group>
</skin>
