<?xml version="1.0" encoding="UTF-8"?>
<module>
  <!-- Minimal deck transport migrated from legacy -->
  <deck deck="1">
    <group name="deck_left" x="40" y="200">
      <!-- Deck select button (PRO style) -->
      <group class="deck_button_left" visibility="masterdeck" color="color_masterdeck">
        <pos x="+0" y="+0"/>
      </group>
      <group class="deck_button_left" visibility="not masterdeck" color="deckcolor">
        <pos x="+0" y="+0"/>
      </group>
      <!-- Track info (Pro-styled container) -->
      <group name="track_info_left" x="+0" y="-56">
        <visual class="gfx_shape" width="300" height="56" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="4"/>
        <!-- Cover art (left) -->
        <visual>
          <pos x="+8" y="+8"/>
          <size width="40" height="40"/>
          <off shape="square" color="button_bg" border="pro_panel_border" border_size="1" radius="3"/>
        </visual>
        <!-- Placeholder rings when no cover is available -->
        <visual type="circle" novisibility="loaded ? has_cover ?">
          <pos x="+8+2" y="+8+2"/>
          <size width="40-4" height="40-4"/>
          <off shape="circle" color="pro_panel_bg" border="pro_panel_border" border_size="2"/>
        </visual>
        <cover visibility="loaded">
          <pos x="+8" y="+8"/>
          <size width="40" height="40"/>
        </cover>
        <!-- Text to the right of cover -->
        <panel class="textzone_title_artist_combo" x="+8+40+10" y="+8" width="300-16-40-10" align="left" scroll="yes" titlefontsize="20" artistfontsize="14" titlecolor="pro_text_main" artistcolor="pro_text_dim"/>
        <songpos class="songpos" x="+8+40+10" y="+56-8-4" width="300-16-40-10" height="6" colorPlayed="deckcolor"/>
      </group>
      <!-- Transport bar background (aligned to legacy songpos frame) -->
      <visual class="gfx_shape" x="+45" y="+0" width="300" height="36" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="4"/>
      <!-- Transport bar (legacy layout) -->
      <panel class="TRANSPORT_BAR" deck="1" deckside="left"/>
      <!-- Key controls -->
      <panel class="key_display_left" x="+0" y="+40"/>
      <!-- Jogwheel -->
      <panel class="jogwheel" x="+220" y="-20" name="jogwheel_left"/>
      <!-- Pitch + VU meter -->
      <panel class="pitch" x="+400" y="+0"/>
      <visual class="vu_meter">
        <pos x="+470" y="+0"/>
      </visual>
      <!-- Background for deck control column -->
      <visual class="gfx_shape" x="-10" y="-50" width="252" height="200" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="6"/>
      <!-- Pads strip (Hotcues 1-8) -->
      <group name="pads_left" x="+0" y="+90">
        <visual class="gfx_shape" width="232" height="33" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="4"/>
        <panel class="hotcue_button_stack" x="+4" y="+4" source="1"/>
        <panel class="hotcue_button_stack" x="+4+25+4" y="+4" source="2"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4" y="+4" source="3"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4" y="+4" source="4"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4" y="+4" source="5"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4+25+4" y="+4" source="6"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4+25+4+25+4" y="+4" source="7"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4+25+4+25+4+25+4" y="+4" source="8"/>
      </group>
    </group>
  </deck>
  <deck deck="2">
    <group name="deck_right" x="1640" y="200">
      <!-- Deck select button (PRO style) -->
      <group class="deck_button_left" visibility="masterdeck" color="color_masterdeck">
        <pos x="-40" y="+0"/>
      </group>
      <group class="deck_button_left" visibility="not masterdeck" color="deckcolor">
        <pos x="-40" y="+0"/>
      </group>
      <!-- Track info (Pro-styled container) -->
      <group name="track_info_right" x="-300" y="-56">
        <visual class="gfx_shape" width="300" height="56" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="4"/>
        <!-- Cover art (right) -->
        <visual>
          <pos x="+300-8-40" y="+8"/>
          <size width="40" height="40"/>
          <off shape="square" color="button_bg" border="pro_panel_border" border_size="1" radius="3"/>
        </visual>
        <!-- Placeholder rings when no cover is available -->
        <visual type="circle" novisibility="loaded ? has_cover ?">
          <pos x="+300-8-40+2" y="+8+2"/>
          <size width="40-4" height="40-4"/>
          <off shape="circle" color="pro_panel_bg" border="pro_panel_border" border_size="2"/>
        </visual>
        <cover visibility="loaded">
          <pos x="+300-8-40" y="+8"/>
          <size width="40" height="40"/>
        </cover>
        <!-- Text to the left of cover -->
        <panel class="textzone_title_artist_combo" x="+8" y="+8" width="300-16-40-10" align="right" scroll="yes" titlefontsize="20" artistfontsize="14" titlecolor="pro_text_main" artistcolor="pro_text_dim"/>
        <songpos class="songpos" x="+8" y="+56-8-4" width="300-16-40-10" height="6" colorPlayed="deckcolor"/>
      </group>
      <!-- Transport bar background (aligned to legacy songpos frame) -->
      <visual class="gfx_shape" x="+460" y="+0" width="300" height="36" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="4"/>
      <!-- Transport: SYNC / CUE / PLAY -->
      <panel class="TRANSPORT_BAR" deck="2" deckside="right"/>
      <!-- Key controls -->
      <panel class="key_display_right" x="-128" y="+40"/>
      <panel class="jogwheel" x="-240" y="-20" name="jogwheel_right"/>
      <panel class="pitch" x="-420" y="+0"/>
      <visual class="vu_meter">
        <pos x="-490" y="+0"/>
      </visual>
      <!-- Background for deck control column -->
      <visual class="gfx_shape" x="-242" y="-50" width="252" height="200" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="6"/>
      <!-- Pads strip (Hotcues 1-8) -->
      <group name="pads_right" x="-232" y="+90">
        <visual class="gfx_shape" width="232" height="33" coloroff="pro_panel_bg" bordercoloroff="pro_panel_border" bordersize="1" radius="4"/>
        <!-- Active deck outline -->
        <visual x="-12" y="-52" width="256" height="204" visibility="select">
          <off shape="square" color="transparent" border="deckcolor" border_size="2" radius="7"/>
        </visual>
        <panel class="hotcue_button_stack" x="+4" y="+4" source="1"/>
        <panel class="hotcue_button_stack" x="+4+25+4" y="+4" source="2"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4" y="+4" source="3"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4" y="+4" source="4"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4" y="+4" source="5"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4+25+4" y="+4" source="6"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4+25+4+25+4" y="+4" source="7"/>
        <panel class="hotcue_button_stack" x="+4+25+4+25+4+25+4+25+4+25+4+25+4+25+4" y="+4" source="8"/>
      </group>
    </group>
  </deck>
</module>
