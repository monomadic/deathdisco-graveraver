<?xml version="1.0" encoding="UTF-8"?>
<module>
  <panel name="main" visible="yes">
    <!-- OVERALL BACKGROUND -->
    <square color="bg_main" canstretch="false">
      <pos x="0" y="0"/>
      <size width="1920" height="1080"/>
    </square>
    <!-- WINDOW HANDLES -->
    <panel name="grabzones">
      <grabzone x="0" y="0" width="1920" height="40"/>
      <grabzone x="0" y="0" width="10" height="1080"/>
      <grabzone x="1920-10" y="0" width="10" height="1080"/>
      <grabzone x="0" y="1080-5" width="1920" height="5"/>
    </panel>
    <!-- TOP BAR -->
    <panel class="topbar" x="+0" y="+40"/>
    <!-- SUBLAYOUTS -->
    <group name="sublayouts">
      <group name="PRO" condition="var_equal '@$hauntingproskinmode' 0">
        <!--
        PRO: decks above -->
        <panel condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true">
          <panel class="area_waves" y="+43+2"/>
          <panel class="pro_2decks" condition="var_equal '@$hauntinglayout' 0"/>
          <panel class="pro_4decks" condition="var_equal '@$hauntinglayout' 1"/>
          <!-- browsers -->
          <group name="no_utility_bar" condition="var_equal '@$hauntingutilitybar' 0">
            <browser class="haunting_browser_pro" height="1080-43-2-432-2-2-2-1" condition="var_equal '@$hauntinglayout' 0"/>
            <browser class="haunting_browser_pro4decks" height="1080-43-2-432-2-2-2-1-216-2" condition="var_equal '@$hauntinglayout' 1"/>
          </group>
          <group name="utility_bar" condition="var_equal '@$hauntingutilitybar' 1">
            <browser class="haunting_browser_pro" height="1280-43-2-432-2-2-2-1-38" condition="var_equal '@$hauntinglayout' 0"/>
            <browser class="haunting_browser_pro4decks" height="1280-43-2-432-2-2-2-1-216-2-38" condition="var_equal '@$hauntinglayout' 1"/>
          </group>
        </panel>
        <!--
        PRO: decks below -->
        <panel class="pro_decks_bottom" condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true">
          <!-- DECKS -->
          <panel class="pro_2decks" y="+43+2" condition="var_equal '@$hauntinglayout' 0"/>
          <panel class="pro_4decks" y="+43+2" condition="var_equal '@$hauntinglayout' 1"/>
          <!-- WAVES -->
          <panel class="area_waves" y="+43+2+434+1+10" condition="var_equal '@$hauntinglayout' 0"/>
          <panel class="area_waves" y="+43+2+434+1+216+2+10" condition="var_equal '@$hauntinglayout' 1"/>
          <!-- BROWSER (UTILITY BAR OFF) -->
          <group name="no_utility_bar" condition="var_equal '@$hauntingutilitybar' 0">
            <!-- 2 DECKS -->
            <browser class="haunting_browser_pro" height="1080-43-2-432-2-2-2-1" condition="var_equal '@$hauntinglayout' 0"/>
            <!-- 4 DECKS -->
            <browser class="haunting_browser_pro4decks" height="1080-43-2-432-2-2-2-1-216-2" condition="var_equal '@$hauntinglayout' 1"/>
          </group>
          <!-- BROWSER (UTILITY BAR ON) -->
          <group name="utility_bar" condition="var_equal '@$hauntingutilitybar' 1">
            <browser class="haunting_browser_pro" height="1280-33-2-432-2-2-2-1-38" condition="var_equal '@$hauntinglayout' 0"/>
            <browser class="haunting_browser_pro4decks" height="1280-33-2-432-2-2-2-1-216-2-38" condition="var_equal '@$hauntinglayout' 1"/>
          </group>
        </panel>
        <!--
        PRO: no waveforms -->
        <panel class="pro_decks_no_waves" condition="var_equal '@$hauntingwavesviewmaindecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
        <!-- browser zoom & (auto switch) -->
        <panel class="promini_decks_above" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
        <panel class="promini_decks_bottom" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
        <panel class="promini_decks_no_waves" condition="var_equal '@$hauntingwavesviewminidecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
        <!-- TESTBED -->
        <deck deck="1">
          <panel>
            <!-- <visual width="250" height="250"> -->
            <!-- <off shape="square" color="#000000"/> -->
            <!-- </visual> -->
          </panel>
        </deck>
      </group>
      <group name="PERFORMANCE" condition="var_equal '@$hauntingproskinmode' 1">
        <!-- main decks -->
        <group name="Extended" condition="var_equal '@$hauntingperformancelayout' 0">
          <panel class="performance_decks_above" condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
          <panel class="performance_decks_bottom" condition="var_equal '@$hauntingwavesviewmaindecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
          <panel class="performance_decks_no_waves" condition="var_equal '@$hauntingwavesviewmaindecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
        </group>
        <group name="Vertical" condition="var_equal '@$hauntingperformancelayout' 1">
          <panel class="performance_decks_vertical" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
        </group>
        <group name="Horizontal" condition="var_equal '@$hauntingperformancelayout' 2">
          <panel class="performance_decks_center" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
        </group>
        <!-- browser zoom & (auto switch) -->
        <panel class="performancemini_decks_above" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
        <panel class="performancemini_decks_bottom" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
        <panel class="performancemini_decks_no_waves" condition="var_equal '@$hauntingwavesviewminidecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      </group>
      <group name="STACK" condition="var_equal '@$hauntingproskinmode' 2">
        <!-- main decks -->
        <panel class="stack_decks" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? false : browser_isactive ? false : true : browser_zoom ? false : true"/>
        <!-- browser zoom & (auto switch) -->
        <panel class="performancemini_decks_above" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 0" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
        <panel class="performancemini_decks_bottom" condition="var_equal '@$hauntingwavesviewminidecks' 0 ? var_equal '@$hauntingwaveformpos' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
        <panel class="performancemini_decks_no_waves" condition="var_equal '@$hauntingwavesviewminidecks' 1" visibility="var '@$hauntingbrowserzoom' 1 ? browser_zoom ? true : browser_isactive ? true : false : browser_zoom ? true : false"/>
      </group>
    </group>
  </panel>
</module>
