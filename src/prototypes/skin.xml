<?xml version="1.0" encoding="UTF-8"?>
<!--
  Prototype skin entrypoint.
  Keep experimental panels under src/prototypes/panels and include them here only.
-->
<skin xmlns:xi="http://www.w3.org/2001/XInclude" name="DeathDisco Grave Raver Prototype" version="8" width="1920" height="1080" author="Rob" image="skin.png" preview="preview.png" breakline="1000" breakline2="1000">
  <oninit action="deck all effect_active colorfx off &amp; deck all filter_activate off &amp; deck all filter 50% &amp; wait 250ms &amp; deck all effect_active colorfx off &amp; deck all filter_activate off &amp; deck all filter 50%"/>
  <!-- Shared production-safe definitions -->
  <xi:include href="../defs.xml" xpointer="xpointer(/defs/*)"/>
  <!-- Prototype-only classes -->
  <xi:include href="classes/decks.xml" xpointer="xpointer(/defs/*)"/>
  <!-- Quarantined composition experiments -->
  <xi:include href="panels/decks.xml" xpointer="xpointer(/module/*)"/>
  <xi:include href="panels/mixer.xml" xpointer="xpointer(/module/*)"/>
  <xi:include href="panels/wave.xml" xpointer="xpointer(/module/*)"/>
</skin>
