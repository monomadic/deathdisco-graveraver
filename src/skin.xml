  <xi:include href="panels/main.xml" xpointer="xpointer(/module/*)"/>
  <xi:include href="panels/topbar.xml" xpointer="xpointer(/module/*)"/>
  <xi:include href="panels/bottombar.xml" xpointer="xpointer(/module/*)"/>
