<?xml version="1.0" encoding="UTF-8"?>
<!--
  === GRAVERAVER SKIN INFO ===

    Skin organisation
    =================

    Layouts are the highest-level composition blocks. They assemble components
    and containers into complete screen modes and live in src/layouts. They are
    included as modules rather than reusable classes. The top and bottom bars
    (layouts/topbar.xml, layouts/bottombar.xml) are layouts: each owns which
    components appear where on the bar and loads them via VirtualDJ classes.

    Containers are the larger reusable regions that group components: decks,
    racks, waveforms, mixer areas, and similar configurable skin regions. They
    are components themselves and live among the components in src/components
    (e.g. src/components/waveforms, src/components/pad-page.xml); rack shells
    live under src/components/racks/containers.

    Components are the smaller reusable UI elements loaded by layouts and
    containers: buttons, sliders, text, meters, transport controls, jogwheels,
    the per-bar regions under src/components/topbar and src/components/bottombar,
    and related primitives. Component definitions live directly under
    src/components.
    
  -->
<skin xmlns:xi="http://www.w3.org/2001/XInclude" name="DeathDisco Grave Raver v1" version="8" width="1920" height="1080" author="Rob" image="skin.png" preview="preview.png">
  <!-- Stretch bands: VirtualDJ stretches the skin between these lines when the window is
       taller than 1080. Only conditional <breaklines> children are used (no root
       breakline attributes, which would override them), and the conditions are mutually
       exclusive. Default: a fold at y=1000, inside the browser. Pro mixer 4-deck has no
       browser. A band scales everything inside it vertically (text and covers included),
       so its band covers only the two stacked wave graphics of its 125px two-wave strip
       (outer cue labels: 20px above and below stay out of the band). With the waves hidden
       the browser takes that space and stretches instead. -->
  <breaklines breakline1="1000" breakline2="1000" condition="var_equal '@$dd_skin_mode' 0 ? var_equal '@$dd_layout_4deck' 1 ? var_equal '@$dd_hide_pro_mixer' 0 ? false : true : true : true"/>
  <breaklines breakline1="50+20" breakline2="50+125-20" condition="var_equal '@$dd_skin_mode' 0 ? var_equal '@$dd_layout_4deck' 1 ? var_equal '@$dd_hide_pro_mixer' 0 ? var_equal '@$dd_hide_main_waveforms' 0 ? var_equal '@$dd_waveform_position' 0"/>
  <breaklines breakline1="1080-50-125+20" breakline2="1080-50-20" condition="var_equal '@$dd_skin_mode' 0 ? var_equal '@$dd_layout_4deck' 1 ? var_equal '@$dd_hide_pro_mixer' 0 ? var_equal '@$dd_hide_main_waveforms' 0 ? var_equal '@$dd_waveform_position' 1"/>
  <breaklines breakline1="1080-50-125" breakline2="1080-50" condition="var_equal '@$dd_skin_mode' 0 ? var_equal '@$dd_layout_4deck' 1 ? var_equal '@$dd_hide_pro_mixer' 0 ? var_equal '@$dd_hide_main_waveforms' 1"/>
  <!-- Definitions: theme tokens, runtime globals, components, and containers -->
  <xi:include href="colors.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="globals.xml" xpointer="xpointer(/globals/*)"/>
  <xi:include href="components/index.xml" xpointer="xpointer(/defs/*)"/>
  <!-- Layout assembly definitions -->
  <xi:include href="layouts/browser/base.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/browser/overlays.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/browser/containers.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/browser/browser-positions.generated.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/browser/mini.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/pro/waves.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/pro/decks.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/pro/extended.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/performance/decks.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/performance/vertical.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/performance/horizontal.xml" xpointer="xpointer(/defs/*)"/>
  <xi:include href="layouts/stack/decks.xml" xpointer="xpointer(/defs/*)"/>
  <!-- Composition order matters for layering -->
  <xi:include href="layouts/base.xml" xpointer="xpointer(/module/*)"/>
  <xi:include href="layouts/topbar.xml" xpointer="xpointer(/module/*)"/>
  <xi:include href="layouts/bottombar.xml" xpointer="xpointer(/module/*)"/>
</skin>
