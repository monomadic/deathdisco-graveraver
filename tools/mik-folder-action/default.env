# Destination watched by Lexicon.
MIK_LEXICON_INCOMING="$HOME/Music/Downloads"

# Installed app name passed to `open -a`.
MIK_APP_NAME="Mixed In Key 11"

# Mixed In Key 11 may not always write cue points into file tags. Leave this at
# 0 to continue once the key tag is present; set to 1 to require cue-like tags.
MIK_REQUIRE_CUE_TAGS=0

# After the key appears, wait this long for cue tags before copying when cue
# tags are optional.
MIK_CUE_GRACE_SECONDS=45

# Total time to wait for Mixed In Key to write tags.
MIK_TIMEOUT_SECONDS=1800

# Optional hook. If set to an executable script, it runs after Mixed In Key and
# before copying to Lexicon. The audio file path is passed as the first argument.
MIK_AUTOCUE_SCRIPT=""
